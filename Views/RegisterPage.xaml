<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChessCore.Mobile.ViewModels"
             x:Class="ChessCore.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             BackgroundColor="#F3EBDD"
             Title="Đăng Ký Tài Khoản">

    <ScrollView>
        <VerticalStackLayout Padding="30,30" Spacing="20" VerticalOptions="Center">
            
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="♔" FontSize="48" TextColor="#9A6B2D" HorizontalOptions="Center" />
                <Label Text="Tạo Tài Khoản Mới" FontSize="22" FontAttributes="Bold" TextColor="#342B23" HorizontalOptions="Center" />
                <Label Text="Gia nhập cộng đồng kỳ thủ Cờ Tướng Pro" FontSize="13" TextColor="#786956" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="#FFF9EF" StrokeShape="RoundRectangle 16" Stroke="#DDCDB3" Padding="24">
                <VerticalStackLayout Spacing="14">
                    
                    <Border IsVisible="{Binding HasError}" BackgroundColor="#FBE4DE" Stroke="#dc2626" StrokeShape="RoundRectangle 8" Padding="12">
                        <Label Text="{Binding ErrorMessage}" TextColor="#9F422F" FontSize="13" />
                    </Border>

                    <!-- Input Username -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tên đăng nhập" TextColor="#655541" FontSize="13" />
                        <Border BackgroundColor="#F3EBDD" Stroke="#DDCDB3" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry Text="{Binding Username}" Placeholder="Từ 3-30 ký tự" TextColor="#342B23" PlaceholderColor="#786956" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Input Email -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email" TextColor="#655541" FontSize="13" />
                        <Border BackgroundColor="#F3EBDD" Stroke="#DDCDB3" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="Địa chỉ email nhận thông báo" TextColor="#342B23" PlaceholderColor="#786956" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Input Password -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Mật khẩu" TextColor="#655541" FontSize="13" />
                        <Border BackgroundColor="#F3EBDD" Stroke="#DDCDB3" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Ít nhất 6 ký tự" TextColor="#342B23" PlaceholderColor="#786956" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Input Confirm Password -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Xác nhận mật khẩu" TextColor="#655541" FontSize="13" />
                        <Border BackgroundColor="#F3EBDD" Stroke="#DDCDB3" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Nhập lại mật khẩu" TextColor="#342B23" PlaceholderColor="#786956" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="ĐĂNG KÝ NGAY"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="#9F422F"
                            TextColor="#ffffff"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="8"
                            HeightRequest="48"
                            Margin="0,8,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#9A6B2D" HeightRequest="30" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Text="Đã có tài khoản?" TextColor="#786956" FontSize="13" />
                        <Label Text="Đăng nhập" TextColor="#9A6B2D" FontAttributes="Bold" FontSize="13">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
