<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChessCore.Mobile.ViewModels"
             x:Class="ChessCore.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#F3EBDD"
             Title="Đăng Nhập">

    <ScrollView>
        <VerticalStackLayout Padding="30,40" Spacing="20" VerticalOptions="Center">
            
            <!-- Logo & Tiêu đề -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="♔" FontSize="64" TextColor="#9A6B2D" HorizontalOptions="Center" />
                <Label Text="CỜ TƯỚNG PRO" FontSize="26" FontAttributes="Bold" TextColor="#342B23" HorizontalOptions="Center" />
                <Label Text="Trí tuệ đỉnh cao - Tinh hoa kỳ đạo" FontSize="14" TextColor="#786956" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Card Đăng Nhập -->
            <Border BackgroundColor="#FFF9EF" StrokeShape="RoundRectangle 16" Stroke="#DDCDB3" Padding="24" Margin="0,15,0,0">
                <VerticalStackLayout Spacing="16">
                    
                    <Label Text="Đăng Nhập Hệ Thống" FontSize="18" FontAttributes="Bold" TextColor="#342B23" HorizontalOptions="Center" />

                    <!-- Thông báo lỗi nếu có -->
                    <Border IsVisible="{Binding HasError}" BackgroundColor="#FBE4DE" Stroke="#dc2626" StrokeShape="RoundRectangle 8" Padding="12">
                        <Label Text="{Binding ErrorMessage}" TextColor="#9F422F" FontSize="13" />
                    </Border>

                    <!-- Input Username -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tên đăng nhập hoặc Email" TextColor="#655541" FontSize="13" />
                        <Border BackgroundColor="#F3EBDD" Stroke="#DDCDB3" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry Text="{Binding Username}" Placeholder="Nhập username/email" TextColor="#342B23" PlaceholderColor="#786956" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Input Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mật khẩu" TextColor="#655541" FontSize="13" />
                        <Border BackgroundColor="#F3EBDD" Stroke="#DDCDB3" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Nhập mật khẩu" TextColor="#342B23" PlaceholderColor="#786956" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Nút Đăng nhập -->
                    <Button Text="ĐĂNG NHẬP"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="#9F422F"
                            TextColor="#ffffff"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="8"
                            HeightRequest="48"
                            Margin="0,8,0,0" />

                    <!-- Trạng thái Loading -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#9A6B2D" HeightRequest="30" />

                    <!-- Liên kết Đăng ký & Chơi thử -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,5,0,0">
                        <Label Text="Chưa có tài khoản?" TextColor="#786956" FontSize="13" />
                        <Label Text="Đăng ký ngay" TextColor="#9A6B2D" FontAttributes="Bold" FontSize="13">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Button Text="Chơi Ngay (Khách)"
                            Command="{Binding PlayAsGuestCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#786956"
                            FontSize="13"
                            BorderColor="#DDCDB3"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
