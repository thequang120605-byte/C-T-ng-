<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChessCore.Mobile.ViewModels"
             x:Class="ChessCore.Mobile.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             BackgroundColor="#F3EBDD"
             Shell.NavBarIsVisible="False"
             Title="Kỳ Đài">

    <Grid>
        <!-- HÌNH NỀN HỌA TIẾT CỔ ĐIỂN CHÌM -->
        <Image Source="pavilion.png" Aspect="AspectFill" Opacity="0.08" VerticalOptions="Start" HeightRequest="350"/>

        <!-- NỘI DUNG CUỘN CHÍNH -->
        <ScrollView>
            <VerticalStackLayout Padding="14,10,14,16" Spacing="12" MaximumWidthRequest="600" HorizontalOptions="Center">

                <!-- 1. THANH HỒ SƠ THU GỌN PHÍA TRÊN (COMPACT PROFILE STRIP) -->
                <Border BackgroundColor="#282B29" Stroke="#B48440" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <!-- Avatar tròn phong cách thư pháp -->
                        <Border BackgroundColor="#3E6C62" Stroke="#D4AF37" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                            <Label Text="{Binding AvatarLetter}" TextColor="#FFF7E6" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <!-- Tên & Elo -->
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding PlayerName}" TextColor="#F5DBAA" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding EloDisplay}" TextColor="#C1C0AD" FontSize="11"/>
                        </VerticalStackLayout>

                        <!-- Nút Đăng nhập / Tài khoản -->
                        <Button Grid.Column="2" Text="{Binding AccountText}" Command="{Binding LogoutCommand}" BackgroundColor="#42463D" TextColor="#F5DBAA" FontSize="11" Padding="10,4" HeightRequest="36" MinimumHeightRequest="36" CornerRadius="8"/>
                    </Grid>
                </Border>

                <!-- 2. BỐN CHẾ ĐỘ CHÍNH NỔI BẬT DỄ THẤY (2X2 GRID) -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="125,125" ColumnSpacing="10" RowSpacing="10">

                    <!-- CHẾ ĐỘ 1: CHƠI VỚI MÁY (BẬT BẢNG CHỌN ĐỘ KHÓ) -->
                    <Border Grid.Row="0" Grid.Column="0" Stroke="#C6A052" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#AA4B34" Offset="0.0"/>
                                <GradientStop Color="#7C2D1E" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowDifficultyPickerCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="*,Auto">
                            <Border BackgroundColor="#FFF9EF" Stroke="#7C2D1E" StrokeThickness="1.5" StrokeShape="RoundRectangle 22" WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" VerticalOptions="Start">
                                <Label Text="🤖" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="Chơi với máy" TextColor="#FFF9EF" FontSize="15" FontAttributes="Bold"/>
                                <Label Text="AI Offline 4 cấp độ" TextColor="#FDE68A" FontSize="11"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- CHẾ ĐỘ 2: CHƠI ONLINE (SẢNH PHÒNG TRỰC TUYẾN) -->
                    <Border Grid.Row="0" Grid.Column="1" Stroke="#52B788" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2D6A4F" Offset="0.0"/>
                                <GradientStop Color="#1B4332" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToLobbyCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="*,Auto">
                            <Border BackgroundColor="#FFF9EF" Stroke="#1B4332" StrokeThickness="1.5" StrokeShape="RoundRectangle 22" WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" VerticalOptions="Start">
                                <Label Text="🌐" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="Chơi online" TextColor="#FFF9EF" FontSize="15" FontAttributes="Bold"/>
                                <Label Text="Đấu phòng &amp; Giao hữu" TextColor="#B7E4C7" FontSize="11"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- CHẾ ĐỘ 3: CỜ THẾ (LUYỆN TÀN CUỘC & SÁT PHÁP) -->
                    <Border Grid.Row="1" Grid.Column="0" Stroke="#E0A944" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D97706" Offset="0.0"/>
                                <GradientStop Color="#92400E" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPuzzlesCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="*,Auto">
                            <Border BackgroundColor="#FFF9EF" Stroke="#92400E" StrokeThickness="1.5" StrokeShape="RoundRectangle 22" WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" VerticalOptions="Start">
                                <Label Text="🧩" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="Cờ thế" TextColor="#FFF9EF" FontSize="15" FontAttributes="Bold"/>
                                <Label Text="20 bài phá giải sát cục" TextColor="#FDE68A" FontSize="11"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- CHẾ ĐỘ 4: HỌC CỜ (CÁC BÀI HỌC VÀ TRẮC NGHIỆM) -->
                    <Border Grid.Row="1" Grid.Column="1" Stroke="#818CF8" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4338CA" Offset="0.0"/>
                                <GradientStop Color="#312E81" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCoursesCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="*,Auto">
                            <Border BackgroundColor="#FFF9EF" Stroke="#312E81" StrokeThickness="1.5" StrokeShape="RoundRectangle 22" WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" VerticalOptions="Start">
                                <Label Text="📖" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="Học cờ" TextColor="#FFF9EF" FontSize="15" FontAttributes="Bold"/>
                                <Label Text="Khóa học &amp; Trắc nghiệm" TextColor="#C7D2FE" FontSize="11"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. CHẾ ĐỘ PHỤ NỔI BẬT: HAI NGƯỜI CÙNG MÁY -->
                <Border BackgroundColor="#FFF9EF" Stroke="#C6A052" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="14,10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayPassAndPlayCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border BackgroundColor="#F3EBDD" Stroke="#C6A052" StrokeThickness="1" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                            <Label Text="👥" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Hai người cùng máy" TextColor="#342B23" FontSize="14" FontAttributes="Bold"/>
                            <Label Text="Đấu luân phiên trực tiếp trên một thiết bị" TextColor="#786956" FontSize="11"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="Bắt đầu ›" TextColor="#9F422F" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- 4. ĐIỀU HƯỚNG PHỤ: KỲ PHỔ, THỐNG KÊ, CÀI ĐẶT -->
                <Border BackgroundColor="#282B29" Stroke="#B48440" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="12,10" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        
                        <!-- KỲ PHỔ -->
                        <Border BackgroundColor="#343834" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8,8" HeightRequest="56">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToHistoryCommand}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="📜" FontSize="16" HorizontalOptions="Center"/>
                                <Label Text="Kỳ Phổ" TextColor="#F5DBAA" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- THỐNG KÊ / KỲ THỦ -->
                        <Border Grid.Column="1" BackgroundColor="#343834" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8,8" HeightRequest="56">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="🏆" FontSize="16" HorizontalOptions="Center"/>
                                <Label Text="Thống Kê" TextColor="#F5DBAA" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- CÀI ĐẶT -->
                        <Border Grid.Column="2" BackgroundColor="#343834" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8,8" HeightRequest="56">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSettingsCommand}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="⚙️" FontSize="16" HorizontalOptions="Center"/>
                                <Label Text="Cài Đặt" TextColor="#F5DBAA" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </Border>

                <!-- CHỈ BÁO ĐANG TẢI & THÔNG BÁO LỖI -->
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="#9F422F"/>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#A34032" FontSize="11" HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 5. BẢNG BẬT LÊN CHỌN ĐỘ KHÓ (DIFFICULTY PICKER MODAL) -->
        <Border IsVisible="{Binding IsDifficultyModalVisible}" BackgroundColor="#99000000" StrokeThickness="0" Padding="20">
            <Border Style="{StaticResource CardStyle}" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="360" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="CHỌN CẤP ĐỘ MÁY ĐẤU" FontSize="15" FontAttributes="Bold" TextColor="#9F422F" HorizontalTextAlignment="Center"/>
                    <Label Text="Chọn độ khó phù hợp với trình độ của bạn để bắt đầu luyện cờ:" FontSize="12" TextColor="#786956" HorizontalTextAlignment="Center"/>

                    <!-- CÁC CẤP ĐỘ (MỖI NÚT >= 48 DIP) -->
                    <VerticalStackLayout Spacing="8" Margin="0,4">
                        <Button Text="Cấp 1 · Tập sự (Nước đi nhanh, dễ thắng)"
                                Command="{Binding StartAiWithDifficultyCommand}"
                                CommandParameter="{x:Int32 1}"
                                BackgroundColor="#F3EBDD" TextColor="#342B23"
                                HeightRequest="50" CornerRadius="10"/>

                        <Button Text="Cấp 2 · Kỳ thủ (Cân bằng, phổ thông)"
                                Command="{Binding StartAiWithDifficultyCommand}"
                                CommandParameter="{x:Int32 2}"
                                BackgroundColor="#C6A052" TextColor="#FFF9EF"
                                HeightRequest="50" CornerRadius="10"/>

                        <Button Text="Cấp 3 · Kiện tướng (Nước cờ chiến thuật)"
                                Command="{Binding StartAiWithDifficultyCommand}"
                                CommandParameter="{x:Int32 3}"
                                BackgroundColor="#9F422F" TextColor="#FFF9EF"
                                HeightRequest="50" CornerRadius="10"/>

                        <Button Text="Cấp 4 · Đại sư (Sát cục hiểm hóc)"
                                Command="{Binding StartAiWithDifficultyCommand}"
                                CommandParameter="{x:Int32 4}"
                                BackgroundColor="#7C2D1E" TextColor="#FFF9EF"
                                HeightRequest="50" CornerRadius="10"/>
                    </VerticalStackLayout>

                    <Button Text="Hủy bỏ" Command="{Binding CloseDifficultyPickerCommand}" Style="{StaticResource QuietButton}" HeightRequest="48" CornerRadius="10"/>
                </VerticalStackLayout>
            </Border>
        </Border>

    </Grid>
</ContentPage>
