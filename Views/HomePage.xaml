<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:ChessCore.Mobile.ViewModels"
             x:Class="ChessCore.Mobile.Views.HomePage" x:DataType="vm:HomeViewModel" Title="Sảnh cờ">
 <ScrollView><VerticalStackLayout Padding="18,16,18,24" Spacing="18" MaximumWidthRequest="1000" HorizontalOptions="Fill">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
   <VerticalStackLayout><Label Text="KỲ ĐẠO · PIXEL 1.2" CharacterSpacing="4" FontSize="12" TextColor="#8E6937" FontAttributes="Bold"/><Label Text="Sảnh kỳ đạo" FontSize="28" FontAttributes="Bold"/></VerticalStackLayout>
   <Button Grid.Column="1" Text="Cài đặt" Command="{Binding GoToSettingsCommand}" Style="{StaticResource QuietButton}" VerticalOptions="Center" SemanticProperties.Description="Cài đặt kết nối và chuyển động"/>
  </Grid>
  <Border BackgroundColor="#282B29" Stroke="#B68A4A" StrokeShape="RoundRectangle 20" Padding="16">
   <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
    <Border BackgroundColor="#416A60" Stroke="#D6B16D" StrokeThickness="2" StrokeShape="RoundRectangle 32" HeightRequest="64" WidthRequest="64"><Label Text="{Binding AvatarLetter}" FontSize="30" TextColor="#FFF3D6" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center"><Label Text="{Binding PlayerName}" TextColor="#F7E6BE" FontSize="18" FontAttributes="Bold" LineBreakMode="TailTruncation"/><Label Text="{Binding PlayerIdDisplay}" TextColor="#BABAA9" FontSize="11" LineBreakMode="TailTruncation"/></VerticalStackLayout>
    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="3"><Label Text="ELO" FontSize="10" TextColor="#D6B16D" HorizontalOptions="End"/><Label Text="{Binding EloDisplay}" TextColor="#F5D99D" FontSize="23" FontAttributes="Bold"/></VerticalStackLayout>
   </Grid>
  </Border>
  <Border Stroke="#D2BD95" StrokeShape="RoundRectangle 22" HeightRequest="216" Padding="0">
   <Grid><Image Source="pavilion.png" Aspect="AspectFill"/>
    <VerticalStackLayout Padding="20" Spacing="8" VerticalOptions="Center" HorizontalOptions="Start" MaximumWidthRequest="290">
     <Label Text="TĨNH TÂM · ĐẤU TRÍ" FontSize="10" CharacterSpacing="2" TextColor="#7B5C33" FontAttributes="Bold"/>
     <Label Text="Một nước cờ,&#10;một thế giới." FontSize="28" FontAttributes="Bold" TextColor="#493A29"/>
     <Button Text="CHƠI VỚI MÁY  →" Command="{Binding PlayAiCommand}" HorizontalOptions="Start" Margin="0,6,0,0"/>
    </VerticalStackLayout>
   </Grid>
  </Border>
  <Grid ColumnDefinitions="*,Auto"><Label Text="Bắt đầu ván cờ" FontSize="20" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding TotalGames, StringFormat='{0} ván đã chơi'}" FontSize="12" TextColor="#786956" VerticalOptions="Center"/></Grid>
  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
   <Border Grid.Column="0" BackgroundColor="#EBC49A" Stroke="#BD8049" StrokeShape="RoundRectangle 18" Padding="14">
    <VerticalStackLayout Spacing="8"><Grid HeightRequest="62"><Image Source="chess_emblem.png" WidthRequest="68" HeightRequest="68" HorizontalOptions="End"/><Label Text="01" FontSize="13" TextColor="#87532D" VerticalOptions="Start"/></Grid><Label Text="Đấu với máy" FontSize="18" FontAttributes="Bold"/><Label Text="{Binding DifficultyName, StringFormat='{0} · Không cần mạng'}" FontSize="12" TextColor="#6F5135"/><Button Text="Chơi ngay" Command="{Binding PlayAiCommand}" BackgroundColor="#9F422F"/></VerticalStackLayout>
   </Border>
   <Border Grid.Column="1" BackgroundColor="#C8D7C7" Stroke="#7C9D87" StrokeShape="RoundRectangle 18" Padding="14">
    <VerticalStackLayout Spacing="8"><Grid HeightRequest="62"><Label Text="車" FontSize="49" TextColor="#3E6C62" HorizontalOptions="End"/><Label Text="02" FontSize="13" TextColor="#416A60"/></Grid><Label Text="Đấu online" FontSize="18" FontAttributes="Bold"/><Label Text="Tạo bàn · Nhập mã" FontSize="12" TextColor="#486555"/><Button Text="Chọn bàn" Command="{Binding GoToLobbyCommand}" BackgroundColor="#3E6C62"/></VerticalStackLayout>
   </Border>
   <Border Grid.Row="1" BackgroundColor="#ECDDAB" Stroke="#B7A063" StrokeShape="RoundRectangle 18" Padding="14">
    <VerticalStackLayout Spacing="8"><Grid HeightRequest="50"><Label Text="炮" FontSize="42" TextColor="#96712E" HorizontalOptions="End"/><Label Text="03 · BẢN WEB" FontSize="10" TextColor="#7C6738"/></Grid><Label Text="Kho cờ thế" FontSize="18" FontAttributes="Bold"/><Label Text="Khám phá thế cờ" FontSize="12" TextColor="#756343"/><Button Text="Mở kho cờ" Command="{Binding GoToPuzzlesCommand}" BackgroundColor="#97753A"/></VerticalStackLayout>
   </Border>
   <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#DED2C2" Stroke="#B29A7E" StrokeShape="RoundRectangle 18" Padding="14">
    <VerticalStackLayout Spacing="8"><Grid HeightRequest="50"><Label Text="士" FontSize="42" TextColor="#75614B" HorizontalOptions="End"/><Label Text="04 · BẢN WEB" FontSize="10" TextColor="#75614B"/></Grid><Label Text="Kỳ thư" FontSize="18" FontAttributes="Bold"/><Label Text="Học từ từng nước đi" FontSize="12" TextColor="#75614B"/><Button Text="Vào khóa học" Command="{Binding GoToCoursesCommand}" BackgroundColor="#75614B"/></VerticalStackLayout>
   </Border>
  </Grid>
  <Border Style="{StaticResource CardStyle}"><VerticalStackLayout Spacing="12">
   <Grid ColumnDefinitions="*,Auto"><Label Text="Máy trên thiết bị" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding DifficultyName}" FontSize="12" TextColor="#9F422F"/></Grid>
   <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
    <Button Grid.Column="0" Text="Dễ" Clicked="OnDifficulty1Clicked" BackgroundColor="#E7DCC8" TextColor="#493A29" Padding="4,6" FontSize="12"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedDifficulty}" Value="1"><Setter Property="BackgroundColor" Value="#9F422F"/><Setter Property="TextColor" Value="#FFF9EF"/></DataTrigger></Button.Triggers></Button>
    <Button Grid.Column="1" Text="Vừa" Clicked="OnDifficulty2Clicked" BackgroundColor="#E7DCC8" TextColor="#493A29" Padding="4,6" FontSize="12"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedDifficulty}" Value="2"><Setter Property="BackgroundColor" Value="#9F422F"/><Setter Property="TextColor" Value="#FFF9EF"/></DataTrigger></Button.Triggers></Button>
    <Button Grid.Column="2" Text="Khó" Clicked="OnDifficulty3Clicked" BackgroundColor="#E7DCC8" TextColor="#493A29" Padding="4,6" FontSize="12"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedDifficulty}" Value="3"><Setter Property="BackgroundColor" Value="#9F422F"/><Setter Property="TextColor" Value="#FFF9EF"/></DataTrigger></Button.Triggers></Button>
    <Button Grid.Column="3" Text="Đại sư" Clicked="OnDifficulty4Clicked" BackgroundColor="#E7DCC8" TextColor="#493A29" Padding="4,6" FontSize="12"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedDifficulty}" Value="4"><Setter Property="BackgroundColor" Value="#9F422F"/><Setter Property="TextColor" Value="#FFF9EF"/></DataTrigger></Button.Triggers></Button>

   </Grid>
  </VerticalStackLayout></Border>
  <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"/>
  <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#A34032"/>
  <Button Text="{Binding AccountText}" Command="{Binding LogoutCommand}" Style="{StaticResource QuietButton}"/>
  <Label Text="Tập trung vào thế cờ. Tận hưởng từng nước đi." FontSize="11" TextColor="#8A7B66" HorizontalTextAlignment="Center"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
