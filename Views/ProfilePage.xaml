<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChessCore.Mobile.ViewModels"
             x:Class="ChessCore.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="#F3EBDD"
             Title="Hồ Sơ Kỳ Thủ">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Card Thông tin cá nhân -->
            <Border BackgroundColor="#FFF9EF" StrokeShape="RoundRectangle 16" Stroke="#DDCDB3" Padding="20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="👤" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="{Binding Username}" FontSize="22" FontAttributes="Bold" TextColor="#342B23" HorizontalOptions="Center" />
                    <Label Text="{Binding PlayerId, StringFormat='Mã định danh: {0}'}" FontSize="13" TextColor="#786956" HorizontalOptions="Center" />
                    <Label Text="{Binding Email, StringFormat='Email: {0}'}" FontSize="12" TextColor="#786956" HorizontalOptions="Center" />

                    <!-- Điểm Elo Nổi Bật -->
                    <Border BackgroundColor="#451a03" Stroke="#9F422F" StrokeShape="RoundRectangle 12" Padding="20,10" Margin="0,10,0,0" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="HỆ SỐ ELO:" FontSize="13" FontAttributes="Bold" TextColor="#9A6B2D" VerticalOptions="Center" />
                            <Label Text="{Binding Elo}" FontSize="24" FontAttributes="Bold" TextColor="#9A6B2D" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Card Thống kê chiến tích -->
            <Border BackgroundColor="#FFF9EF" StrokeShape="RoundRectangle 16" Stroke="#DDCDB3" Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Thống Kê Chiến Tích" FontSize="16" FontAttributes="Bold" TextColor="#342B23" />

                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Tổng số ván" FontSize="11" TextColor="#786956" HorizontalOptions="Center" />
                            <Label Text="{Binding TotalGames}" FontSize="18" FontAttributes="Bold" TextColor="#342B23" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Thắng" FontSize="11" TextColor="#31765D" HorizontalOptions="Center" />
                            <Label Text="{Binding Wins}" FontSize="18" FontAttributes="Bold" TextColor="#31765D" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="Hòa" FontSize="11" TextColor="#936D28" HorizontalOptions="Center" />
                            <Label Text="{Binding Draws}" FontSize="18" FontAttributes="Bold" TextColor="#936D28" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                            <Label Text="Thua" FontSize="11" TextColor="#ef4444" HorizontalOptions="Center" />
                            <Label Text="{Binding Losses}" FontSize="18" FontAttributes="Bold" TextColor="#ef4444" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border BackgroundColor="#F3EBDD" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Tỷ lệ thắng trận:" TextColor="#655541" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding WinRate, StringFormat='{0}%'}" TextColor="#31765D" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button Text="Quay lại Trang Chủ" Command="{Binding BackCommand}" 
                    BackgroundColor="Transparent" TextColor="#786956" FontSize="13" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
