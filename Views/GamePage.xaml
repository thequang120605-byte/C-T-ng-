<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:ChessCore.Mobile.ViewModels"
             x:Class="ChessCore.Mobile.Views.GamePage" x:DataType="vm:GameViewModel" Shell.TabBarIsVisible="False" Title="Kỳ đài">
 <Grid RowDefinitions="Auto,*">
  <Border BackgroundColor="#282B29" StrokeThickness="0" Padding="10,6"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
   <Button Text="‹ Sảnh" Command="{Binding ConfirmExitCommand}" BackgroundColor="Transparent" TextColor="#F5DBAA" Padding="8,4"/>
   <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label Text="{Binding RoomText}" FontSize="12" TextColor="#E6C38D" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation"/><Label Text="{Binding ConnectionText}" FontSize="10" TextColor="#C1C0AD" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation"/></VerticalStackLayout>
   <Button Grid.Column="2" Text="Đồng bộ" Command="{Binding RefreshCommand}" BackgroundColor="#42463D" TextColor="#F5DBAA" FontSize="11" Padding="8,4"/>
  </Grid></Border>
  <Grid Grid.Row="1" x:Name="GameLayout" RowDefinitions="*,Auto" ColumnDefinitions="*" Padding="8" RowSpacing="6" ColumnSpacing="12">
   <Grid x:Name="BoardArea" RowDefinitions="Auto,*,Auto" RowSpacing="4">
    <Border x:Name="OpponentCard" BackgroundColor="#E7DCC8" Stroke="#D2BF9E" StrokeShape="RoundRectangle 14" Padding="12,8">
     <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
      <VerticalStackLayout Spacing="2"><Label Text="{Binding OpponentName}" FontAttributes="Bold" FontSize="15"/><Label Text="{Binding OpponentSideText}" FontSize="10" TextColor="#786956"/></VerticalStackLayout>
      <ActivityIndicator Grid.Column="1" IsVisible="{Binding IsAiThinking}" IsRunning="{Binding IsAiThinking}" Color="#9F422F" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
      <Label Grid.Column="2" Text="{Binding CurrentTurnText}" FontSize="12" TextColor="#9F422F" VerticalOptions="Center" MaximumWidthRequest="160" HorizontalTextAlignment="End"/>
     </Grid>
    </Border>
    <Grid Grid.Row="1"><GraphicsView x:Name="ChessBoardView" StartInteraction="OnBoardStartInteraction" DragInteraction="OnBoardDragInteraction" EndInteraction="OnBoardEndInteraction" CancelInteraction="OnBoardCancelInteraction" HorizontalOptions="Fill" VerticalOptions="Fill" SemanticProperties.Description="{Binding CurrentTurnText}" SemanticProperties.Hint="Chạm quân của bạn rồi chạm một giao điểm được đánh dấu."/>
     <Border IsVisible="{Binding IsCheck}" BackgroundColor="#A34032" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Start" HorizontalOptions="Center" Padding="12,5" InputTransparent="True"><Label Text="CHIẾU TƯỚNG" TextColor="#FFF9EF" FontSize="11" FontAttributes="Bold"/></Border>
    </Grid>
    <Border x:Name="PlayerCard" Grid.Row="2" BackgroundColor="#FFF9EF" Stroke="#C6A362" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="12,8"><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsMyTurn}" Value="True"><Setter Property="Stroke" Value="#3E6C62"/><Setter Property="BackgroundColor" Value="#E6F0E6"/></DataTrigger></Border.Triggers><Grid ColumnDefinitions="*"><VerticalStackLayout Spacing="2"><Label Text="{Binding PlayerName}" FontAttributes="Bold" FontSize="15"/><Label Text="{Binding MySideText}" FontSize="10" TextColor="#9F422F"/></VerticalStackLayout></Grid></Border>
   </Grid>
   <Border x:Name="DetailPanel" Grid.Row="1" BackgroundColor="#FFF9EF" Stroke="#DDCDB3" StrokeShape="RoundRectangle 16" Padding="12,8">
    <ScrollView><Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
     <VerticalStackLayout Spacing="3"><Label Text="{Binding StatusMessage}" FontSize="12" FontAttributes="Bold"/><Label Text="{Binding SelectionText}" FontSize="10" TextColor="#786956" LineBreakMode="TailTruncation"/></VerticalStackLayout>
     <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="3">
      <VerticalStackLayout Grid.Column="0" Spacing="2"><Label Text="H1" FontSize="10" TextColor="#786956" HorizontalTextAlignment="Center"/><Label Text="{Binding H1Score}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/></VerticalStackLayout>
      <VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="H2" FontSize="10" TextColor="#786956" HorizontalTextAlignment="Center"/><Label Text="{Binding H2Score}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/></VerticalStackLayout>
      <VerticalStackLayout Grid.Column="2" Spacing="2"><Label Text="H3" FontSize="10" TextColor="#786956" HorizontalTextAlignment="Center"/><Label Text="{Binding H3Score}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/></VerticalStackLayout>
      <VerticalStackLayout Grid.Column="3" Spacing="2"><Label Text="H4" FontSize="10" TextColor="#786956" HorizontalTextAlignment="Center"/><Label Text="{Binding H4Score}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/></VerticalStackLayout>
      <VerticalStackLayout Grid.Column="4" Spacing="2"><Label Text="TỔNG" FontSize="10" TextColor="#786956" HorizontalTextAlignment="Center"/><Label Text="{Binding TotalScore}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/></VerticalStackLayout>
     </Grid>
     <VerticalStackLayout Grid.Row="2" Spacing="6"><Button Text="Tiếp tục lượt máy" IsVisible="{Binding CanRetryAi}" Command="{Binding RetryAiCommand}"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="6"><Button Text="Đổi góc" Command="{Binding FlipBoardCommand}" Style="{StaticResource QuietButton}" FontSize="11" Padding="4,6"/><Button Grid.Column="1" Text="Ván mới" Command="{Binding NewGameCommand}" Style="{StaticResource QuietButton}" FontSize="11" Padding="4,6"/><Button Grid.Column="2" Text="Xin thua" Command="{Binding ResignCommand}" FontSize="11" Padding="4,6"/></Grid></VerticalStackLayout>
     <VerticalStackLayout x:Name="WideDetails" Grid.Row="3" IsVisible="False" Spacing="8">
      <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding OpponentName}" FontAttributes="Bold"/><ActivityIndicator Grid.Column="1" IsVisible="{Binding IsAiThinking}" IsRunning="{Binding IsAiThinking}" Color="#9F422F" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/></Grid>
      <Label Text="{Binding PlayerName, StringFormat='Bạn: {0}'}" FontSize="12"/>
      <BoxView HeightRequest="1" Color="#DDCDB3"/>
      <Label Text="ĐÁNH GIÁ THẾ CỜ" FontSize="11" CharacterSpacing="1" FontAttributes="Bold" TextColor="#8E6937"/>
      <Label Text="H1 · Vật chất&#10;H2 · Vị trí / cơ động&#10;H3 · Chiến thuật&#10;H4 · Tam / tứ tử đồng biên" FontSize="12" TextColor="#786956"/>
      <Label Text="Điểm dương nghiêng về Đỏ, điểm âm nghiêng về Đen. Đây là điểm heuristic, không phải Elo." FontSize="11" TextColor="#786956"/>
      <Label Text="{Binding MoveCountText}" FontAttributes="Bold"/>
      <ScrollView MaximumHeightRequest="180"><Label Text="{Binding HistoryText}" FontSize="11" TextColor="#786956"/></ScrollView>
     </VerticalStackLayout>
    </Grid></ScrollView>
   </Border>
  </Grid>
  <Border Grid.RowSpan="2" IsVisible="{Binding IsGameOver}" BackgroundColor="#C8282B29" StrokeThickness="0" Padding="24">
   <Border Style="{StaticResource CardStyle}" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="380"><ScrollView MaximumHeightRequest="500"><VerticalStackLayout Spacing="16"><Label Text="KẾT THÚC VÁN CỜ" FontSize="10" CharacterSpacing="2" TextColor="#8E6937" HorizontalTextAlignment="Center"/><Label Text="{Binding GameOverTitle}" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="{Binding GameOverMessage}" FontSize="14" TextColor="#786956" HorizontalTextAlignment="Center"/><Button Text="Chơi ván tiếp theo" Command="{Binding NewGameCommand}"/><Button Text="Trở về sảnh" Command="{Binding BackToHomeCommand}" Style="{StaticResource QuietButton}"/></VerticalStackLayout></ScrollView></Border>
  </Border>
 </Grid>
</ContentPage>