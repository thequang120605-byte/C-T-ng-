<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:ChessCore.Mobile.Models" xmlns:vm="clr-namespace:ChessCore.Mobile.ViewModels" x:Class="ChessCore.Mobile.Views.OnlineLobbyPage" x:DataType="vm:OnlineLobbyViewModel" Title="Chọn bàn">
 <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="18" RowSpacing="14" MaximumWidthRequest="1000" HorizontalOptions="Fill">
  <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="KỲ ĐÀI TRỰC TUYẾN" FontSize="10" CharacterSpacing="2" TextColor="#8E6937"/><Label Text="Chọn bàn cờ" FontSize="25" FontAttributes="Bold"/></VerticalStackLayout><Button Grid.Column="1" Text="Tạo bàn" Command="{Binding CreateRoomCommand}" VerticalOptions="Center"/></Grid>
  <Border Grid.Row="1" Style="{StaticResource CardStyle}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><Entry Text="{Binding RoomCodeInput}" Placeholder="Nhập mã phòng" MaxLength="32" SemanticProperties.Description="Mã phòng cờ"/><Button Grid.Column="1" Text="Vào bàn" Command="{Binding JoinByCodeCommand}"/></Grid></Border>
  <VerticalStackLayout Grid.Row="2" Spacing="6"><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#A34032"/><Grid ColumnDefinitions="*,Auto"><Label Text="Bàn đang chờ kỳ thủ" VerticalOptions="Center" FontAttributes="Bold"/><Button Grid.Column="1" Text="Làm mới" Command="{Binding RefreshRoomsCommand}" Style="{StaticResource QuietButton}"/></Grid><ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HeightRequest="24"/></VerticalStackLayout>
  <CollectionView Grid.Row="3" ItemsSource="{Binding Rooms}" SelectionMode="None">
   <CollectionView.EmptyView><VerticalStackLayout Padding="24" VerticalOptions="Center" Spacing="10"><Label Text="Chưa có bàn đang chờ" FontSize="19" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Tạo bàn mới và gửi mã phòng cho bạn bè." TextColor="#786956" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="models:RoomItemDto"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><VerticalStackLayout Spacing="4"><Label Text="{Binding RoomCode, StringFormat='Bàn {0}'}" FontSize="19" FontAttributes="Bold" TextColor="#8E6937"/><Label Text="{Binding CreatorUsername}"/><Label Text="{Binding CreatorElo, StringFormat='Elo {0}'}" FontSize="12" TextColor="#786956"/></VerticalStackLayout><Button Grid.Column="1" Text="Tham gia" Clicked="OnJoinRoomItemClicked" VerticalOptions="Center"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
  <Label Grid.Row="4" Text="Mỗi bàn là một cuộc đấu trí mới." TextColor="#8A7B66" FontSize="11" HorizontalTextAlignment="Center"/>
 </Grid>
</ContentPage>
