@model ChessCore.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-box" style="max-width: 520px; min-height: 480px; flex-direction: column; padding: 40px;">
        
        <div style="text-align: center; margin-bottom: 25px;">
            <i class="fa-solid fa-key" style="font-size: 54px; color: var(--accent-gold); margin-bottom: 16px;"></i>
            <h2 style="color: var(--text-main); margin-bottom: 8px;">Đặt Lại Mật Khẩu</h2>
            <p style="color: var(--text-muted); font-size: 14px;">Mã xác thực đã được gửi tới <strong>@Model.Email</strong></p>
            
            @if (TempData["OtpMessage"] != null)
            {
                <p style="color: #10b981; font-size: 14px; margin-top: 8px;">@TempData["OtpMessage"]</p>
            }

            @if (TempData["DevOtp"] != null)
            {
                <div style="background: rgba(217, 119, 6, 0.1); border: 1px dashed var(--accent-gold); padding: 10px; margin-top: 15px; border-radius: 8px;">
                    <span style="color: var(--accent-gold-dark); font-size: 13px;">[DEV MODE] Mã OTP của bạn là: <strong style="font-size: 18px;">@TempData["DevOtp"]</strong></span>
                </div>
            }
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-error-box" style="margin-bottom: 15px;">
                <div asp-validation-summary="All" class="text-danger" style="margin:0;"></div>
            </div>
        }

        <form asp-controller="Auth" asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />

            <div class="input-group">
                <label asp-for="Otp">Nhập mã OTP 6 số</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-shield-halved"></i>
                    <input asp-for="Otp" placeholder="123456" maxlength="6" style="letter-spacing: 4px; text-align: center; font-size: 18px; font-weight: bold;" />
                </div>
                <span asp-validation-for="Otp" class="text-danger"></span>
            </div>

            <div class="input-group" style="margin-bottom: 12px;">
                <label asp-for="NewPassword">Mật khẩu mới</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-lock"></i>
                    <input asp-for="NewPassword" type="password" id="reset-pwd" placeholder="Nhập mật khẩu mới an toàn" autocomplete="new-password" />
                    <i class="fa-solid fa-eye toggle-pwd" onclick="togglePassword('reset-pwd', this)"></i>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <!-- CARD KIỂM TRA ĐỘ MẠNH & TIÊU CHÍ MẬT KHẨU CHUYÊN NGHIỆP -->
            <div class="pwd-validation-card" id="pwd-validation-box">
                <div class="pwd-strength-header">
                    <span class="pwd-strength-title"><i class="fa-solid fa-shield-halved"></i> Độ an toàn mật khẩu:</span>
                    <span class="pwd-strength-badge" id="pwd-strength-text">Chưa nhập</span>
                </div>
                <div class="pwd-strength-meter">
                    <div class="strength-segment" id="seg-1"></div>
                    <div class="strength-segment" id="seg-2"></div>
                    <div class="strength-segment" id="seg-3"></div>
                    <div class="strength-segment" id="seg-4"></div>
                </div>

                <div class="pwd-criteria-grid" id="pwd-reqs">
                    <div class="pwd-criterion" id="req-len">
                        <span class="crit-icon"><i class="fa-solid fa-circle-xmark"></i></span>
                        <span class="crit-label">Ít nhất 6 ký tự</span>
                    </div>
                    <div class="pwd-criterion" id="req-case">
                        <span class="crit-icon"><i class="fa-solid fa-circle-xmark"></i></span>
                        <span class="crit-label">Chữ hoa và chữ thường</span>
                    </div>
                    <div class="pwd-criterion" id="req-num">
                        <span class="crit-icon"><i class="fa-solid fa-circle-xmark"></i></span>
                        <span class="crit-label">Bao gồm chữ số</span>
                    </div>
                    <div class="pwd-criterion" id="req-spec">
                        <span class="crit-icon"><i class="fa-solid fa-circle-xmark"></i></span>
                        <span class="crit-label">Ký tự đặc biệt (!@@#$...)</span>
                    </div>
                </div>
            </div>

            <div class="input-group">
                <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-shield-halved"></i>
                    <input asp-for="ConfirmPassword" type="password" id="reset-confirm-pwd" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                    <i class="fa-solid fa-eye toggle-pwd" onclick="togglePassword('reset-confirm-pwd', this)"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                <div id="pwd-match-hint" class="pwd-match-hint"></div>
            </div>

            <button type="submit" class="btn-auth" style="margin-top: 15px;">
                ĐẶT LẠI MẬT KHẨU <i class="fa-solid fa-check"></i>
            </button>
        </form>

        <div style="text-align: center; margin-top: 20px;">
            <span style="color: var(--text-muted); font-size: 14px;">Mã OTP sẽ hết hạn sau: </span>
            <span id="countdown-timer" style="color: #ef4444; font-weight: bold; font-size: 16px;">05:00</span>
        </div>

        <form id="resendForm" asp-controller="Auth" asp-action="ResendResetOtp" method="post" style="display: none; text-align: center; margin-top: 15px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@Model.Email" />
            <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 8px;">Chưa nhận được mã?</p>
            <button type="submit" style="background: none; border: 1px solid var(--border-color); color: var(--accent-gold-dark); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: 0.2s;">
                <i class="fa-solid fa-rotate-right"></i> GỬI LẠI OTP
            </button>
        </form>

        <p class="auth-footer" style="margin-top: 20px;">
            <a asp-controller="Auth" asp-action="Login">Quay lại đăng nhập</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // Đếm ngược 5 phút
        let timeLeft = 300;
        const timerDisplay = document.getElementById('countdown-timer');
        const resendForm = document.getElementById('resendForm');

        const timer = setInterval(() => {
            timeLeft--;
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            if (timeLeft <= 0) {
                clearInterval(timer);
                timerDisplay.textContent = "HẾT HẠN";
                timerDisplay.style.color = "var(--text-muted)";
                resendForm.style.display = "block";
            }
        }, 1000);
    
        // Validation mật khẩu thời gian thực
        document.addEventListener('DOMContentLoaded', function() {
            const pwdInput = document.getElementById('reset-pwd');
            const confirmPwdInput = document.getElementById('reset-confirm-pwd');
            const strengthBadge = document.getElementById('pwd-strength-text');
            const matchHint = document.getElementById('pwd-match-hint');
            const segments = [
                document.getElementById('seg-1'),
                document.getElementById('seg-2'),
                document.getElementById('seg-3'),
                document.getElementById('seg-4')
            ];

            function setReqState(id, isValid) {
                const req = document.getElementById(id);
                if (!req) return;
                const icon = req.querySelector('.crit-icon i') || req.querySelector('i');
                if (isValid) {
                    req.classList.add('valid');
                    if (icon) icon.className = 'fa-solid fa-circle-check';
                } else {
                    req.classList.remove('valid');
                    if (icon) icon.className = 'fa-solid fa-circle-xmark';
                }
            }

            function updateStrength(val) {
                if (!val || val.length === 0) {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Chưa nhập';
                        strengthBadge.className = 'pwd-strength-badge';
                    }
                    segments.forEach(seg => {
                        if (seg) seg.className = 'strength-segment';
                    });
                    setReqState('req-len', false);
                    setReqState('req-case', false);
                    setReqState('req-num', false);
                    setReqState('req-spec', false);
                    return 0;
                }

                const hasLen = val.length >= 6;
                const hasCase = /[a-z]/.test(val) && /[A-Z]/.test(val);
                const hasNum = /\d/.test(val);
                const hasSpec = /[^a-zA-Z0-9]/.test(val);

                setReqState('req-len', hasLen);
                setReqState('req-case', hasCase);
                setReqState('req-num', hasNum);
                setReqState('req-spec', hasSpec);

                let score = 0;
                if (hasLen) score++;
                if (hasCase) score++;
                if (hasNum) score++;
                if (hasSpec) score++;

                segments.forEach(seg => {
                    if (seg) seg.className = 'strength-segment';
                });

                if (score <= 1) {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Yếu';
                        strengthBadge.className = 'pwd-strength-badge weak';
                    }
                    if (segments[0]) segments[0].classList.add('active-weak');
                } else if (score === 2) {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Trung bình';
                        strengthBadge.className = 'pwd-strength-badge medium';
                    }
                    if (segments[0]) segments[0].classList.add('active-medium');
                    if (segments[1]) segments[1].classList.add('active-medium');
                } else if (score === 3) {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Khá an toàn';
                        strengthBadge.className = 'pwd-strength-badge good';
                    }
                    if (segments[0]) segments[0].classList.add('active-good');
                    if (segments[1]) segments[1].classList.add('active-good');
                    if (segments[2]) segments[2].classList.add('active-good');
                } else {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Rất an toàn';
                        strengthBadge.className = 'pwd-strength-badge strong';
                    }
                    segments.forEach(seg => {
                        if (seg) seg.classList.add('active-strong');
                    });
                }

                return score;
            }

            function checkMatch() {
                const val1 = pwdInput.value;
                const val2 = confirmPwdInput.value;
                const wrapper = confirmPwdInput.closest('.input-icon-wrapper');
                const icon = wrapper ? wrapper.querySelector('.fa-shield-halved, .fa-lock') : null;
                
                if (val2.length > 0 && val1 === val2) {
                    if (wrapper) {
                        wrapper.style.borderColor = '#10b981';
                        wrapper.style.boxShadow = '0 0 0 3px rgba(16, 185, 129, 0.15)';
                    }
                    if (icon) icon.style.color = '#10b981';
                    if (matchHint) {
                        matchHint.innerHTML = '<i class="fa-solid fa-circle-check"></i> Mật khẩu xác nhận trùng khớp hoàn toàn';
                        matchHint.className = 'pwd-match-hint show-success';
                    }
                } else if (val2.length > 0) {
                    if (wrapper) {
                        wrapper.style.borderColor = '#ef4444';
                        wrapper.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.15)';
                    }
                    if (icon) icon.style.color = '#ef4444';
                    if (matchHint) {
                        matchHint.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> Mật khẩu xác nhận chưa trùng khớp';
                        matchHint.className = 'pwd-match-hint show-error';
                    }
                } else {
                    if (wrapper) {
                        wrapper.style.borderColor = 'var(--border-color)';
                        wrapper.style.boxShadow = 'none';
                    }
                    if (icon) icon.style.color = 'var(--text-muted)';
                    if (matchHint) {
                        matchHint.innerHTML = '';
                        matchHint.className = 'pwd-match-hint';
                    }
                }
            }

            pwdInput.addEventListener('input', function() {
                updateStrength(this.value);
                if (confirmPwdInput.value.length > 0) {
                    checkMatch();
                }
            });

            confirmPwdInput.addEventListener('input', checkMatch);
        });
</script>
}
