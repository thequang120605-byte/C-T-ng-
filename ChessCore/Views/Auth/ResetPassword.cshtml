@model ChessCore.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-box" style="max-width: 520px; min-height: 480px; flex-direction: column; padding: 40px;">
        
        <div style="text-align: center; margin-bottom: 25px;">
            <i class="fa-solid fa-key" style="font-size: 54px; color: var(--accent-gold); margin-bottom: 16px;"></i>
            <h2 style="color: var(--text-main); margin-bottom: 8px;">Đặt Lại Mật Khẩu</h2>
            <p style="color: var(--text-muted); font-size: 14px;">Mã xác thực đã được gửi tới <strong>@Model.Email</strong></p>
            
            @if (TempData["OtpMessage"] != null)
            {
                <p style="color: #10b981; font-size: 14px; margin-top: 8px;">@TempData["OtpMessage"]</p>
            }

            @if (TempData["DevOtp"] != null)
            {
                <div style="background: rgba(217, 119, 6, 0.1); border: 1px dashed var(--accent-gold); padding: 10px; margin-top: 15px; border-radius: 8px;">
                    <span style="color: var(--accent-gold-dark); font-size: 13px;">[DEV MODE] Mã OTP của bạn là: <strong style="font-size: 18px;">@TempData["DevOtp"]</strong></span>
                </div>
            }
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-error-box" style="margin-bottom: 15px;">
                <div asp-validation-summary="All" class="text-danger" style="margin:0;"></div>
            </div>
        }

        <form asp-controller="Auth" asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />

            <div class="input-group">
                <label asp-for="Otp">Nhập mã OTP 6 số</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-shield-halved"></i>
                    <input asp-for="Otp" placeholder="123456" maxlength="6" style="letter-spacing: 4px; text-align: center; font-size: 18px; font-weight: bold;" />
                </div>
                <span asp-validation-for="Otp" class="text-danger"></span>
            </div>

            <div class="input-group">
                <label asp-for="NewPassword">Mật khẩu mới</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-lock"></i>
                    <input asp-for="NewPassword" type="password" id="reset-pwd" placeholder="Nhập mật khẩu mới (ít nhất 6 ký tự)" />
                    <i class="fa-solid fa-eye toggle-pwd" onclick="togglePassword('reset-pwd', this)"></i>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="input-group">
                <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-lock"></i>
                    <input asp-for="ConfirmPassword" type="password" id="reset-confirm-pwd" placeholder="Nhập lại mật khẩu mới" />
                    <i class="fa-solid fa-eye toggle-pwd" onclick="togglePassword('reset-confirm-pwd', this)"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth" style="margin-top: 15px;">
                ĐẶT LẠI MẬT KHẨU <i class="fa-solid fa-check"></i>
            </button>
        </form>

        <div style="text-align: center; margin-top: 20px;">
            <span style="color: var(--text-muted); font-size: 14px;">Mã OTP sẽ hết hạn sau: </span>
            <span id="countdown-timer" style="color: #ef4444; font-weight: bold; font-size: 16px;">05:00</span>
        </div>

        <form id="resendForm" asp-controller="Auth" asp-action="ResendResetOtp" method="post" style="display: none; text-align: center; margin-top: 15px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@Model.Email" />
            <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 8px;">Chưa nhận được mã?</p>
            <button type="submit" style="background: none; border: 1px solid var(--border-color); color: var(--accent-gold-dark); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: 0.2s;">
                <i class="fa-solid fa-rotate-right"></i> GỬI LẠI OTP
            </button>
        </form>

        <p class="auth-footer" style="margin-top: 20px;">
            <a asp-controller="Auth" asp-action="Login">Quay lại đăng nhập</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // Đếm ngược 5 phút
        let timeLeft = 300;
        const timerDisplay = document.getElementById('countdown-timer');
        const resendForm = document.getElementById('resendForm');

        const timer = setInterval(() => {
            timeLeft--;
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            if (timeLeft <= 0) {
                clearInterval(timer);
                timerDisplay.textContent = "HẾT HẠN";
                timerDisplay.style.color = "var(--text-muted)";
                resendForm.style.display = "block";
            }
        }, 1000);
    </script>
}
