@model ChessCore.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-box">
        <div class="auth-left">
            <div class="auth-brand">
                <i class="fa-solid fa-chess-knight"></i>
                <h2>Cờ Tướng Pro</h2>
            </div>
            <p>Khôi phục mật khẩu tài khoản của bạn thông qua mã xác thực OTP gửi về địa chỉ Email đã đăng ký.</p>
        </div>
        
        <div class="auth-right">
            <div class="auth-form-wrapper">
                <h3>Quên mật khẩu?</h3>
                <p class="auth-sub">Nhập địa chỉ email của bạn để nhận mã xác thực OTP</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-error-box">
                        <div asp-validation-summary="All" class="text-danger" style="margin:0;"></div>
                    </div>
                }

                <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="input-group">
                        <label asp-for="Email">Địa chỉ Email đăng ký</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Email" placeholder="Ví dụ: yourname@gmail.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-auth">
                        GỬI MÃ OTP <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>

                <p class="auth-footer">
                    Nhớ mật khẩu rồi? <a asp-controller="Auth" asp-action="Login">Quay lại đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</div>
