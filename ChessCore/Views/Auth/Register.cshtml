@model ChessCore.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<div class="auth-page">
    <div class="auth-box">
        <div class="auth-left">
            <div class="auth-brand">
                <i class="fa-solid fa-chess-knight"></i>
                <h2>Cờ Tướng Pro</h2>
            </div>
            <p>Tham gia cộng đồng cờ tướng lớn nhất. Khám phá các thế cờ hay, theo dõi tiến độ và giao lưu cùng kỳ thủ khắp nơi.</p>
        </div>
        <div class="auth-right">
            <div class="auth-form-wrapper">
                <h3>Tạo tài khoản mới</h3>
                <p class="auth-sub">Tham gia hoàn toàn miễn phí ngay hôm nay</p>

                <form asp-controller="Auth" asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger auth-error-box"></div>

                    <div class="input-group">
                        <label asp-for="Username">Tên đăng nhập</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="Username" placeholder="Chọn tên hiển thị của bạn" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="input-group">
                        <label asp-for="Email">Email</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Email" placeholder="Nhập địa chỉ email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="input-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="Password" type="password" id="reg-pwd" placeholder="Tạo mật khẩu (ít nhất 6 ký tự)" />
                            <i class="fa-solid fa-eye toggle-pwd" onclick="togglePassword('reg-pwd', this)"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <ul class="pwd-requirements" id="pwd-reqs">
                        <li id="req-len"><i class="fa-solid fa-circle-xmark"></i> Ít nhất 6 ký tự</li>
                        <li id="req-case"><i class="fa-solid fa-circle-xmark"></i> Chữ hoa và chữ thường</li>
                        <li id="req-num"><i class="fa-solid fa-circle-xmark"></i> Chữ số</li>
                        <li id="req-spec"><i class="fa-solid fa-circle-xmark"></i> Ký tự đặc biệt</li>
                    </ul>

                    <div class="input-group">
                        <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-shield-halved"></i>
                            <input asp-for="ConfirmPassword" type="password" id="reg-confirm-pwd" placeholder="Nhập lại mật khẩu ở trên" />
                            <i class="fa-solid fa-eye toggle-pwd" onclick="togglePassword('reg-confirm-pwd', this)"></i>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-auth">ĐĂNG KÝ <i class="fa-solid fa-user-plus"></i></button>

                    <div class="divider">
                        <span>Hoặc đăng nhập với</span>
                    </div>

                    <a href="javascript:void(0)" class="btn-google" onclick="if(window.AppDialog){AppDialog.alert('Chức năng Đăng nhập bằng Google đang được hoàn thiện và sẽ khả dụng trong phiên bản tiếp theo.', 'Thông báo', 'info');}">
                        <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        Tiếp tục với Google
                    </a>
                </form>

                <p class="auth-footer">Đã có tài khoản? <a asp-controller="Auth" asp-action="Login">Đăng nhập</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, iconElement) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.remove("fa-eye");
                iconElement.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                iconElement.classList.remove("fa-eye-slash");
                iconElement.classList.add("fa-eye");
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const pwdInput = document.getElementById('reg-pwd');
            const confirmPwdInput = document.getElementById('reg-confirm-pwd');

            function setReqState(id, isValid) {
                const req = document.getElementById(id);
                if (!req) return;
                const icon = req.querySelector('i');
                if (isValid) {
                    req.classList.add('valid');
                    icon.className = 'fa-solid fa-circle-check';
                } else {
                    req.classList.remove('valid');
                    icon.className = 'fa-solid fa-circle-xmark';
                }
            }

            function checkMatch() {
                const val1 = pwdInput.value;
                const val2 = confirmPwdInput.value;
                const wrapper = confirmPwdInput.closest('.input-icon-wrapper');
                const icon = wrapper.querySelector('.fa-shield-halved');
                
                if (val2.length > 0 && val1 === val2) {
                    wrapper.style.borderColor = '#10b981';
                    wrapper.style.boxShadow = '0 0 0 3px rgba(16, 185, 129, 0.1)';
                    icon.style.color = '#10b981';
                } else if (val2.length > 0) {
                    wrapper.style.borderColor = '#ef4444';
                    wrapper.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.1)';
                    icon.style.color = '#ef4444';
                } else {
                    wrapper.style.borderColor = 'var(--border-color)';
                    wrapper.style.boxShadow = 'none';
                    icon.style.color = 'var(--text-muted)';
                }
            }

            pwdInput.addEventListener('input', function() {
                const val = this.value;
                setReqState('req-len', val.length >= 6);
                setReqState('req-case', /[a-z]/.test(val) && /[A-Z]/.test(val));
                setReqState('req-num', /\d/.test(val));
                setReqState('req-spec', /[^a-zA-Z0-9]/.test(val));
                checkMatch();
            });

            confirmPwdInput.addEventListener('input', checkMatch);
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}
