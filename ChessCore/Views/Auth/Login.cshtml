@model ChessCore.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page">
    <div class="auth-box">
        <div class="auth-left">
            <div class="auth-brand">
                <i class="fa-solid fa-chess-knight"></i>
                <h2>Cờ Tướng Pro</h2>
            </div>
            <p>Đăng nhập để tham gia các trận đấu hấp dẫn, leo rank và giao lưu với kỳ thủ khắp nơi.</p>
        </div>
        
        <div class="auth-right">
            <div class="auth-form-wrapper">
                <h3>Chào mừng trở lại!</h3>
                <p class="auth-sub">Vui lòng đăng nhập vào tài khoản của bạn</p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div style="background: rgba(16, 185, 129, 0.1); border-left: 4px solid #10b981; padding: 12px 16px; border-radius: 4px; margin-bottom: 20px; color: #10b981; font-size: 14px; font-weight: 500;">
                        <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-error-box">
                        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin:0;"></div>
                    </div>
                }

                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="input-group">
                        <label asp-for="Username">Tên đăng nhập hoặc Email</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="Username" placeholder="Ví dụ: player123" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="input-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="Password" type="password" id="login-pwd" placeholder="Nhập mật khẩu của bạn" />
                            <i class="fa-solid fa-eye toggle-pwd" onclick="togglePassword('login-pwd', this)"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-options">
                        <label class="remember-me">
                            <input asp-for="RememberMe" type="checkbox" /> Ghi nhớ tôi
                        </label>
                        <a asp-action="ForgotPassword" class="forgot-pwd">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn-auth">ĐĂNG NHẬP <i class="fa-solid fa-arrow-right"></i></button>
                    
                    <div class="divider">
                        <span>Hoặc đăng nhập với</span>
                    </div>

                    <a href="javascript:void(0)" class="btn-google" onclick="if(window.AppDialog){AppDialog.alert('Chức năng Đăng nhập bằng Google đang được hoàn thiện và sẽ khả dụng trong phiên bản tiếp theo.', 'Thông báo', 'info');}">
                        <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        Tiếp tục với Google
                    </a>
                </form>

                <p class="auth-footer">Chưa có tài khoản? <a asp-controller="Auth" asp-action="Register">Đăng ký ngay</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, iconElement) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.remove("fa-eye");
                iconElement.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                iconElement.classList.remove("fa-eye-slash");
                iconElement.classList.add("fa-eye");
            }
        }
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}
