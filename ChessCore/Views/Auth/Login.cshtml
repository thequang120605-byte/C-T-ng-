@model ChessCore.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page">
    <div class="auth-box">
        <div class="auth-left">
            <div class="auth-brand">
                <i class="fa-solid fa-chess-knight"></i>
                <h2>Cờ Tướng Pro</h2>
            </div>
            <p>Đăng nhập để tham gia các trận đấu hấp dẫn, leo rank và giao lưu với kỳ thủ khắp nơi.</p>
        </div>
        
        <div class="auth-right">
            <div class="auth-form-wrapper">
                <h3>Chào mừng trở lại!</h3>
                <p class="auth-sub">Vui lòng đăng nhập vào tài khoản của bạn</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-error-box">
                        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin:0;"></div>
                    </div>
                }

                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="input-group">
                        <label asp-for="Username">Tên đăng nhập hoặc Email</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="Username" placeholder="Ví dụ: player123" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="input-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="input-icon-wrapper">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="Password" type="password" id="login-pwd" placeholder="Nhập mật khẩu của bạn" />
                            <i class="fa-solid fa-eye toggle-pwd" onclick="togglePassword('login-pwd', this)"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-options">
                        <label class="remember-me">
                            <input asp-for="RememberMe" type="checkbox" /> Ghi nhớ tôi
                        </label>
                        <a href="#" class="forgot-pwd">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn-auth">ĐĂNG NHẬP <i class="fa-solid fa-arrow-right"></i></button>
                    
                    <div class="divider">
                        <span>Hoặc đăng nhập với</span>
                    </div>

                    <a href="#" class="btn-google" onclick="alert('Chức năng Đăng nhập bằng Google đang được phát triển. Vui lòng cấu hình Google Client ID trong tương lai.')">
                        <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        Tiếp tục với Google
                    </a>
                </form>

                <p class="auth-footer">Chưa có tài khoản? <a asp-controller="Auth" asp-action="Register">Đăng ký ngay</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, iconElement) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.remove("fa-eye");
                iconElement.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                iconElement.classList.remove("fa-eye-slash");
                iconElement.classList.add("fa-eye");
            }
        }
    </script>
}

@section Styles {
    <style>
        .auth-page {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: calc(100vh - 70px);
            padding: 20px;
            background-color: var(--bg-navy);
            background-image: url('https://www.transparenttextures.com/patterns/stardust.png');
        }

        .auth-box {
            display: flex;
            width: 100%;
            max-width: 900px;
            min-height: 500px;
            background: var(--bg-navy-panel);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        .auth-left {
            flex: 1;
            background: linear-gradient(135deg, rgba(201,155,98,0.9), rgba(92,64,51,0.9)), url('https://www.transparenttextures.com/patterns/wood-pattern.png');
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: #fff;
        }

        .auth-brand {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .auth-brand i { font-size: 48px; color: #fff; }
        .auth-brand h2 { font-size: 32px; font-weight: 800; margin: 0; letter-spacing: 1px; }
        .auth-left p { font-size: 16px; line-height: 1.6; opacity: 0.9; }

        .auth-right {
            flex: 1;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: var(--bg-navy-panel);
        }

        .auth-form-wrapper h3 { margin: 0 0 5px 0; color: var(--text-main); font-size: 28px; }
        .auth-sub { color: var(--text-muted); margin-bottom: 30px; font-size: 14px; }

        .input-group { margin-bottom: 20px; }
        .input-group label { display: block; margin-bottom: 8px; color: var(--text-main); font-size: 14px; font-weight: 500; }
        
        .input-icon-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }
        .input-icon-wrapper i:not(.toggle-pwd) {
            position: absolute;
            left: 14px;
            color: var(--text-muted);
            font-size: 14px;
        }
        .toggle-pwd {
            position: absolute;
            right: 14px;
            color: var(--text-muted);
            font-size: 16px;
            cursor: pointer;
            transition: color 0.3s;
        }
        .toggle-pwd:hover {
            color: var(--accent-gold);
        }
        .input-icon-wrapper input {
            width: 100%;
            padding: 12px 40px 12px 40px;
            background: var(--bg-navy-dark);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-main);
            font-size: 15px;
            transition: all 0.3s;
            outline: none;
        }
        .input-icon-wrapper input:focus {
            border-color: var(--accent-gold);
            box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.1);
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }
        .remember-me { color: var(--text-muted); font-size: 13px; display: flex; align-items: center; gap: 6px; cursor: pointer; }
        .forgot-pwd { color: var(--accent-gold-light); font-size: 13px; text-decoration: none; }
        .forgot-pwd:hover { text-decoration: underline; }

        .btn-auth {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--accent-gold), var(--accent-gold-dark));
            color: var(--wood-dark);
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(251, 191, 36, 0.3);
        }

        .auth-footer { margin-top: 25px; text-align: center; color: var(--text-muted); font-size: 14px; }
        .auth-footer a { color: var(--accent-gold-light); font-weight: bold; text-decoration: none; }
        .auth-footer a:hover { text-decoration: underline; }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 25px 0 15px 0;
        }
        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--border-color);
        }
        .divider span {
            padding: 0 10px;
            color: var(--text-muted);
            font-size: 13px;
        }

        .btn-google {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 12px;
            background-color: white;
            color: #333;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
            gap: 10px;
            transition: background 0.2s;
        }
        .btn-google svg {
            width: 20px;
            height: 20px;
        }
        .btn-google:hover {
            background-color: #f1f5f9;
        }

        .text-danger { color: #ef4444; font-size: 12px; margin-top: 5px; display: block; }
        .auth-error-box { background: rgba(239,68,68,0.1); padding: 10px; border-radius: 8px; margin-bottom: 15px; border: 1px solid rgba(239,68,68,0.3); }

        @@media (max-width: 768px) {
            .auth-box { flex-direction: column; }
            .auth-left { padding: 30px 20px; text-align: center; }
            .auth-brand { justify-content: center; }
            .auth-right { padding: 30px 20px; }
        }
    </style>
}
