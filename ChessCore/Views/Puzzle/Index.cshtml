@{
    ViewData["Title"] = "Cờ Thế";
}

<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/puzzle.css" asp-append-version="true" />

<div class="pz-wrap" id="pz-root">

    <!-- ===================== TRANG CHÍNH ===================== -->
    <section id="pz-home">
        <h1 class="pz-title"><i class="fa-solid fa-puzzle-piece"></i> Luyện giải Cờ Thế</h1>
        <p class="pz-sub">Giải liên tiếp các thế cờ từ dễ đến khó. Hoàn thành đủ bài ở mỗi cấp để mở cấp tiếp theo.</p>

        <div id="pz-home-body"><div class="pz-loading"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải dữ liệu...</div></div>
    </section>

    <!-- ===================== MÀN GIẢI BÀI ===================== -->
    <section id="pz-play" class="pz-hidden">
        <div class="pz-layout">
            <div class="board-column">
                <div class="board-wrapper">
                    <div id="chess-board" class="xiangqi-board">
                        <svg id="board-svg" viewBox="0 0 900 1000" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
                            <rect x="0" y="0" width="900" height="1000" class="board-outer-bg" fill="#3E2723" />
                        <rect x="15" y="15" width="870" height="970" class="board-background" fill="#E2C28E" />
                        <rect x="45" y="45" width="810" height="910" class="board-inner-border" fill="none" stroke="#5D4037" stroke-width="4" />
                            <g class="board-lines">
                                <line x1="50" y1="50" x2="850" y2="50" />
                                <line x1="50" y1="150" x2="850" y2="150" />
                                <line x1="50" y1="250" x2="850" y2="250" />
                                <line x1="50" y1="350" x2="850" y2="350" />
                                <line x1="50" y1="450" x2="850" y2="450" />
                                <line x1="50" y1="550" x2="850" y2="550" />
                                <line x1="50" y1="650" x2="850" y2="650" />
                                <line x1="50" y1="750" x2="850" y2="750" />
                                <line x1="50" y1="850" x2="850" y2="850" />
                                <line x1="50" y1="950" x2="850" y2="950" />
                                <line x1="50" y1="50" x2="50" y2="950" />
                                <line x1="850" y1="50" x2="850" y2="950" />
                                <line x1="150" y1="50" x2="150" y2="450" /><line x1="150" y1="550" x2="150" y2="950" />
                                <line x1="250" y1="50" x2="250" y2="450" /><line x1="250" y1="550" x2="250" y2="950" />
                                <line x1="350" y1="50" x2="350" y2="450" /><line x1="350" y1="550" x2="350" y2="950" />
                                <line x1="450" y1="50" x2="450" y2="450" /><line x1="450" y1="550" x2="450" y2="950" />
                                <line x1="550" y1="50" x2="550" y2="450" /><line x1="550" y1="550" x2="550" y2="950" />
                                <line x1="650" y1="50" x2="650" y2="450" /><line x1="650" y1="550" x2="650" y2="950" />
                                <line x1="750" y1="50" x2="750" y2="450" /><line x1="750" y1="550" x2="750" y2="950" />
                            </g>
                            <g class="river-text">
                                <text x="250" y="520" text-anchor="middle">楚 河</text>
                                <text x="650" y="520" text-anchor="middle">漢 界</text>
                            </g>
                            <g class="palace-lines">
                                <line x1="350" y1="50" x2="550" y2="250" />
                                <line x1="550" y1="50" x2="350" y2="250" />
                            </g>
                            <g class="palace-lines">
                                <line x1="350" y1="750" x2="550" y2="950" />
                                <line x1="550" y1="750" x2="350" y2="950" />
                            </g>
                            <g id="moves-layer"></g>
                            <g id="pieces-layer"></g>
                            <g id="hint-layer"></g>
                        </svg>
                    </div>
                </div>
            </div>

            <aside class="pz-panel">
                <div class="pz-card">
                    <div class="pz-badge" id="pz-badge"></div>
                    <h2 class="pz-puzzle-title" id="pz-puzzle-title"></h2>
                    <p class="pz-goal" id="pz-goal"></p>
                    <div class="pz-bar"><span id="pz-level-bar" style="width:0%"></span></div>
                    <div class="pz-verified" id="pz-level-text" style="margin-top:6px"></div>
                </div>

                <div class="pz-msg info" id="pz-msg">Hãy chọn quân cờ để đi.</div>

                <div class="pz-nav-row" style="display: flex; gap: 8px; margin-top: 4px;">
                    <button type="button" class="pz-btn pz-btn-secondary" id="pz-prev-puzzle" title="Bài trước" style="flex: 1; padding: 8px 12px; font-size: 13px;">
                        <i class="fa-solid fa-backward-step"></i> Bài trước
                    </button>
                    <button type="button" class="pz-btn pz-btn-secondary" id="pz-select-puzzle" title="Danh sách các bài" style="padding: 8px 14px; font-size: 13px;">
                        <i class="fa-solid fa-list-check"></i> Chọn bài
                    </button>
                    <button type="button" class="pz-btn pz-btn-secondary" id="pz-skip-puzzle" title="Bài kế tiếp" style="flex: 1; padding: 8px 12px; font-size: 13px;">
                        Bài sau <i class="fa-solid fa-forward-step"></i>
                    </button>
                </div>

                <div class="pz-actions">
                    <button type="button" class="pz-btn pz-btn-primary pz-btn-block pz-hidden" id="pz-next">Chơi tiếp</button>
                    <button type="button" class="pz-btn pz-btn-danger pz-btn-block pz-hidden" id="pz-retry">Thử lại</button>
                    <div class="pz-hint-group" style="position: relative; width: 100%;">
                        <button type="button" class="pz-btn pz-btn-secondary pz-btn-block" id="pz-hint">
                            <i class="fa-solid fa-lightbulb" style="color: var(--accent-gold);"></i> Gợi ý
                        </button>
                        <div id="pz-hint-dropdown" class="hint-dropdown-menu hidden" style="width: 100%; bottom: 100%; left: 0; transform: translateY(-8px);">
                            <button id="pz-hint-piece-btn" type="button" class="hint-dropdown-item" title="Chỉ highlight quân cờ cần đi">
                                <i class="fa-solid fa-chess-knight" style="color: #38bdf8; font-size: 16px;"></i>
                                <div>
                                    <span>Gợi ý quân cờ</span>
                                    <small>Chỉ highlight quân cần đi</small>
                                </div>
                            </button>
                            <button id="pz-hint-move-btn" type="button" class="hint-dropdown-item" title="Highlight quân cờ và vẽ nước đi">
                                <i class="fa-solid fa-location-arrow" style="color: #f59e0b; font-size: 16px;"></i>
                                <div>
                                    <span>Gợi ý có nước đi</span>
                                    <small>Vẽ đường đi và ô đích</small>
                                </div>
                            </button>
                        </div>
                    </div>
                    <button type="button" class="pz-btn pz-btn-secondary pz-btn-block" id="pz-exit">
                        <i class="fa-solid fa-arrow-left"></i> Về danh sách cấp độ
                    </button>
                </div>
            </aside>
        </div>

        <!-- MODAL CHỌN BÀI TRONG CẤP ĐỘ -->
        <div id="pz-modal-puzzles" class="modal-overlay hidden" style="position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 9999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
            <div class="pz-card" style="width: 90%; max-width: 550px; max-height: 80vh; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 10px 40px rgba(0,0,0,0.6);">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
                    <h3 id="pz-modal-level-title" style="margin: 0; color: var(--accent-gold); font-size: 18px;"><i class="fa-solid fa-list-ol"></i> Danh sách bài thế</h3>
                    <button id="pz-modal-close" type="button" class="btn-secondary" style="background: none; border: none; font-size: 20px; color: var(--text-muted); cursor: pointer;">&times;</button>
                </div>
                <div id="pz-modal-grid" class="pz-puzzle-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); gap: 10px; overflow-y: auto; padding: 6px; max-height: 50vh;">
                    <!-- Sẽ render các nút bài 1, 2, 3... tại đây -->
                </div>
                <div style="text-align: right; border-top: 1px solid var(--border-color); padding-top: 10px;">
                    <button id="pz-modal-close-btn" type="button" class="pz-btn pz-btn-secondary" style="padding: 6px 16px; font-size: 13px;">Đóng</button>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================== TỔNG KẾT CẤP ĐỘ ===================== -->
    <section id="pz-summary" class="pz-hidden">
        <div class="pz-card pz-summary" id="pz-summary-body"></div>
    </section>
</div>

@section Scripts {
    <script src="~/js/puzzle.js" asp-append-version="true"></script>
}