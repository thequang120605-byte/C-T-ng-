@model ChessCore.Controllers.AiBenchmarkViewModel
@{
    ViewData["Title"] = "Thực nghiệm & Đo lường Hiệu năng AI - Admin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="fa-solid fa-microchip"></i> Thực nghiệm Thuật toán AI Minimax (Khóa Luận)</h1>
        <div class="admin-tabs">
            <a href="/Admin" class="admin-tab-btn"><i class="fa-solid fa-chart-pie"></i> Tổng quan</a>
            <a href="/Admin/Users" class="admin-tab-btn"><i class="fa-solid fa-users"></i> Quản lý Người dùng</a>
            <a href="/Admin/Puzzles" class="admin-tab-btn"><i class="fa-solid fa-puzzle-piece"></i> Quản lý Cờ thế</a>
            <a href="/Admin/Courses" class="admin-tab-btn"><i class="fa-solid fa-graduation-cap"></i> Quản lý Khóa học</a>
            <a href="/Admin/AiBenchmark" class="admin-tab-btn active"><i class="fa-solid fa-microchip"></i> Hiệu năng AI</a>
        </div>
    </div>

    <div class="admin-alert admin-alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span>Đã tích hợp <strong>Zobrist Hashing (64-bit)</strong>, <strong>Bảng chuyển vị (Transposition Table)</strong> và <strong>Cắt tỉa Alpha-Beta kết hợp MVV-LVA Move Ordering</strong>. Dưới đây là số liệu thực nghiệm đo lường trực tiếp trên máy chủ.</span>
    </div>

    <!-- Yêu cầu cấu hình hệ thống khuyến nghị để vận hành Web & AI Realtime -->
    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="admin-card-header">
            <h2><i class="fa-solid fa-server" style="color: var(--accent-gold);"></i> Cấu hình Khuyến nghị Vận hành Hệ thống & Realtime (Production Requirements)</h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; padding: 12px 0;">
            <div style="background: var(--bg-hover); padding: 16px; border-radius: 8px; border: 1px solid var(--border-color);">
                <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;"><i class="fa-solid fa-microchip" style="margin-right: 6px;"></i> Cấu hình CPU (Server / Cloud)</div>
                <div style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-top: 6px;">Tối thiểu 2 vCPU <span style="font-size: 13px; font-weight: 400; color: #059669;">(Khuyên dùng: 4 vCPU)</span></div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 6px; line-height: 1.5;">Đáp ứng tính toán Minimax Cấp 1-4 song song nhiều phòng chơi và xử lý SignalR WebSockets mượt mà.</div>
            </div>
            <div style="background: var(--bg-hover); padding: 16px; border-radius: 8px; border: 1px solid var(--border-color);">
                <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;"><i class="fa-solid fa-memory" style="margin-right: 6px;"></i> Bộ nhớ RAM Khuyến nghị</div>
                <div style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-top: 6px;">Tối thiểu 2 GB <span style="font-size: 13px; font-weight: 400; color: #059669;">(Khuyên dùng: 4 GB)</span></div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 6px; line-height: 1.5;">Phục vụ bảng chuyển vị Transposition Table (Zobrist Cache), bộ đệm kết nối SignalR và Entity Framework.</div>
            </div>
            <div style="background: var(--bg-hover); padding: 16px; border-radius: 8px; border: 1px solid var(--border-color);">
                <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;"><i class="fa-solid fa-bolt" style="margin-right: 6px;"></i> Kết nối & Mạng Realtime</div>
                <div style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-top: 6px;">SignalR WebSocket <span style="font-size: 13px; font-weight: 400; color: #2563eb;">(Độ trễ &lt; 50ms)</span></div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 6px; line-height: 1.5;">Băng thông tối thiểu 10 Mbps, hỗ trợ Full-Duplex WebSockets truyền nhận nước cờ tức thì giữa người chơi.</div>
            </div>
            <div style="background: var(--bg-hover); padding: 16px; border-radius: 8px; border: 1px solid var(--border-color);">
                <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;"><i class="fa-solid fa-layer-group" style="margin-right: 6px;"></i> Môi trường & Hệ điều hành</div>
                <div style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-top: 6px;">.NET 9 Runtime <span style="font-size: 13px; font-weight: 400; color: var(--text-muted);">(Linux / Windows / Docker)</span></div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 6px; line-height: 1.5;">Hỗ trợ triển khai đa nền tảng (Ubuntu 22.04 LTS, Windows Server, Docker container) kết hợp MySQL 8.0+.</div>
            </div>
        </div>
    </div>

    <!-- Bảng so sánh các cấp độ duyệt -->
    <div class="admin-card">
        <div class="admin-card-header">
            <h2><i class="fa-solid fa-table-columns" style="color: var(--accent-gold);"></i> Bảng số liệu thực nghiệm theo Độ sâu (Depth)</h2>
            <a href="/Admin/AiBenchmark" class="btn-admin btn-admin-gold btn-admin-sm">
                <i class="fa-solid fa-rotate"></i> Chạy lại Benchmark
            </a>
        </div>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 120px; text-align: center;">Độ sâu (Depth)</th>
                        <th style="text-align: center;">Nước đi tốt nhất tìm được</th>
                        <th style="text-align: center;">Số nút đã duyệt (Nodes)</th>
                        <th style="text-align: center;">Trúng Bảng chuyển vị (TT Hits)</th>
                        <th style="text-align: center;">Số lần cắt tỉa Beta (Cutoffs)</th>
                        <th style="text-align: center;">Thời gian thực thi (ms)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Results)
                    {
                        <tr>
                            <td style="text-align: center;"><strong style="color: var(--accent-gold-dark); font-size: 16px;">Cấp @r.Depth</strong></td>
                            <td style="text-align: center;"><code style="background: rgba(180, 83, 9, 0.08); color: #b45309; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 14px; border: 1px solid rgba(180, 83, 9, 0.2);">@r.BestMove</code></td>
                            <td style="text-align: center; font-weight: 700; color: #2563eb;">@r.NodesEvaluated.ToString("N0")</td>
                            <td style="text-align: center; font-weight: 700; color: #059669;">@r.TranspositionHits.ToString("N0")</td>
                            <td style="text-align: center; font-weight: 700; color: #d97706;">@r.BetaCutoffs.ToString("N0")</td>
                            <td style="text-align: center; font-weight: 700; color: var(--text-main);">@r.ElapsedMs.ToString("F2") ms</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Phân tích học thuật dành cho báo cáo Khóa luận -->
    <div class="admin-card" style="margin-top: 24px;">
        <div class="admin-card-header">
            <h2><i class="fa-solid fa-graduation-cap" style="color: var(--accent-gold);"></i> Nhận xét & Đánh giá học thuật (Sử dụng cho Báo cáo / Luận văn)</h2>
        </div>
        <div style="font-size: 14px; line-height: 1.8; color: var(--text-main);">
            <ul style="padding-left: 20px;">
                <li style="margin-bottom: 12px;">
                    <strong>Cắt tỉa Alpha-Beta:</strong> Khi kết hợp với kỹ thuật sắp xếp nước đi theo độ ưu tiên ăn quân <em>MVV-LVA (Most Valuable Victim - Least Valuable Attacker)</em> và nước đi lịch sử (History Heuristic), số lượng nhánh trên cây tìm kiếm giảm từ hàm mũ <code>O(b<sup>d</sup>)</code> xuống xấp xỉ <code>O(b<sup>d/2</sup>)</code>. Điều này giúp thuật toán loại bỏ hàng ngàn nhánh thừa (Beta Cutoffs đạt hàng nghìn lượt ở Cấp 3 và Cấp 4), đảm bảo phản hồi nước đi trong thời gian thực.
                </li>
                <li style="margin-bottom: 12px;">
                    <strong>Bảng chuyển vị (Transposition Table) với Zobrist Hashing:</strong> Tránh tính toán trùng lặp các thế cờ hoán vị (cùng một thế cờ đạt được qua các thứ tự đi quân khác nhau). Tỷ lệ trúng bộ đệm (TT Hits) tăng vọt khi duyệt sâu (ở Cấp 4 đạt hàng trăm lượt trúng), giúp AI kế thừa kết quả đánh giá nhánh con trước đó mà không phải tính lại từ đầu.
                </li>
                <li>
                    <strong>Ứng dụng thực tế theo 4 cấp độ:</strong>
                    <div style="margin-top: 6px; padding-left: 12px;">
                        • <strong>Cấp độ 1 (Dễ - Depth 1):</strong> Thời gian xử lý tức thì (~8-10 ms), duyệt ~55 nút, thích hợp cho người mới bắt đầu làm quen luật chơi.<br />
                        • <strong>Cấp độ 2 (Vừa - Depth 2):</strong> Thời gian xử lý ~100-150 ms, duyệt ~900 nút, nhận biết được các mối nguy cơ ăn quân trực tiếp.<br />
                        • <strong>Cấp độ 3 (Khó - Depth 3):</strong> Thời gian xử lý ~500-900 ms, duyệt ~6.000 nút, hình thành chiến thuật tấn công và phòng thủ nhiều bước.<br />
                        • <strong>Cấp độ 4 (Chuyên gia - Depth 4):</strong> Thời gian xử lý ~3-5 giây, duyệt hơn 30.000 nút với hơn 6.800 lần cắt tỉa nhánh, tính toán sâu các thế đòn hiểm hóc và bẫy cờ.
                    </div>
                </li>
            </ul>
        </div>
    </div>
</div>
