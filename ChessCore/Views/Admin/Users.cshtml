@model List<ChessCore.Controllers.AdminUserOverviewDto>
@{
    ViewData["Title"] = "Quản lý Người dùng - Admin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        .user-search-box {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .user-search-input {
            flex: 1;
            min-width: 250px;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid var(--border-color, #e2e8f0);
            background: var(--bg-navy-dark, #f1f5f9);
            color: var(--text-main, #0f172a);
            font-size: 14px;
            transition: all 0.2s ease;
        }
        .user-search-input:focus {
            outline: 2px solid rgba(217, 119, 6, 0.2);
            border-color: var(--accent-gold, #d97706);
            background: #ffffff;
        }
        .pagination-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid var(--border-color, #e2e8f0);
            flex-wrap: wrap;
            gap: 10px;
        }
        .pagination-info {
            font-size: 13px;
            color: var(--text-muted, #64748b);
        }
        .pagination-controls {
            display: flex;
            gap: 6px;
            align-items: center;
        }
        .page-btn {
            background: var(--bg-navy-panel, #ffffff);
            border: 1px solid var(--border-color, #e2e8f0);
            color: var(--text-main, #0f172a);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .page-btn:hover:not(:disabled) {
            border-color: var(--accent-gold, #d97706);
            background: var(--bg-navy-light, #e2e8f0);
            color: var(--accent-gold-dark, #b45309);
        }
        .page-btn.active {
            background: var(--accent-gold, #d97706);
            color: #ffffff;
            border-color: var(--accent-gold, #d97706);
        }
        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
        .user-elo-tier {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            white-space: nowrap;
        }
        .user-elo-val {
            font-size: 13px;
            font-weight: 800;
            color: var(--accent-gold, #d97706);
            display: inline-flex;
            align-items: center;
            gap: 3px;
            white-space: nowrap;
        }
        .badge-current-admin {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 11.5px;
            font-weight: 700;
            background: rgba(217, 119, 6, 0.12);
            color: var(--accent-gold-dark, #b45309);
            border: 1px dashed rgba(217, 119, 6, 0.45);
            white-space: nowrap;
        }
    </style>
}

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="fa-solid fa-users"></i> Quản lý Người dùng</h1>
        <div class="admin-tabs">
            <a href="/Admin" class="admin-tab-btn"><i class="fa-solid fa-chart-pie"></i> Tổng quan</a>
            <a href="/Admin/Users" class="admin-tab-btn active"><i class="fa-solid fa-users"></i> Quản lý Người dùng</a>
            <a href="/Admin/Puzzles" class="admin-tab-btn"><i class="fa-solid fa-puzzle-piece"></i> Quản lý Cờ thế</a>
            <a href="/Admin/Courses" class="admin-tab-btn"><i class="fa-solid fa-graduation-cap"></i> Quản lý Khóa học</a>
            <a href="/Admin/AiBenchmark" class="admin-tab-btn"><i class="fa-solid fa-microchip"></i> Hiệu năng AI</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alert admin-alert-danger">
            <i class="fa-solid fa-triangle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-card">
        <div class="admin-card-header">
            <h2>
                <i class="fa-solid fa-ranking-star" style="color: #facc15;"></i>
                Danh sách Tất cả Thành viên (@Model.Count)
            </h2>
            <div style="font-size: 13px; color: var(--text-muted); font-weight: 500;">
                <i class="fa-solid fa-arrow-down-wide-short" style="color: var(--accent-gold);"></i> Xếp hạng theo Elo từ cao xuống thấp
            </div>
        </div>

        <div class="user-search-box">
            <input type="text" id="user-search" class="user-search-input" placeholder="🔍 Tìm kiếm theo Tên kỳ thủ, Email hoặc Mã ID (CT-xxxxx)..." oninput="filterUsers();" />
            <select id="user-role-filter" class="user-search-input" onchange="filterUsers();" style="flex: 0 0 180px; min-width: 160px; cursor: pointer;">
                <option value="all">Tất cả vai trò</option>
                <option value="admin">Quản trị viên (Admin)</option>
                <option value="player">Kỳ thủ (Player)</option>
            </select>
        </div>

        <div class="admin-table-wrapper" style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 44px; text-align: center; white-space: nowrap;">Hạng</th>
                        <th>Kỳ thủ</th>
                        <th style="width: 175px; white-space: nowrap;">Kỳ lực & Elo</th>
                        <th style="width: 65px; text-align: center; white-space: nowrap;">Tổng ván</th>
                        <th style="width: 125px; text-align: center; white-space: nowrap;">Thắng - Hòa - Thua</th>
                        <th style="width: 105px; white-space: nowrap;">Tỉ lệ thắng</th>
                        <th style="width: 95px; text-align: center; white-space: nowrap;">Cờ thế đã giải</th>
                        <th style="width: 70px; text-align: center; white-space: nowrap;">Khóa học</th>
                        <th style="width: 75px; text-align: center; white-space: nowrap;">Vai trò</th>
                        <th style="text-align: right; width: 150px; white-space: nowrap;">Hành động</th>
                    </tr>
                </thead>
                <tbody id="user-table-body">
                    @{
                        int rank = 1;
                        int userIndex = 0;
                    }
                    @foreach (var u in Model)
                    {
                        var isCurrentAdmin = string.Equals(u.Username, User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
                        var medalClass = rank == 1 ? "gold" : (rank == 2 ? "silver" : (rank == 3 ? "bronze" : "normal"));
                        var tierClass = u.Elo >= 1500 ? "tier-grandmaster" : (u.Elo >= 1400 ? "tier-master" : (u.Elo >= 1250 ? "tier-expert" : (u.Elo >= 1150 ? "tier-amateur" : "tier-novice")));
                        var winRateColor = u.WinRate >= 60 ? "#10b981" : (u.WinRate >= 45 ? "#d97706" : "#ef4444");
                        var winRatePercentStr = u.WinRate.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                        var winRateWidthStr = Math.Min(100.0, Math.Max(0.0, u.WinRate)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

                        <tr class="user-row" data-index="@userIndex" data-search="@u.Username.ToLower() @u.Email.ToLower() @u.PlayerId.ToLower()" data-role="@(u.Role?.ToLower() ?? "player")">
                            <td style="text-align: center;">
                                <span class="rank-medal @medalClass">
                                    @(rank <= 3 ? (rank == 1 ? "🥇" : (rank == 2 ? "🥈" : "🥉")) : $"#{rank}")
                                </span>
                            </td>
                            <td>
                                <div>
                                    <strong style="color: var(--text-main, #0f172a); font-size: 13.5px;">@u.Username</strong>
                                    @if (u.IsLocked)
                                    {
                                        <span style="background: rgba(239, 68, 68, 0.15); color: #dc2626; font-size: 10px; font-weight: 700; padding: 2px 5px; border-radius: 4px; margin-left: 4px;">
                                            <i class="fa-solid fa-lock"></i> KHÓA
                                        </span>
                                    }
                                    <div style="font-size: 11px; color: var(--text-muted, #64748b); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px;">
                                        @u.Email <span style="opacity: 0.5;">|</span> Mã: <code style="color: var(--accent-gold-dark, #b45309); font-weight: 700;">@u.PlayerId</code>
                                    </div>
                                </div>
                            </td>
                            <td style="white-space: nowrap;">
                                <div class="user-elo-tier">
                                    <span class="tier-badge @tierClass">@u.Title</span>
                                    <span class="user-elo-val">
                                        <i class="fa-solid fa-star" style="font-size: 11px;"></i> @u.Elo
                                    </span>
                                </div>
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <strong style="font-size: 13.5px; color: var(--text-main, #0f172a);">@u.GamesPlayed</strong>
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <span class="stat-wdl-pill">
                                    <span class="wdl-w"><i class="fa-solid fa-check"></i> @u.Wins</span> - 
                                    <span class="wdl-d">@u.Draws</span> - 
                                    <span class="wdl-l"><i class="fa-solid fa-xmark"></i> @u.Losses</span>
                                </span>
                            </td>
                            <td style="white-space: nowrap;">
                                <div class="winrate-bar-container">
                                    <div class="winrate-bar-bg">
                                        <div class="winrate-bar-fill" style="width: @(winRateWidthStr)%; background-color: @winRateColor;"></div>
                                    </div>
                                    <strong style="color: @winRateColor; font-size: 12.5px; min-width: 40px; text-align: right;">@(winRatePercentStr)%</strong>
                                </div>
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <strong style="color: #0284c7;">@u.PuzzleScore</strong> <span style="font-size: 11px; color: var(--text-muted, #64748b);">(@u.PuzzlesSolved bài)</span>
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <strong style="color: #9333ea;">@u.LessonsCompleted / 19</strong>
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <span class="role-badge @(u.Role?.ToLower() == "admin" ? "admin" : "player")">
                                    @(u.Role ?? "Player")
                                </span>
                            </td>
                            <td style="text-align: right; width: 150px; white-space: nowrap;">
                                <div style="display: inline-flex; gap: 4px; align-items: center; justify-content: flex-end; white-space: nowrap;">
                                    @if (isCurrentAdmin)
                                    {
                                        <span class="badge-current-admin" title="Tài khoản Quản trị viên của bạn đang đăng nhập">
                                            <i class="fa-solid fa-user-shield"></i> Bạn (Đang đăng nhập)
                                        </span>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin" asp-action="ToggleAdminRole" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn @(u.Role == "Admin" ? "HẠ QUYỀN Admin của" : "CẤP QUYỀN Admin cho") tài khoản @u.Username?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="btn-admin btn-admin-sm @(u.Role == "Admin" ? "btn-admin-danger" : "btn-admin-primary")" title="@(u.Role == "Admin" ? "Hạ quyền xuống Player" : "Nâng cấp lên Admin")">
                                                @(u.Role == "Admin" ? "Hạ quyền" : "Cấp Admin")
                                            </button>
                                        </form>

                                        <form asp-controller="Admin" asp-action="ToggleLockUser" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc muốn @(u.IsLocked ? "mở khóa" : "khóa") tài khoản @u.Username?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="btn-admin @(u.IsLocked ? "btn-admin-success" : "btn-admin-warning") btn-admin-sm" title="@(u.IsLocked ? "Mở khóa tài khoản" : "Khóa tài khoản")">
                                                <i class="fa-solid @(u.IsLocked ? "fa-lock-open" : "fa-lock")"></i> @(u.IsLocked ? "Mở" : "Khóa")
                                            </button>
                                        </form>

                                        }
                                </div>
                            </td>
                        </tr>
                        rank++;
                        userIndex++;
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-wrapper" id="users-pagination">
            <div class="pagination-info" id="users-pagination-info"></div>
            <div class="pagination-controls" id="users-pagination-controls"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const pageSize = 10;
        let currentPage = 1;
        let visibleRows = [];

        function initRows() {
            visibleRows = Array.from(document.querySelectorAll('.user-row'));
            renderUsersPage(1);
        }

        function filterUsers() {
            const query = (document.getElementById('user-search')?.value || '').toLowerCase().trim();
            const roleFilter = (document.getElementById('user-role-filter')?.value || 'all').toLowerCase();
            const allRows = Array.from(document.querySelectorAll('.user-row'));

            visibleRows = allRows.filter(r => {
                const matchesSearch = !query || r.dataset.search.includes(query);
                const matchesRole = roleFilter === 'all' || r.dataset.role === roleFilter;
                return matchesSearch && matchesRole;
            });
            renderUsersPage(1);
        }

        function renderUsersPage(page) {
            currentPage = page;
            const totalItems = visibleRows.length;
            const totalPages = Math.ceil(totalItems / pageSize) || 1;
            const start = (page - 1) * pageSize;
            const end = Math.min(start + pageSize, totalItems);

            document.querySelectorAll('.user-row').forEach(r => r.style.display = 'none');
            visibleRows.forEach((r, idx) => {
                if (idx >= start && idx < end) {
                    r.style.display = '';
                }
            });

            const infoEl = document.getElementById('users-pagination-info');
            if (infoEl) {
                infoEl.textContent = totalItems === 0 
                    ? 'Không tìm thấy kỳ thủ phù hợp' 
                    : `Hiển thị ${start + 1} - ${end} / tổng số ${totalItems} kỳ thủ`;
            }

            renderUsersControls(totalPages);
        }

        function renderUsersControls(totalPages) {
            const controlsEl = document.getElementById('users-pagination-controls');
            if (!controlsEl) return;
            controlsEl.innerHTML = '';

            if (totalPages <= 1) return;

            const prevBtn = document.createElement('button');
            prevBtn.type = 'button';
            prevBtn.className = 'page-btn';
            prevBtn.innerHTML = '<i class="fa-solid fa-angle-left"></i>';
            prevBtn.disabled = currentPage === 1;
            prevBtn.onclick = () => renderUsersPage(currentPage - 1);
            controlsEl.appendChild(prevBtn);

            for (let p = 1; p <= totalPages; p++) {
                const pBtn = document.createElement('button');
                pBtn.type = 'button';
                pBtn.className = 'page-btn' + (p === currentPage ? ' active' : '');
                pBtn.textContent = p;
                pBtn.onclick = () => renderUsersPage(p);
                controlsEl.appendChild(pBtn);
            }

            const nextBtn = document.createElement('button');
            nextBtn.type = 'button';
            nextBtn.className = 'page-btn';
            nextBtn.innerHTML = '<i class="fa-solid fa-angle-right"></i>';
            nextBtn.disabled = currentPage === totalPages;
            nextBtn.onclick = () => renderUsersPage(currentPage + 1);
            controlsEl.appendChild(nextBtn);
        }

        document.addEventListener('DOMContentLoaded', initRows);
    </script>
}
