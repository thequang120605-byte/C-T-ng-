@model ChessCore.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "Quản trị hệ thống - Tổng quan";
    var usersJson = System.Text.Json.JsonSerializer.Serialize(Model.AllUsers);
    var modeStatsJson = System.Text.Json.JsonSerializer.Serialize(Model.ModeStats);
    var avgWinRateJson = System.Text.Json.JsonSerializer.Serialize(Model.AverageSystemWinRate);
    var topUser = Model.AllUsers.OrderByDescending(u => u.Elo).FirstOrDefault();
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        .admin-kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 14px;
            margin-bottom: 24px;
        }
        .admin-kpi-card {
            background: var(--bg-navy-panel, #ffffff);
            border: 1px solid var(--border-color, #e2e8f0);
            border-radius: 12px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .admin-kpi-card:hover {
            transform: translateY(-2px);
            border-color: var(--accent-gold, #d97706);
            box-shadow: 0 8px 16px -2px rgba(0, 0, 0, 0.08);
        }
        .admin-kpi-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
        .admin-kpi-info {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }
        .admin-kpi-val {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-main, #0f172a);
            line-height: 1.2;
        }
        .admin-kpi-lbl {
            font-size: 12px;
            color: var(--text-muted, #64748b);
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .charts-row-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }

        .rank-medal {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            font-weight: 800;
            font-size: 13px;
        }
        .rank-medal.gold { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; box-shadow: 0 0 10px rgba(245, 158, 11, 0.4); }
        .rank-medal.silver { background: linear-gradient(135deg, #94a3b8, #64748b); color: #fff; }
        .rank-medal.bronze { background: linear-gradient(135deg, #b45309, #78350f); color: #fff; }
        .rank-medal.normal { background: var(--bg-navy-light, #e2e8f0); color: var(--text-muted, #64748b); }

        .tier-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
        }
        .tier-grandmaster { background: rgba(239, 68, 68, 0.12); color: #dc2626; border: 1px solid rgba(239, 68, 68, 0.3); }
        .tier-master { background: rgba(245, 158, 11, 0.12); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.3); }
        .tier-expert { background: rgba(59, 130, 246, 0.12); color: #2563eb; border: 1px solid rgba(59, 130, 246, 0.3); }
        .tier-amateur { background: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.3); }
        .tier-novice { background: rgba(100, 116, 139, 0.12); color: #475569; border: 1px solid rgba(100, 116, 139, 0.3); }

        .winrate-bar-container {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 110px;
        }
        .winrate-bar-bg {
            flex: 1;
            height: 6px;
            background: var(--bg-navy-light, #e2e8f0);
            border-radius: 3px;
            overflow: hidden;
        }
        .winrate-bar-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.4s ease;
        }
        .stat-wdl-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            font-weight: 600;
        }
        .wdl-w { color: #10b981; }
        .wdl-d { color: #d97706; }
        .wdl-l { color: #ef4444; }
    </style>
}

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="fa-solid fa-gauge-high"></i> Bảng điều khiển Quản trị viên (Admin Dashboard)</h1>
        <div class="admin-tabs">
            <a href="/Admin" class="admin-tab-btn active"><i class="fa-solid fa-chart-pie"></i> Tổng quan</a>
            <a href="/Admin/Users" class="admin-tab-btn"><i class="fa-solid fa-users"></i> Quản lý Người dùng</a>
            <a href="/Admin/Puzzles" class="admin-tab-btn"><i class="fa-solid fa-puzzle-piece"></i> Quản lý Cờ thế</a>
            <a href="/Admin/Courses" class="admin-tab-btn"><i class="fa-solid fa-graduation-cap"></i> Quản lý Khóa học</a>
            <a href="/Admin/AiBenchmark" class="admin-tab-btn"><i class="fa-solid fa-microchip"></i> Hiệu năng AI</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alert admin-alert-danger">
            <i class="fa-solid fa-triangle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- 1. DÀN THẺ KPI CHỈ SỐ HỆ THỐNG TOÀN DIỆN -->
    <div class="admin-kpi-grid">
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(59, 130, 246, 0.12); color: #2563eb;">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalUsers</span>
                <span class="admin-kpi-lbl">Tổng số Kỳ thủ</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(217, 119, 6, 0.12); color: #d97706;">
                <i class="fa-solid fa-chess-board"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalGames</span>
                <span class="admin-kpi-lbl">Ván cờ đã khởi tạo</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(16, 185, 129, 0.12); color: #059669;">
                <i class="fa-solid fa-puzzle-piece"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalPuzzles</span>
                <span class="admin-kpi-lbl">Thế cờ trong kho</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(168, 85, 247, 0.12); color: #9333ea;">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalLessons</span>
                <span class="admin-kpi-lbl">Bài học (@Model.TotalModules Modules)</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(239, 68, 68, 0.12); color: #dc2626;">
                <i class="fa-solid fa-bolt"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalMoves.ToString("N0")</span>
                <span class="admin-kpi-lbl">Nước đi lưu trữ</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(14, 165, 233, 0.12); color: #0284c7;">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.AverageSystemWinRate.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%</span>
                <span class="admin-kpi-lbl">Tỉ lệ Thắng TB Kỳ thủ</span>
            </div>
        </div>
    </div>

    <!-- 2. BẢNG THỐNG KÊ THEO CHẾ ĐỘ CHƠI (FORMAT DASHBOARD CHUẨN MỰC) -->
    <div class="panel-box" style="margin-bottom: 24px; padding: 22px 24px; background: var(--bg-navy-panel); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 14px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(217, 119, 6, 0.12); color: var(--accent-gold); display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fa-solid fa-list-check"></i>
                </div>
                <div>
                    <h2 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-main);">Thống kê ván đấu theo chế độ (Toàn hệ thống)</h2>
                    <span style="font-size: 12.5px; color: var(--text-muted);">Chi tiết số lượng ván đấu, trạng thái và kết quả trên toàn bộ nền tảng cờ tướng</span>
                </div>
            </div>
            <a href="/Dashboard/Export" style="padding: 9px 18px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); color: #2563eb; border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s;">
                <i class="fa-solid fa-file-arrow-down"></i> Tải báo cáo CSV
            </a>
        </div>

        <div style="overflow-x: auto; border: 1px solid var(--border-color); border-radius: 10px; background: var(--bg-navy-dark);">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                <thead>
                    <tr style="background: var(--bg-navy-panel); border-bottom: 2px solid var(--border-color); color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                        <th style="padding: 12px 18px; font-weight: 700;">Chế độ thi đấu</th>
                        <th style="padding: 12px 14px; text-align: center;">Đã tạo</th>
                        <th style="padding: 12px 14px; text-align: center;">Đang chơi</th>
                        <th style="padding: 12px 14px; text-align: center;">Chờ đấu</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-main);">Kết thúc</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: #10b981;">Thắng</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: #ef4444;">Thua</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: #d97706;">Hòa</th>
                        <th style="padding: 12px 18px; text-align: right; font-weight: 800; color: var(--accent-gold);">Tỉ lệ thắng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ModeStats != null && Model.ModeStats.Any())
                    {
                        foreach (var r in Model.ModeStats)
                        {
                            <tr style="border-bottom: 1px solid var(--border-color);">
                                <td style="padding: 12px 18px; font-weight: 700; color: var(--text-main);">
                                    @if (r.Mode == "Online") { <i class="fa-solid fa-earth-americas" style="color: #3b82f6; margin-right: 8px;" title="Online"></i> }
                                    else if (r.Mode == "PvE") { <i class="fa-solid fa-robot" style="color: #10b981; margin-right: 8px;" title="Chơi với máy"></i> }
                                    else if (r.Mode == "PvP" || r.Mode == "Local") { <i class="fa-solid fa-user-group" style="color: #8b5cf6; margin-right: 8px;" title="Hai người cùng máy"></i> }
                                    else if (r.Mode == "AiVsAi") { <i class="fa-solid fa-microchip" style="color: #ec4899; margin-right: 8px;" title="Máy với máy"></i> }
                                    else { <i class="fa-solid fa-chess" style="color: var(--accent-gold); margin-right: 8px;"></i> }
                                    @r.Label
                                </td>
                                <td style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.Created</td>
                                <td style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.InProgress</td>
                                <td style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.Waiting</td>
                                <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-main);">@r.Finished</td>
                                <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: #10b981;">@r.Wins</td>
                                <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: #ef4444;">@r.Losses</td>
                                <td style="padding: 12px 14px; text-align: center; font-weight: 600; color: #d97706;">@r.Draws</td>
                                <td style="padding: 12px 18px; text-align: right; font-weight: 800; color: var(--accent-gold);">
                                    @r.WinRate.ToString("0.0")%
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div style="font-size: 12px; color: var(--text-muted); line-height: 1.6; margin-top: 12px;">
            <i class="fa-solid fa-circle-info" style="color: var(--accent-gold); margin-right: 4px;"></i>
            <em>Tỉ lệ thắng = Số ván thắng / Số ván đã hoàn thành. Điểm Elo xếp hạng chỉ được áp dụng trong chế độ PvP Online.</em>
        </div>
    </div>

    <!-- 3. CỤM BIỂU ĐỒ TRỰC QUAN HÓA (CHART.JS THEO ĐÚNG FORMAT DASHBOARD) -->
    <div class="charts-row-grid">
        <!-- BIỂU ĐỒ 1: TỈ LỆ THẮNG - THUA - HÒA (DOUGHNUT CHART VỚI BADGE TRUNG TÂM) -->
        <div class="panel-box" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
                <h2 class="panel-title" style="margin: 0; font-size: 16px;">
                    <i class="fa-solid fa-chart-pie" style="color: #10b981;"></i> Phân bố kết quả trận đấu
                </h2>
                <!-- SELECT LỌC THEO CHẾ ĐỘ CHƠI / KỲ THỦ CHO BIỂU ĐỒ TRÒN -->
                <select id="donutModeFilter" onchange="onDonutFilterChange()" style="background: var(--bg-navy-dark); color: var(--text-main); border: 1px solid var(--border-color); border-radius: 6px; padding: 5px 12px; font-size: 12px; font-weight: 700; cursor: pointer; outline: none;">
                    <optgroup label="Toàn hệ thống & Chế độ">
                        <option value="ALL">Tất cả chế độ (Toàn hệ thống)</option>
                        @if (Model.ModeStats != null)
                        {
                            foreach (var m in Model.ModeStats)
                            {
                                <option value="MODE_@m.Mode">@m.Label</option>
                            }
                        }
                    </optgroup>
                    <optgroup label="Lọc theo Kỳ thủ">
                        @foreach (var u in Model.AllUsers)
                        {
                            <option value="USER_@u.Id">@u.Username (@u.Elo Elo)</option>
                        }
                    </optgroup>
                </select>
            </div>
            
            <div style="position: relative; width: 100%; height: 210px; display: flex; align-items: center; justify-content: center;">
                <canvas id="outcomeDonutChart"></canvas>
                <!-- Badge hiển thị số liệu nổi bật ngay chính giữa vòng tròn -->
                <div style="position: absolute; text-align: center; pointer-events: none; transform: translateY(-14px);">
                    <div id="donutWinRateValue" style="font-size: 26px; font-weight: 900; color: #b45309; line-height: 1.1;">
                        @Model.AverageSystemWinRate%
                    </div>
                    <div id="donutWinRateLabel" style="font-size: 11px; font-weight: 800; color: #334155; text-transform: uppercase; letter-spacing: 0.5px;">
                        Tỉ lệ thắng
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-color);">
                <div style="text-align: center; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="color: #334155; font-size: 11px; display: block; font-weight: 800;">THẮNG</span>
                    <strong id="donutWinsCount" style="color: #10b981; font-size: 18px; font-weight: 800;">@Model.TotalWins</strong>
                </div>
                <div style="text-align: center; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="color: #334155; font-size: 11px; display: block; font-weight: 800;">HÒA</span>
                    <strong id="donutDrawsCount" style="color: #d97706; font-size: 18px; font-weight: 800;">@Model.TotalDraws</strong>
                </div>
                <div style="text-align: center; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="color: #334155; font-size: 11px; display: block; font-weight: 800;">THUA</span>
                    <strong id="donutLossesCount" style="color: #ef4444; font-size: 18px; font-weight: 800;">@Model.TotalLosses</strong>
                </div>
            </div>
        </div>

        <!-- BIỂU ĐỒ 2: SO SÁNH CÁC CHẾ ĐỘ CHƠI (HORIZONTAL BAR CHART GỌN GÀNG THEO FORMAT DASHBOARD) -->
        <div class="panel-box" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h2 class="panel-title" style="margin: 0; font-size: 16px;">
                    <i class="fa-solid fa-chart-column" style="color: #3b82f6;"></i> Ván đấu theo chế độ
                </h2>
            </div>
            <div style="position: relative; width: 100%; height: 260px;">
                <canvas id="modeCompareChart"></canvas>
            </div>
        </div>
    </div>

    <!-- 4. ELO RATING GRAPH PANEL (DÒNG FULL WIDTH THEO FORMAT DASHBOARD) -->
    <div class="panel-box" style="margin-bottom: 24px; padding: 20px 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
            <h2 class="panel-title" style="margin: 0;">
                <i class="fa-solid fa-chart-line" style="color: var(--accent-gold);"></i> Biểu đồ phong độ & Xếp hạng Elo Kỳ thủ
            </h2>
            <div style="font-size: 13px; color: var(--text-muted); display: flex; align-items: center; gap: 12px;">
                <span><i class="fa-solid fa-circle" style="color: #3b82f6; font-size: 8px;"></i> Elo kỳ thủ</span>
                <span style="font-weight: 600; color: #10b981;">Dẫn đầu: @(topUser?.Username) (@(topUser?.Elo) Elo)</span>
                <span style="color: var(--text-muted);"><i class="fa-solid fa-flag-checkered"></i> Mốc chuẩn: 1200 Elo</span>
            </div>
        </div>
        <div style="position: relative; width: 100%; height: 230px;">
            <canvas id="eloRatingChart"></canvas>
        </div>
    </div>

    <!-- 5. BẢNG THỐNG KÊ TỔNG QUAN KẾT QUẢ CỦA TẤT CẢ USER -->
    <div class="panel-box" style="margin-bottom: 24px; padding: 22px 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
            <h2 class="panel-title" style="margin: 0;">
                <i class="fa-solid fa-ranking-star" style="color: #facc15;"></i> Bảng tổng quan Kết quả Thi đấu của Tất cả Kỳ thủ (@Model.AllUsers.Count người dùng)
            </h2>
            <div style="display: flex; gap: 8px;">
                <a href="/Admin/Users" class="btn-admin btn-admin-gold btn-admin-sm">
                    <i class="fa-solid fa-user-gear"></i> Quản lý phân quyền chi tiết
                </a>
            </div>
        </div>
        <div class="admin-table-wrapper" style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px; text-align: center;">Hạng</th>
                        <th>Kỳ thủ</th>
                        <th style="width: 150px;">Kỳ lực & Elo</th>
                        <th style="width: 90px; text-align: center;">Tổng ván</th>
                        <th style="width: 160px; text-align: center;">Thắng - Hòa - Thua</th>
                        <th style="width: 150px;">Tỉ lệ thắng</th>
                        <th style="width: 140px; text-align: center;">Cờ thế đã giải</th>
                        <th style="width: 120px; text-align: center;">Khóa học</th>
                        <th style="width: 110px; text-align: center;">Vai trò</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rank = 1;
                    }
                    @foreach (var u in Model.AllUsers)
                    {
                        var medalClass = rank == 1 ? "gold" : (rank == 2 ? "silver" : (rank == 3 ? "bronze" : "normal"));
                        var tierClass = u.Elo >= 1500 ? "tier-grandmaster" : (u.Elo >= 1400 ? "tier-master" : (u.Elo >= 1250 ? "tier-expert" : (u.Elo >= 1150 ? "tier-amateur" : "tier-novice")));
                        var winRateColor = u.WinRate >= 60 ? "#10b981" : (u.WinRate >= 45 ? "#d97706" : "#ef4444");

                        <tr>
                            <td style="text-align: center;">
                                <span class="rank-medal @medalClass">
                                    @(rank <= 3 ? (rank == 1 ? "🥇" : (rank == 2 ? "🥈" : "🥉")) : $"#{rank}")
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <div>
                                        <strong style="color: var(--text-main, #0f172a); font-size: 14px;">@u.Username</strong>
                                        <div style="font-size: 11px; color: var(--text-muted, #64748b);">
                                            @u.Email <span style="opacity: 0.5;">|</span> Mã: <code style="color: var(--accent-gold-dark, #b45309);">@u.PlayerId</code>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <span class="tier-badge @tierClass">@u.Title</span>
                                    <span style="font-size: 13px; font-weight: 800; color: var(--accent-gold, #d97706);">
                                        <i class="fa-solid fa-star" style="font-size: 10px;"></i> @u.Elo
                                    </span>
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <strong style="font-size: 14px; color: var(--text-main);">@u.GamesPlayed</strong>
                            </td>
                            <td style="text-align: center;">
                                <span class="stat-wdl-pill">
                                    <span class="wdl-w"><i class="fa-solid fa-check"></i> @u.Wins</span> - 
                                    <span class="wdl-d">@u.Draws</span> - 
                                    <span class="wdl-l"><i class="fa-solid fa-xmark"></i> @u.Losses</span>
                                </span>
                            </td>
                            <td>
                                <div class="winrate-bar-container">
                                    <div class="winrate-bar-bg">
                                        <div class="winrate-bar-fill" style="width: @u.WinRate%; background-color: @winRateColor;"></div>
                                    </div>
                                    <strong style="color: @winRateColor; font-size: 13px; min-width: 44px; text-align: right;">@u.WinRate%</strong>
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <strong style="color: #0284c7;">@u.PuzzleScore</strong> <span style="font-size: 11px; color: var(--text-muted);">(@u.PuzzlesSolved bài)</span>
                            </td>
                            <td style="text-align: center;">
                                <strong style="color: #9333ea;">@u.LessonsCompleted / 19</strong>
                            </td>
                            <td style="text-align: center;">
                                <span class="role-badge @(u.Role.ToLower() == "admin" ? "admin" : "player")">
                                    @u.Role
                                </span>
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 6. THẾ CỜ VỪA NẠP GẦN ĐÂY -->
    <div class="panel-box" style="padding: 22px 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
            <h2 class="panel-title" style="margin: 0;">
                <i class="fa-solid fa-puzzle-piece" style="color: var(--accent-gold);"></i> Các thế cờ tiêu biểu trong Kho (@Model.TotalPuzzles thế cờ)
            </h2>
            <a href="/Admin/Puzzles" class="btn-admin btn-admin-gold btn-admin-sm">
                <i class="fa-solid fa-arrow-right"></i> Xem toàn bộ kho cờ thế
            </a>
        </div>
        <div class="admin-table-wrapper" style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">Màn</th>
                        <th>Tiêu đề thế cờ</th>
                        <th>Độ khó</th>
                        <th>Sát pháp</th>
                        <th>Chuỗi FEN trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.RecentPuzzles)
                    {
                        <tr>
                            <td><strong style="color: var(--accent-gold-dark);">#@p.Level</strong></td>
                            <td><strong>@p.Title</strong></td>
                            <td>
                                <span style="font-size: 12px; font-weight: 700; color: @(p.Difficulty == 1 ? "#10b981" : (p.Difficulty == 2 ? "#d97706" : "#ef4444"));">
                                    @(p.Difficulty == 1 ? "Dễ" : (p.Difficulty == 2 ? "Trung bình" : "Khó"))
                                </span>
                            </td>
                            <td><span style="color: var(--text-main); font-weight: 600;">@p.MateIn nước</span></td>
                            <td><code class="admin-code-fen">@p.Fen</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            const rawUsers = @Html.Raw(usersJson);
            const modeStatsList = @Html.Raw(modeStatsJson);
            const systemTotalWins = @Model.TotalWins;
            const systemTotalDraws = @Model.TotalDraws;
            const systemTotalLosses = @Model.TotalLosses;
            const systemAvgWinRate = @Html.Raw(avgWinRateJson);

            let outcomeChartInstance = null;

            // ========================================================
            // 1. DOUGHNUT CHART: PHÂN BỐ KẾT QUẢ VỚI BADGE TRUNG TÂM
            // ========================================================
            function initOutcomeChart() {
                const ctx = document.getElementById('outcomeDonutChart');
                if (!ctx || !window.Chart) return;

                const wins = systemTotalWins;
                const draws = systemTotalDraws;
                const losses = systemTotalLosses;
                const total = wins + draws + losses;

                outcomeChartInstance = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Thắng', 'Hòa', 'Thua'],
                        datasets: [{
                            data: total === 0 ? [1, 0, 0] : [wins, draws, losses],
                            backgroundColor: total === 0 ? ['#94a3b8', '#94a3b8', '#94a3b8'] : ['#10b981', '#f59e0b', '#ef4444'],
                            hoverBackgroundColor: ['#059669', '#d97706', '#dc2626'],
                            borderWidth: 0,
                            borderRadius: 6,
                            spacing: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '76%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    color: '#1e293b',
                                    padding: 14,
                                    font: { size: 12, weight: '700' },
                                    usePointStyle: true,
                                    pointStyle: 'circle'
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(15, 23, 42, 0.95)',
                                titleColor: '#f8fafc',
                                bodyColor: '#cbd5e1',
                                padding: 10,
                                borderColor: 'rgba(255, 255, 255, 0.1)',
                                borderWidth: 1,
                                displayColors: true,
                                callbacks: {
                                    label: function(c) {
                                        const d = c.dataset.data;
                                        const sum = d.reduce((a, b) => a + b, 0);
                                        if (sum === 1 && d[0] === 1 && d[1] === 0 && d[2] === 0) return ' Chưa có trận đấu';
                                        const val = c.raw;
                                        const pct = sum > 0 ? ((val / sum) * 100).toFixed(1) : 0;
                                        return ' ' + c.label + ': ' + val + ' ván (' + pct + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // FILTER CHANGE HANDLER FOR DOUGHNUT CHART
            window.onDonutFilterChange = function() {
                const select = document.getElementById('donutModeFilter');
                const val = select ? select.value : 'ALL';

                let wins = 0, draws = 0, losses = 0, winRate = 0, labelText = 'Tỉ lệ thắng';

                if (val === 'ALL') {
                    wins = systemTotalWins;
                    draws = systemTotalDraws;
                    losses = systemTotalLosses;
                    const total = wins + draws + losses;
                    winRate = total > 0 ? ((wins / total) * 100).toFixed(1) : systemAvgWinRate;
                    labelText = 'Tỉ lệ thắng';
                } else if (val.startsWith('MODE_')) {
                    const modeKey = val.replace('MODE_', '');
                    const foundMode = modeStatsList.find(m => m.Mode === modeKey);
                    if (foundMode) {
                        wins = foundMode.Wins || 0;
                        draws = foundMode.Draws || 0;
                        losses = foundMode.Losses || 0;
                        winRate = foundMode.WinRate || 0;
                        labelText = foundMode.Mode + ' Thắng';
                    }
                } else if (val.startsWith('USER_')) {
                    const userId = parseInt(val.replace('USER_', ''), 10);
                    const foundUser = rawUsers.find(u => u.Id === userId);
                    if (foundUser) {
                        wins = foundUser.Wins || 0;
                        draws = foundUser.Draws || 0;
                        losses = foundUser.Losses || 0;
                        winRate = foundUser.WinRate || 0;
                        labelText = foundUser.Username;
                    }
                }

                const elWinRate = document.getElementById('donutWinRateValue');
                const elWinLabel = document.getElementById('donutWinRateLabel');
                const elWins = document.getElementById('donutWinsCount');
                const elDraws = document.getElementById('donutDrawsCount');
                const elLosses = document.getElementById('donutLossesCount');

                if (elWinRate) elWinRate.textContent = winRate + '%';
                if (elWinLabel) elWinLabel.textContent = labelText;
                if (elWins) elWins.textContent = wins;
                if (elDraws) elDraws.textContent = draws;
                if (elLosses) elLosses.textContent = losses;

                if (outcomeChartInstance) {
                    const totalMatches = wins + draws + losses;
                    outcomeChartInstance.data.datasets[0].data = totalMatches === 0 ? [1, 0, 0] : [wins, draws, losses];
                    outcomeChartInstance.data.datasets[0].backgroundColor = totalMatches === 0 ? ['#94a3b8', '#94a3b8', '#94a3b8'] : ['#10b981', '#f59e0b', '#ef4444'];
                    outcomeChartInstance.update();
                }
            };

            // ========================================================
            // 2. HORIZONTAL BAR CHART: SO SÁNH VÁN ĐẤU THEO CHẾ ĐỘ
            // ========================================================
            function initModeCompareChart() {
                const ctx = document.getElementById('modeCompareChart');
                if (!ctx || !window.Chart) return;

                const labels = modeStatsList.map(m => m.Label || m.Mode);
                const finishedData = modeStatsList.map(m => m.Finished);
                const winsData = modeStatsList.map(m => m.Wins);

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Hoàn tất',
                                data: finishedData,
                                backgroundColor: '#3b82f6',
                                hoverBackgroundColor: '#2563eb',
                                borderRadius: 6,
                                barPercentage: 0.65,
                                categoryPercentage: 0.6
                            },
                            {
                                label: 'Thắng',
                                data: winsData,
                                backgroundColor: '#10b981',
                                hoverBackgroundColor: '#059669',
                                borderRadius: 6,
                                barPercentage: 0.65,
                                categoryPercentage: 0.6
                            }
                        ]
                    },
                    options: {
                        indexAxis: 'y', // Chuyển thành thanh ngang (Horizontal bar)
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                align: 'end',
                                labels: {
                                    color: '#1e293b',
                                    font: { size: 12, weight: '700' },
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    padding: 12
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(15, 23, 42, 0.95)',
                                titleColor: '#f8fafc',
                                bodyColor: '#cbd5e1',
                                borderColor: 'rgba(255, 255, 255, 0.1)',
                                borderWidth: 1,
                                padding: 10
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(0, 0, 0, 0.06)' },
                                ticks: { color: '#334155', font: { size: 12, weight: '700' }, precision: 0 },
                                beginAtZero: true
                            },
                            y: {
                                grid: { display: false },
                                ticks: { 
                                    color: '#0f172a', 
                                    font: { size: 12, weight: '800' }
                                }
                            }
                        }
                    }
                });
            }

            // ========================================================
            // 3. ELO RATING GRAPH PANEL: BIỂU ĐỒ PHONG ĐỘ & ELO KỲ THỦ
            // ========================================================
            function initEloRatingChart() {
                const ctx = document.getElementById('eloRatingChart');
                if (!ctx || !window.Chart) return;

                const sortedUsers = rawUsers.slice().sort((a, b) => b.Elo - a.Elo);
                const labels = sortedUsers.map(u => u.Username);
                const eloValues = sortedUsers.map(u => u.Elo);
                const baselineValues = sortedUsers.map(() => 1200);

                const canvasCtx = ctx.getContext('2d');
                const gradient = canvasCtx.createLinearGradient(0, 0, 0, 220);
                gradient.addColorStop(0, 'rgba(59, 130, 246, 0.35)');
                gradient.addColorStop(1, 'rgba(59, 130, 246, 0.0)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Điểm Elo Kỳ thủ',
                                data: eloValues,
                                borderColor: '#3b82f6',
                                backgroundColor: gradient,
                                borderWidth: 2.5,
                                fill: true,
                                tension: 0.35,
                                pointBackgroundColor: '#3b82f6',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointRadius: 6,
                                pointHoverRadius: 8
                            },
                            {
                                label: 'Mốc chuẩn (1200 Elo)',
                                data: baselineValues,
                                borderColor: '#f59e0b',
                                borderWidth: 1.5,
                                borderDash: [6, 6],
                                fill: false,
                                pointRadius: 0,
                                pointHoverRadius: 0
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                align: 'end',
                                labels: {
                                    color: '#1e293b',
                                    font: { size: 12, weight: '700' },
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    padding: 12
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(15, 23, 42, 0.95)',
                                titleColor: '#f8fafc',
                                bodyColor: '#cbd5e1',
                                borderColor: 'rgba(255, 255, 255, 0.1)',
                                borderWidth: 1,
                                padding: 10,
                                callbacks: {
                                    label: function(context) {
                                        if (context.datasetIndex === 1) {
                                            return ' Mốc khởi đầu chuẩn: 1200 Elo';
                                        }
                                        const u = sortedUsers[context.dataIndex];
                                        return ` ${u.Username}: ${u.Elo} Elo (${u.Title} · ${u.WinRate}% thắng · ${u.PuzzlesSolved} cờ thế)`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(0, 0, 0, 0.06)' },
                                ticks: { color: '#0f172a', font: { size: 12, weight: '700' } }
                            },
                            y: {
                                min: 900,
                                max: 1650,
                                grid: { color: 'rgba(0, 0, 0, 0.06)' },
                                ticks: { color: '#334155', font: { size: 12, weight: '700' }, precision: 0 }
                            }
                        }
                    }
                });
            }

            function initAllCharts() {
                initOutcomeChart();
                initModeCompareChart();
                initEloRatingChart();
            }

            if (window.Chart) {
                initAllCharts();
            } else {
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
                script.onload = initAllCharts;
                document.head.appendChild(script);
            }
        })();
    </script>
}
