@model ChessCore.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "Quản trị hệ thống";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="fa-solid fa-gauge-high"></i> Bảng điều khiển Quản trị viên</h1>
        <div class="admin-tabs">
            <a href="/Admin" class="admin-tab-btn active"><i class="fa-solid fa-chart-pie"></i> Tổng quan</a>
            <a href="/Admin/Users" class="admin-tab-btn"><i class="fa-solid fa-users"></i> Quản lý Người dùng</a>
            <a href="/Admin/Puzzles" class="admin-tab-btn"><i class="fa-solid fa-puzzle-piece"></i> Quản lý Cờ thế</a>
            <a href="/Admin/Courses" class="admin-tab-btn"><i class="fa-solid fa-graduation-cap"></i> Quản lý Khóa học</a>
            <a href="/Admin/AiBenchmark" class="admin-tab-btn"><i class="fa-solid fa-microchip"></i> Hiệu năng AI</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alert admin-alert-danger">
            <i class="fa-solid fa-triangle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Stat Cards -->
    <div class="admin-stats-grid">
        <div class="admin-stat-card users">
            <div class="admin-stat-icon"><i class="fa-solid fa-users"></i></div>
            <div class="admin-stat-info">
                <span>Tổng Người Dùng</span>
                <strong>@Model.TotalUsers</strong>
            </div>
        </div>
        <div class="admin-stat-card games">
            <div class="admin-stat-icon"><i class="fa-solid fa-chess"></i></div>
            <div class="admin-stat-info">
                <span>Ván Đấu Đã Tạo</span>
                <strong>@Model.TotalGames</strong>
            </div>
        </div>
        <div class="admin-stat-card puzzles">
            <div class="admin-stat-icon"><i class="fa-solid fa-puzzle-piece"></i></div>
            <div class="admin-stat-info">
                <span>Thế Cờ Trong Kho</span>
                <strong>@Model.TotalPuzzles</strong>
            </div>
        </div>
        <div class="admin-stat-card lessons">
            <div class="admin-stat-icon"><i class="fa-solid fa-book-bookmark"></i></div>
            <div class="admin-stat-info">
                <span>Bài Học (@Model.TotalModules Modules)</span>
                <strong>@Model.TotalLessons</strong>
            </div>
        </div>
    </div>

    <section class="admin-card" style="padding:20px">
        <h2>Ván đấu và điểm theo chế độ</h2>
        <a href="/Admin/Export">Tải báo cáo CSV</a>
        @{ ViewData["AdminStatistics"] = true; }
        <partial name="_ModeStatistics" model="Model.ModeStats" />
        <p>Khóa học: @Model.Learning.CompletedLessonRecords bản ghi người–bài hoàn thành · @Model.Learning.QuizAttempts lượt quiz · Trung bình điểm tốt nhất: @Model.Learning.AverageBestQuizScore%.</p>
        <p>Cờ thế: @Model.Learning.PuzzlesSolved bản ghi người–bài đã giải · @Model.Learning.PuzzleAttempts lượt gửi lời giải.</p>
        <p>Kho chiến dịch đang chơi được: @(Model.PlayablePuzzles?.ToString() ?? "Đang phân tích") bài. Kho cờ thế quản trị: @Model.TotalPuzzles bài (hai nguồn khác nhau).</p>
    </section>
    <section class="admin-card" style="padding:20px;overflow-x:auto">
        <h2>Lịch sử cộng / trừ Elo gần nhất</h2>
        <p>50 bản ghi mới nhất. Điểm trước, sau và chênh lệch lấy trực tiếp từ sổ ghi điểm.</p>
        <table class="admin-table" style="width:100%"><thead><tr><th>Thời điểm UTC</th><th>Người chơi</th><th>Ván</th><th>Trước</th><th>Δ</th><th>Sau</th><th>Lý do</th></tr></thead><tbody>
        @foreach (var h in Model.RatingHistory) {
            <tr><td>@h.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@h.User.Username</td><td>@h.GameId</td><td>@h.OldElo</td><td>@h.EloChange.ToString("+0;-0;0")</td><td>@h.NewElo</td><td>@h.Reason</td></tr>
        }
        </tbody></table>
        @if (Model.RatingHistory.Count == 0) { <p>Chưa có bản ghi biến động Elo.</p> }
    </section>
    <!-- 2 Column Section -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 24px;">
        <!-- Recent Users -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h2><i class="fa-solid fa-user-clock" style="color: #60a5fa;"></i> Tài khoản mới đăng ký</h2>
            </div>
            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Tài khoản</th>
                            <th>Mã ID</th>
                            <th>Elo</th>
                            <th>Vai trò</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.RecentUsers)
                        {
                            <tr>
                                <td>
                                    <strong>@u.Username</strong>
                                    <div style="font-size: 11px; color: var(--text-muted);">@u.Email</div>
                                </td>
                                <td><code style="color: var(--accent-gold-dark); background: var(--bg-navy-light); padding: 2px 6px; border-radius: 4px;">@u.PlayerId</code></td>
                                <td><strong style="color: var(--accent-gold);">@u.Elo</strong></td>
                                <td>
                                    <span class="role-badge @(u.Role?.ToLower() == "admin" ? "admin" : "player")">
                                        @(u.Role ?? "Player")
                                    </span>
                                </td>
                                <td>
                                    <form asp-controller="Admin" asp-action="ToggleAdminRole" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="btn-admin btn-admin-sm @(u.Role == "Admin" ? "btn-admin-danger" : "btn-admin-primary")" title="Đổi quyền Admin / Player">
                                            @(u.Role == "Admin" ? "Hạ quyền" : "Cấp Admin")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Puzzles -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h2><i class="fa-solid fa-fire" style="color: #facc15;"></i> Cờ thế mới nhất</h2>
                <a href="/Admin/Puzzles" class="btn-admin btn-admin-gold btn-admin-sm">
                    <i class="fa-solid fa-plus"></i> Quản lý toàn bộ
                </a>
            </div>
            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Màn</th>
                            <th>Tiêu đề</th>
                            <th>Độ khó</th>
                            <th>Sát pháp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.RecentPuzzles)
                        {
                            <tr>
                                <td><strong style="color: var(--accent-gold-dark);">#@p.Level</strong></td>
                                <td><strong>@p.Title</strong></td>
                                <td>
                                    <span style="font-size: 12px; font-weight: 600; color: @(p.Difficulty == 1 ? "#059669" : (p.Difficulty == 2 ? "#d97706" : "#dc2626"));">
                                        @(p.Difficulty == 1 ? "Dễ" : (p.Difficulty == 2 ? "Trung bình" : "Khó"))
                                    </span>
                                </td>
                                <td><span style="color: var(--text-muted);">@(p.MateIn) nước</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
