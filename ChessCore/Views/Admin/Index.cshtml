@model ChessCore.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "Quản trị hệ thống - Tổng quan";
    var usersJson = System.Text.Json.JsonSerializer.Serialize(Model.AllUsers);
    var modesJson = System.Text.Json.JsonSerializer.Serialize(Model.GameModesDistribution);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        .admin-kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 14px;
            margin-bottom: 24px;
        }
        .admin-kpi-card {
            background: var(--bg-navy-panel, #1e293b);
            border: 1px solid var(--border-color, #334155);
            border-radius: 12px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .admin-kpi-card:hover {
            transform: translateY(-2px);
            border-color: var(--accent-gold, #facc15);
        }
        .admin-kpi-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
        .admin-kpi-info {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }
        .admin-kpi-val {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-main, #f8fafc);
            line-height: 1.2;
        }
        .admin-kpi-lbl {
            font-size: 12px;
            color: var(--text-muted, #94a3b8);
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .charts-row-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }
        @@media (max-width: 992px) {
            .charts-row-grid {
                grid-template-columns: 1fr;
            }
        }

        .chart-box {
            background: var(--bg-navy-panel, #1e293b);
            border: 1px solid var(--border-color, #334155);
            border-radius: 12px;
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
        }
        .chart-box-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding-bottom: 10px;
        }
        .chart-box-header h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-main, #f8fafc);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .chart-canvas-wrapper {
            position: relative;
            flex: 1;
            min-height: 250px;
            width: 100%;
        }

        .rank-medal {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            font-weight: 800;
            font-size: 13px;
        }
        .rank-medal.gold { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; box-shadow: 0 0 10px rgba(245, 158, 11, 0.4); }
        .rank-medal.silver { background: linear-gradient(135deg, #94a3b8, #64748b); color: #fff; }
        .rank-medal.bronze { background: linear-gradient(135deg, #b45309, #78350f); color: #fff; }
        .rank-medal.normal { background: var(--bg-navy-light, #334155); color: var(--text-muted, #94a3b8); }

        .tier-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
        }
        .tier-grandmaster { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); }
        .tier-master { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }
        .tier-expert { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }
        .tier-amateur { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }
        .tier-novice { background: rgba(148, 163, 184, 0.2); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.4); }

        .winrate-bar-container {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 110px;
        }
        .winrate-bar-bg {
            flex: 1;
            height: 6px;
            background: #334155;
            border-radius: 3px;
            overflow: hidden;
        }
        .winrate-bar-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.4s ease;
        }
        .stat-wdl-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            font-weight: 600;
        }
        .wdl-w { color: #10b981; }
        .wdl-d { color: #f59e0b; }
        .wdl-l { color: #ef4444; }
    </style>
}

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="fa-solid fa-gauge-high"></i> Bảng điều khiển Quản trị viên (Admin Dashboard)</h1>
        <div class="admin-tabs">
            <a href="/Admin" class="admin-tab-btn active"><i class="fa-solid fa-chart-pie"></i> Tổng quan</a>
            <a href="/Admin/Users" class="admin-tab-btn"><i class="fa-solid fa-users"></i> Quản lý Người dùng</a>
            <a href="/Admin/Puzzles" class="admin-tab-btn"><i class="fa-solid fa-puzzle-piece"></i> Quản lý Cờ thế</a>
            <a href="/Admin/Courses" class="admin-tab-btn"><i class="fa-solid fa-graduation-cap"></i> Quản lý Khóa học</a>
            <a href="/Admin/AiBenchmark" class="admin-tab-btn"><i class="fa-solid fa-microchip"></i> Hiệu năng AI</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alert admin-alert-danger">
            <i class="fa-solid fa-triangle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- 1. DÀN THẺ KPI CHỈ SỐ HỆ THỐNG TOÀN DIỆN -->
    <div class="admin-kpi-grid">
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalUsers</span>
                <span class="admin-kpi-lbl">Tổng số Kỳ thủ</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
                <i class="fa-solid fa-chess-board"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalGames</span>
                <span class="admin-kpi-lbl">Ván cờ đã khởi tạo</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                <i class="fa-solid fa-puzzle-piece"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalPuzzles</span>
                <span class="admin-kpi-lbl">Thế cờ trong kho</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(168, 85, 247, 0.15); color: #a855f7;">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalLessons</span>
                <span class="admin-kpi-lbl">Bài học (@Model.TotalModules Modules)</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
                <i class="fa-solid fa-bolt"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.TotalMoves.ToString("N0")</span>
                <span class="admin-kpi-lbl">Nước đi lưu trữ</span>
            </div>
        </div>
        <div class="admin-kpi-card">
            <div class="admin-kpi-icon" style="background: rgba(14, 165, 233, 0.15); color: #0ea5e9;">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <div class="admin-kpi-info">
                <span class="admin-kpi-val">@Model.AverageSystemWinRate%</span>
                <span class="admin-kpi-lbl">Tỉ lệ Thắng TB Kỳ thủ</span>
            </div>
        </div>
    </div>

    <!-- 2. KHU VỰC SƠ ĐỒ & BIỂU ĐỒ TRỰC QUAN TỔNG QUAN -->
    <div class="charts-row-grid">
        <!-- Biểu đồ 1: So sánh Điểm Elo & Kỳ Lực Kỳ Thủ -->
        <div class="chart-box">
            <div class="chart-box-header">
                <h3><i class="fa-solid fa-ranking-star" style="color: #facc15;"></i> Biểu đồ So sánh Điểm Elo & Trình độ các Kỳ thủ</h3>
                <span style="font-size: 12px; color: var(--text-muted);"><i class="fa-solid fa-flag-checkered"></i> Mốc chuẩn: 1200 Elo</span>
            </div>
            <div class="chart-canvas-wrapper">
                <canvas id="eloComparisonChart"></canvas>
            </div>
        </div>

        <!-- Biểu đồ 2: Cơ cấu Phân bổ 4 Chế độ chơi -->
        <div class="chart-box">
            <div class="chart-box-header">
                <h3><i class="fa-solid fa-pie-chart" style="color: #38bdf8;"></i> Cơ cấu 4 Chế độ chơi</h3>
                <span style="font-size: 12px; color: var(--text-muted);">Tổng @Model.TotalGames ván</span>
            </div>
            <div class="chart-canvas-wrapper" style="display: flex; align-items: center; justify-content: center;">
                <canvas id="gameModesChart" style="max-height: 250px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Biểu đồ 3: Tương quan Thắng - Hòa - Thua của Từng Kỳ Thủ -->
    <div class="chart-box" style="margin-bottom: 24px;">
        <div class="chart-box-header">
            <h3><i class="fa-solid fa-chart-simple" style="color: #34d399;"></i> Tương quan Kết quả Thi đấu (Thắng - Hòa - Thua) theo từng Kỳ thủ</h3>
            <span style="font-size: 12px; color: var(--text-muted);"><span style="color: #10b981;">■ Thắng</span> | <span style="color: #f59e0b;">■ Hòa</span> | <span style="color: #ef4444;">■ Thua</span></span>
        </div>
        <div class="chart-canvas-wrapper" style="min-height: 220px;">
            <canvas id="wdlComparisonChart"></canvas>
        </div>
    </div>

    <!-- 3. BẢNG THỐNG KÊ TỔNG QUAN KẾT QUẢ CỦA TẤT CẢ USER -->
    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="admin-card-header">
            <h2><i class="fa-solid fa-trophy" style="color: #facc15;"></i> Bảng tổng quan Kết quả Thi đấu của Tất cả Kỳ thủ (@Model.AllUsers.Count người dùng)</h2>
            <div style="display: flex; gap: 8px;">
                <a href="/Admin/Users" class="btn-admin btn-admin-gold btn-admin-sm">
                    <i class="fa-solid fa-user-gear"></i> Quản lý phân quyền chi tiết
                </a>
            </div>
        </div>
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px; text-align: center;">Hạng</th>
                        <th>Kỳ thủ</th>
                        <th style="width: 140px;">Kỳ lực & Elo</th>
                        <th style="width: 90px; text-align: center;">Tổng ván</th>
                        <th style="width: 160px; text-align: center;">Thắng - Hòa - Thua</th>
                        <th style="width: 150px;">Tỉ lệ thắng</th>
                        <th style="width: 130px; text-align: center;">Cờ thế đã giải</th>
                        <th style="width: 110px; text-align: center;">Khóa học</th>
                        <th style="width: 110px; text-align: center;">Vai trò</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rank = 1;
                    }
                    @foreach (var u in Model.AllUsers)
                    {
                        var medalClass = rank == 1 ? "gold" : (rank == 2 ? "silver" : (rank == 3 ? "bronze" : "normal"));
                        var tierClass = u.Elo >= 1500 ? "tier-grandmaster" : (u.Elo >= 1400 ? "tier-master" : (u.Elo >= 1250 ? "tier-expert" : (u.Elo >= 1150 ? "tier-amateur" : "tier-novice")));
                        var winRateColor = u.WinRate >= 60 ? "#10b981" : (u.WinRate >= 45 ? "#f59e0b" : "#ef4444");

                        <tr>
                            <td style="text-align: center;">
                                <span class="rank-medal @medalClass">
                                    @(rank <= 3 ? (rank == 1 ? "🥇" : (rank == 2 ? "🥈" : "🥉")) : $"#{rank}")
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <div>
                                        <strong style="color: var(--text-main, #f8fafc); font-size: 14px;">@u.Username</strong>
                                        <div style="font-size: 11px; color: var(--text-muted, #94a3b8);">
                                            @u.Email <span style="opacity: 0.5;">|</span> Mã: <code style="color: var(--accent-gold-dark, #fbbf24);">@u.PlayerId</code>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <span class="tier-badge @tierClass">@u.Title</span>
                                    <span style="font-size: 13px; font-weight: 800; color: var(--accent-gold, #facc15);">
                                        <i class="fa-solid fa-star" style="font-size: 10px;"></i> @u.Elo
                                    </span>
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <strong style="font-size: 14px; color: var(--text-main);">@u.GamesPlayed</strong>
                            </td>
                            <td style="text-align: center;">
                                <span class="stat-wdl-pill">
                                    <span class="wdl-w"><i class="fa-solid fa-check"></i> @u.Wins</span> - 
                                    <span class="wdl-d">@u.Draws</span> - 
                                    <span class="wdl-l"><i class="fa-solid fa-xmark"></i> @u.Losses</span>
                                </span>
                            </td>
                            <td>
                                <div class="winrate-bar-container">
                                    <div class="winrate-bar-bg">
                                        <div class="winrate-bar-fill" style="width: @u.WinRate%; background-color: @winRateColor;"></div>
                                    </div>
                                    <strong style="color: @winRateColor; font-size: 13px; min-width: 44px; text-align: right;">@u.WinRate%</strong>
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <strong style="color: #38bdf8;">@u.PuzzleScore</strong> <span style="font-size: 11px; color: var(--text-muted);">(@u.PuzzlesSolved bài)</span>
                            </td>
                            <td style="text-align: center;">
                                <strong style="color: #a855f7;">@u.LessonsCompleted / 19</strong>
                            </td>
                            <td style="text-align: center;">
                                <span class="role-badge @(u.Role.ToLower() == "admin" ? "admin" : "player")">
                                    @u.Role
                                </span>
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 4. THẾ CỜ VỪA NẠP GẦN ĐÂY -->
    <div class="admin-card">
        <div class="admin-card-header">
            <h2><i class="fa-solid fa-puzzle-piece" style="color: #facc15;"></i> Các thế cờ tiêu biểu trong Kho (@Model.TotalPuzzles thế cờ)</h2>
            <a href="/Admin/Puzzles" class="btn-admin btn-admin-gold btn-admin-sm">
                <i class="fa-solid fa-arrow-right"></i> Xem toàn bộ kho cờ thế
            </a>
        </div>
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">Màn</th>
                        <th>Tiêu đề thế cờ</th>
                        <th>Độ khó</th>
                        <th>Sát pháp</th>
                        <th>Chuỗi FEN trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.RecentPuzzles)
                    {
                        <tr>
                            <td><strong style="color: var(--accent-gold-dark);">#@p.Level</strong></td>
                            <td><strong>@p.Title</strong></td>
                            <td>
                                <span style="font-size: 12px; font-weight: 700; color: @(p.Difficulty == 1 ? "#10b981" : (p.Difficulty == 2 ? "#f59e0b" : "#ef4444"));">
                                    @(p.Difficulty == 1 ? "Dễ" : (p.Difficulty == 2 ? "Trung bình" : "Khó"))
                                </span>
                            </td>
                            <td><span style="color: var(--text-main); font-weight: 600;">@p.MateIn nước</span></td>
                            <td><code class="admin-code-fen">@p.Fen</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rawUsers = @Html.Raw(usersJson);
            const rawModes = @Html.Raw(modesJson);

            // Dữ liệu cho Biểu đồ 1: So sánh Elo Kỳ thủ
            const userNames = rawUsers.map(u => u.Username);
            const userElos = rawUsers.map(u => u.Elo);
            const barColors = rawUsers.map(u => {
                if (u.Elo >= 1500) return '#ef4444'; // Đỏ Đại Sư
                if (u.Elo >= 1400) return '#f59e0b'; // Vàng Kiện Tướng
                if (u.Elo >= 1250) return '#3b82f6'; // Xanh Giỏi
                if (u.Elo >= 1150) return '#10b981'; // Xanh ngọc Nghiệp dư
                return '#64748b'; // Xám Tập sự
            });

            // 1. CHART: SO SÁNH ĐIỂM ELO
            const eloCtx = document.getElementById('eloComparisonChart').getContext('2d');
            new Chart(eloCtx, {
                type: 'bar',
                data: {
                    labels: userNames,
                    datasets: [{
                        label: 'Điểm Elo Hiện tại',
                        data: userElos,
                        backgroundColor: barColors,
                        borderRadius: 6,
                        borderWidth: 1,
                        borderColor: 'rgba(255, 255, 255, 0.1)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const u = rawUsers[context.dataIndex];
                                    return ` ${u.Title}: ${context.raw} Elo (${u.WinRate}% thắng)`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            min: 900,
                            max: 1650,
                            grid: { color: 'rgba(255, 255, 255, 0.06)' },
                            ticks: { color: '#94a3b8', font: { size: 11 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#e2e8f0', font: { weight: 'bold', size: 12 } }
                        }
                    }
                }
            });

            // 2. CHART: CƠ CẤU 4 CHẾ ĐỘ CHƠI
            const modeLabels = ['Online (Kỳ đài)', 'Chơi với máy (PvE)', 'Hai người 1 máy (PvP)', 'Máy vs Máy (AiVsAi)'];
            const modeValues = [
                rawModes['Online'] || 0,
                rawModes['PvE'] || 0,
                rawModes['PvP'] || 0,
                rawModes['AiVsAi'] || 0
            ];

            const modeCtx = document.getElementById('gameModesChart').getContext('2d');
            new Chart(modeCtx, {
                type: 'doughnut',
                data: {
                    labels: modeLabels,
                    datasets: [{
                        data: modeValues,
                        backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'],
                        borderColor: '#1e293b',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#cbd5e1', font: { size: 11 }, boxWidth: 12, padding: 10 }
                        }
                    }
                }
            });

            // 3. CHART: TƯƠNG QUAN THẮNG - HÒA - THUA
            const winsData = rawUsers.map(u => u.Wins);
            const drawsData = rawUsers.map(u => u.Draws);
            const lossesData = rawUsers.map(u => u.Losses);

            const wdlCtx = document.getElementById('wdlComparisonChart').getContext('2d');
            new Chart(wdlCtx, {
                type: 'bar',
                data: {
                    labels: userNames,
                    datasets: [
                        { label: 'Thắng (Wins)', data: winsData, backgroundColor: '#10b981', borderRadius: 4 },
                        { label: 'Hòa (Draws)', data: drawsData, backgroundColor: '#f59e0b', borderRadius: 4 },
                        { label: 'Thua (Losses)', data: lossesData, backgroundColor: '#ef4444', borderRadius: 4 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            stacked: true,
                            grid: { display: false },
                            ticks: { color: '#e2e8f0', font: { weight: 'bold', size: 12 } }
                        },
                        y: {
                            stacked: true,
                            grid: { color: 'rgba(255, 255, 255, 0.06)' },
                            ticks: { color: '#94a3b8' }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: { color: '#cbd5e1', font: { size: 12 }, boxWidth: 14 }
                        }
                    }
                }
            });
        });
    </script>
}
