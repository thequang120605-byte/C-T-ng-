@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 16px; padding: 40px; max-width: 520px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <i class="fa-solid fa-shield-halved" style="font-size: 56px; color: #ef4444; margin-bottom: 20px;"></i>
        <h2 style="color: #f8fafc; font-size: 24px; margin-bottom: 12px; font-weight: 700;">Truy cập bị từ chối</h2>
        <p style="color: #94a3b8; font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
            Khu vực này chỉ dành cho tài khoản có quyền <strong>Quản trị viên (Admin)</strong>. Bạn vui lòng liên hệ quản trị hệ thống hoặc quay về trang chủ.
        </p>
        <div style="display: flex; gap: 12px; justify-content: center;">
            <a href="/" style="padding: 10px 24px; background: #3b82f6; color: white; border-radius: 8px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-house"></i> Về Trang chủ
            </a>
            <a href="/Game" style="padding: 10px 24px; background: #334155; color: white; border-radius: 8px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-chess-board"></i> Vào Sàn đấu
            </a>
        </div>
    </div>
</div>
