@model IReadOnlyList<ChessCore.Services.ModeStatistics>
@{ bool admin = ViewData["AdminStatistics"] as bool? == true; }

<div class="stats-table-wrapper" style="overflow-x: auto; margin: 16px 0; border: 1px solid var(--border-color); border-radius: 12px; background: var(--bg-navy-dark);">
    <table class="mode-stats-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
        <thead>
            <tr style="background: var(--bg-navy-panel); border-bottom: 2px solid var(--border-color); color: var(--text-muted); font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.5px;">
                <th style="padding: 12px 16px; font-weight: 700;">Chế độ</th>
                <th style="padding: 12px 14px; text-align: center;">Đã tạo</th>
                <th style="padding: 12px 14px; text-align: center;">Đang chơi</th>
                <th style="padding: 12px 14px; text-align: center;">Chờ</th>
                <th style="padding: 12px 14px; text-align: center;">Kết thúc</th>
                <th style="padding: 12px 14px; text-align: center; color: #10b981;">@(admin ? "Đỏ thắng" : "Thắng")</th>
                <th style="padding: 12px 14px; text-align: center; color: #ef4444;">@(admin ? "Đen thắng" : "Thua")</th>
                <th style="padding: 12px 14px; text-align: center; color: #f59e0b;">Hòa</th>
                <th style="padding: 12px 16px; text-align: right; font-weight: 700; color: var(--accent-gold);">@(admin ? "Có xếp hạng" : "Tỉ lệ thắng")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr style="border-bottom: 1px solid var(--border-color); transition: background 0.2s;">
                    <td style="padding: 12px 16px; font-weight: 600; color: var(--text-main);">
                        @if (r.Mode == "Online") { <i class="fa-solid fa-globe" style="color: #3b82f6; margin-right: 6px;"></i> }
                        else if (r.Mode == "PvE") { <i class="fa-solid fa-robot" style="color: #10b981; margin-right: 6px;"></i> }
                        else if (r.Mode == "Local") { <i class="fa-solid fa-user-group" style="color: #8b5cf6; margin-right: 6px;"></i> }
                        else { <i class="fa-solid fa-chess-board" style="color: var(--text-muted); margin-right: 6px;"></i> }
                        @r.Label
                    </td>
                    <td style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.Created</td>
                    <td style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.InProgress</td>
                    <td style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.Waiting</td>
                    <td style="padding: 12px 14px; text-align: center; font-weight: 600; color: var(--text-main);">@r.Finished</td>
                    <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: #10b981;">@(admin ? r.RedWins.ToString() : (r.Mode == "Online" || r.Mode == "PvE") ? r.Wins.ToString() : "—")</td>
                    <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: #ef4444;">@(admin ? r.BlackWins.ToString() : (r.Mode == "Online" || r.Mode == "PvE") ? r.Losses.ToString() : "—")</td>
                    <td style="padding: 12px 14px; text-align: center; color: #f59e0b;">@r.Draws</td>
                    <td style="padding: 12px 16px; text-align: right; font-weight: 800; color: var(--accent-gold);">
                        @(admin ? r.RatedFinished.ToString() : (r.Mode == "Online" || r.Mode == "PvE") ? r.WinRate.ToString("0.0") + "%" : "—")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div style="font-size: 12px; color: var(--text-muted); line-height: 1.6; margin-top: 8px;">
    <i class="fa-solid fa-circle-info" style="color: var(--accent-gold); margin-right: 4px;"></i>
    <em>Tỉ lệ thắng = Số trận thắng / Số trận đã kết thúc. Điểm Elo chỉ được cập nhật trong chế độ Online có xếp hạng.</em>
</div>
