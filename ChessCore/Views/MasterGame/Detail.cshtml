@model ChessCore.Models.MasterGame
@{
    ViewData["Title"] = Model.Title;
}

<style>
    .master-detail-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 24px 20px;
        color: var(--text-main);
    }

    .master-detail-card {
        background: var(--bg-navy-panel);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 28px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .master-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 18px;
        margin-bottom: 22px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .master-detail-title {
        color: var(--text-main);
        font-size: 22px;
        font-weight: 800;
        margin: 0 0 6px 0;
    }

    .master-pgn-box {
        background: var(--bg-navy-dark);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 18px 20px;
        font-family: 'Consolas', 'Courier New', monospace;
        color: var(--text-main);
        font-size: 13.5px;
        line-height: 1.8;
        white-space: pre-wrap;
        margin-bottom: 24px;
    }

    .master-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .info-item {
        background: var(--bg-navy-dark);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 14px 16px;
    }

    .info-item label {
        display: block;
        color: var(--text-muted);
        font-size: 12px;
        margin-bottom: 4px;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .info-item span {
        color: var(--text-main);
        font-size: 15px;
        font-weight: 700;
    }

    .btn-back-link {
        color: var(--text-muted);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 14px;
        transition: color 0.2s;
    }

    .btn-back-link:hover {
        color: var(--accent-gold);
    }

    .btn-play-link {
        padding: 10px 22px;
        background: var(--accent-gold);
        color: #ffffff;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }

    .btn-play-link:hover {
        background: var(--accent-gold-dark);
        color: #ffffff;
        transform: translateY(-1px);
    }
</style>

<div class="master-detail-container">
    <div style="margin-bottom: 16px;">
        <a href="/MasterGame" class="btn-back-link">
            <i class="fa-solid fa-arrow-left"></i> Quay lại Danh sách Kỳ phổ
        </a>
    </div>

    <div class="master-detail-card">
        <div class="master-detail-header">
            <div>
                <h1 class="master-detail-title">@Model.Title</h1>
                <div style="color: var(--accent-gold); font-size: 13.5px; font-weight: 600;">
                    <i class="fa-solid fa-trophy"></i> @Model.Event @(Model.EventDate.HasValue ? $"({Model.EventDate.Value.ToString("dd/MM/yyyy")})" : "")
                </div>
            </div>
            <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); color: #10b981; padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 13.5px;">
                Kết quả: @Model.Result
            </div>
        </div>

        <div class="master-info-grid">
            <div class="info-item">
                <label>Bên Tiên (Đỏ)</label>
                <span style="color: #c00000;"><i class="fa-solid fa-circle" style="font-size: 8px;"></i> @Model.RedPlayer</span>
            </div>
            <div class="info-item">
                <label>Bên Hậu (Đen)</label>
                <span style="color: var(--text-main);"><i class="fa-regular fa-circle" style="font-size: 8px;"></i> @Model.BlackPlayer</span>
            </div>
            <div class="info-item">
                <label>Thế trận Khai cuộc</label>
                <span style="color: var(--accent-gold);">@(Model.OpeningName ?? "Khai cuộc kinh điển")</span>
            </div>
        </div>

        <h3 style="color: var(--text-main); font-size: 15px; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-file-code" style="color: var(--accent-gold);"></i> Biên bản ván đấu (PGN & Nước đi)
        </h3>

        <div class="master-pgn-box">@(string.IsNullOrEmpty(Model.PgnContent) ? "Biên bản ván đấu đang được số hóa." : Model.PgnContent)</div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <a href="/Game" class="btn-play-link">
                <i class="fa-solid fa-chess-board"></i> Thực chiến tại Bàn cờ
            </a>
        </div>
    </div>
</div>
