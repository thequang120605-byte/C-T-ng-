@model ChessCore.Models.MasterGame
@{
    ViewData["Title"] = Model.Title;
}

<style>
    .master-detail-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 24px 20px;
    }

    .master-detail-card {
        background: radial-gradient(circle at top, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.98));
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.5);
    }

    .master-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 20px;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .master-detail-title {
        color: #f8fafc;
        font-size: 24px;
        font-weight: 800;
        margin: 0 0 8px 0;
    }

    .master-pgn-box {
        background: #090d16;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 20px;
        font-family: 'Consolas', 'Courier New', monospace;
        color: #38bdf8;
        font-size: 14px;
        line-height: 1.8;
        white-space: pre-wrap;
        margin-bottom: 24px;
    }

    .master-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .info-item {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 12px;
        padding: 16px;
    }

    .info-item label {
        display: block;
        color: #94a3b8;
        font-size: 12px;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item span {
        color: #f8fafc;
        font-size: 15px;
        font-weight: 600;
    }
</style>

<div class="master-detail-container">
    <div style="margin-bottom: 16px;">
        <a href="/MasterGame" style="color: #94a3b8; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; font-weight: 500;">
            <i class="fa-solid fa-arrow-left"></i> Quay lại Danh sách Kỳ phổ
        </a>
    </div>

    <div class="master-detail-card">
        <div class="master-detail-header">
            <div>
                <h1 class="master-detail-title">@Model.Title</h1>
                <div style="color: var(--accent-gold); font-size: 14px; font-weight: 600;">
                    <i class="fa-solid fa-trophy"></i> @Model.Event @(Model.EventDate.HasValue ? $"({Model.EventDate.Value.ToString("dd/MM/yyyy")})" : "")
                </div>
            </div>
            <div style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); color: #22c55e; padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 14px;">
                Kết quả: @Model.Result
            </div>
        </div>

        <div class="master-info-grid">
            <div class="info-item">
                <label>Bên Tiên (Đỏ)</label>
                <span style="color: #ef4444;"><i class="fa-solid fa-circle" style="font-size: 10px;"></i> @Model.RedPlayer</span>
            </div>
            <div class="info-item">
                <label>Bên Hậu (Đen)</label>
                <span style="color: #94a3b8;"><i class="fa-regular fa-circle" style="font-size: 10px;"></i> @Model.BlackPlayer</span>
            </div>
            <div class="info-item">
                <label>Thế trận Khai cuộc</label>
                <span style="color: var(--accent-gold);">@(Model.OpeningName ?? "Khai cuộc kinh điển")</span>
            </div>
        </div>

        <h3 style="color: #f8fafc; font-size: 16px; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-file-code" style="color: #38bdf8;"></i> Biên bản ván đấu (PGN & Nước đi)
        </h3>

        <div class="master-pgn-box">@(string.IsNullOrEmpty(Model.PgnContent) ? "Biên bản ván đấu đang được số hóa." : Model.PgnContent)</div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <a href="/Game" style="padding: 10px 20px; background: linear-gradient(135deg, #d4af37, #b45309); color: #0f172a; border-radius: 10px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-chess-board"></i> Thực chiến tại Kỳ đài
            </a>
        </div>
    </div>
</div>
