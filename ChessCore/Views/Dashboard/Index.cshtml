@model ChessCore.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Thống kê";
    var rankedModes = Model.ModeStats?.Where(m => m.Mode == "Online" || m.Mode == "PvE").ToList() ?? new List<ChessCore.Services.ModeStatistics>();
    int totalWins = rankedModes.Sum(m => m.Wins);
    int totalLosses = rankedModes.Sum(m => m.Losses);
    int totalDraws = Model.ModeStats?.Sum(m => m.Draws) ?? 0;
    int totalRankedFinished = rankedModes.Sum(m => m.Finished);
    double avgWinRate = totalRankedFinished > 0 ? Math.Round((double)totalWins * 100.0 / totalRankedFinished, 1) : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        @@keyframes pulseHighlight {
            0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.8); border-color: var(--accent-gold); }
            50% { box-shadow: 0 0 0 12px rgba(212, 175, 55, 0); border-color: var(--accent-gold); background: rgba(212, 175, 55, 0.15); }
            100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }
        }
        .highlight-pulse {
            animation: pulseHighlight 1.2s ease-in-out 2 !important;
            border-color: var(--accent-gold) !important;
        }
        .btn-adv-filter-action {
            background: var(--bg-navy-dark);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.15s ease;
        }
        .btn-adv-filter-action:hover {
            background: rgba(217, 119, 6, 0.15);
            border-color: var(--accent-gold);
            color: var(--accent-gold-dark, #b45309);
        }
        .account-check-card {
            user-select: none;
            transition: all 0.15s ease;
        }
        .account-check-card:hover {
            border-color: var(--accent-gold) !important;
            transform: translateY(-1px);
        }
        .account-check-card.checked-card {
            border-color: var(--accent-gold) !important;
            background: rgba(217, 119, 6, 0.08) !important;
        }
        .stat-wdl-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(0, 0, 0, 0.04);
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
        }
        .wdl-w { color: #10b981; }
        .wdl-d { color: #d97706; }
        .wdl-l { color: #ef4444; }
    </style>
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 data-i18n="menu_stats"><i class="fa-solid fa-chart-pie"></i> Bảng điều khiển</h1>
        <div style="background: rgba(212,175,55,0.1); color: var(--accent-gold); padding: 8px 15px; border-radius: 8px; font-weight: bold; border: 1px solid rgba(212,175,55,0.3);">
            <i class="fa-solid fa-trophy"></i> Hạng: @Model.RankIndex
        </div>
    </div>

    <!-- KHU VỰC THỐNG KÊ NÂNG CAO (CHỌN TÀI KHOẢN ĐỂ XEM THỐNG KÊ) -->
    <div class="panel-box advanced-stats-panel" style="margin-bottom: 24px; padding: 20px 24px; background: var(--bg-navy-panel); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(59, 130, 246, 0.12); color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fa-solid fa-users-viewfinder"></i>
                </div>
                <div>
                    <h2 style="margin: 0; font-size: 17px; font-weight: 800; color: var(--text-main);">
                        Thống kê nâng cao theo tài khoản
                    </h2>
                    <span style="font-size: 12.5px; color: var(--text-muted);">
                        Chọn các tài khoản bằng checkbox để xem thống kê tổng hợp và đối chiếu so sánh chi tiết
                    </span>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <span id="advSelectedBadge" style="background: rgba(217, 119, 6, 0.12); color: var(--accent-gold-dark, #b45309); font-weight: 700; font-size: 12.5px; padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(217, 119, 6, 0.3); display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fa-solid fa-user-check"></i> Đang xem: <b id="advBadgeText">Cá nhân (@Model.CurrentUser.Username)</b>
                </span>
                <button type="button" id="btnToggleAccountList" onclick="toggleAccountList()" style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); color: var(--text-main); padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fa-solid fa-chevron-down" id="toggleAccountListIcon"></i> <span id="toggleAccountListText">Danh sách tài khoản</span>
                </button>
            </div>
        </div>

        <!-- DANH SÁCH CHECKBOX TÀI KHOẢN -->
        <div id="accountListContainer" style="display: block;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap;">
                <div style="position: relative; flex: 1; min-width: 240px; max-width: 360px;">
                    <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 13px;"></i>
                    <input type="text" id="accountSearchInput" oninput="filterAccountsList()" placeholder="Tìm tên kỳ thủ, ID..." style="width: 100%; padding: 7px 12px 7px 34px; font-size: 13px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-navy-dark); color: var(--text-main); outline: none;" />
                </div>
                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                    <button type="button" onclick="selectOnlyMe()" class="btn-adv-filter-action" title="Chỉ xem thống kê tài khoản của bạn">
                        <i class="fa-solid fa-user"></i> Chỉ tôi
                    </button>
                    <button type="button" onclick="selectTopAccounts(3)" class="btn-adv-filter-action" title="Chọn Top 3 kỳ thủ Elo cao nhất">
                        <i class="fa-solid fa-trophy" style="color: #f59e0b;"></i> Top 3
                    </button>
                    <button type="button" onclick="selectTopAccounts(5)" class="btn-adv-filter-action" title="Chọn Top 5 kỳ thủ Elo cao nhất">
                        <i class="fa-solid fa-ranking-star" style="color: #3b82f6;"></i> Top 5
                    </button>
                    <button type="button" onclick="selectAllAccounts()" class="btn-adv-filter-action" title="Chọn tất cả tài khoản">
                        <i class="fa-solid fa-check-double"></i> Chọn tất cả
                    </button>
                    <button type="button" onclick="clearAllAccounts()" class="btn-adv-filter-action" title="Bỏ chọn toàn bộ">
                        <i class="fa-solid fa-xmark"></i> Bỏ chọn
                    </button>
                </div>
            </div>

            <!-- GRID TÀI KHOẢN VỚI CHECKBOX -->
            <div id="accountCheckboxGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; max-height: 220px; overflow-y: auto; padding: 6px; border: 1px solid var(--border-color); border-radius: 10px; background: var(--bg-navy-dark);">
                @foreach (var acc in Model.AllAccounts)
                {
                    var isMe = acc.IsCurrentUser;
                    var tierColor = acc.Elo >= 1500 ? "#ec4899" : (acc.Elo >= 1400 ? "#8b5cf6" : (acc.Elo >= 1250 ? "#3b82f6" : (acc.Elo >= 1150 ? "#10b981" : "#f59e0b")));
                    <label class="account-check-card @(isMe ? "checked-card" : "")" id="acc-card-@acc.Id" style="display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-navy-panel); cursor: pointer; transition: all 0.15s ease;">
                        <input type="checkbox" class="acc-checkbox" value="@acc.Id" data-username="@acc.Username" data-elo="@acc.Elo" data-isme="@(isMe ? "true" : "false")" @(isMe ? "checked" : "") onchange="onAccountCheckChange()" style="width: 16px; height: 16px; cursor: pointer; accent-color: var(--accent-gold);" />
                        <div style="width: 28px; height: 28px; border-radius: 6px; background: rgba(212,175,55,0.1); color: var(--accent-gold); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 11px;">
                            @(acc.Rank <= 3 ? (acc.Rank == 1 ? "🥇" : (acc.Rank == 2 ? "🥈" : "🥉")) : $"#{acc.Rank}")
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-weight: 700; font-size: 13px; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @acc.Username @(isMe ? "(Bạn)" : "")
                            </div>
                            <div style="font-size: 11px; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                                <span style="color: var(--accent-gold); font-weight: 700;"><i class="fa-solid fa-star" style="font-size: 9px;"></i> @acc.Elo</span>
                                <span>•</span>
                                <span style="color: @tierColor; font-weight: 600;">@acc.Title</span>
                            </div>
                        </div>
                    </label>
                }
            </div>
            <div id="advSearchEmpty" style="display: none; text-align: center; padding: 16px; color: var(--text-muted); font-size: 13px;">
                Không tìm thấy tài khoản phù hợp với từ khóa.
            </div>
        </div>
    </div>

    <!-- STATS GRID -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="fa-solid fa-star"></i></div>
            <div class="stat-info">
                <h3 id="kpiEloTitle">ĐIỂM ELO</h3>
                <p class="stat-value" id="kpiEloValue">@Model.CurrentUser.Elo</p>
                <span id="kpiEloSub" class="stat-sub">Hạng #@Model.RankIndex · Điểm xếp hạng</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: #10b981; background: rgba(16,185,129,0.1);"><i class="fa-solid fa-medal"></i></div>
            <div class="stat-info">
                <h3 id="kpiWinRateTitle">TỈ LỆ THẮNG</h3>
                <p class="stat-value" id="kpiWinRateValue">@Model.WinRate%</p>
                <span id="kpiWinRateSub" class="stat-sub">Ván hoàn tất</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: #3b82f6; background: rgba(59,130,246,0.1);"><i class="fa-solid fa-chess"></i></div>
            <div class="stat-info">
                <h3 id="kpiGamesTitle">TỔNG SỐ TRẬN</h3>
                <p class="stat-value" id="kpiGamesValue">@Model.CurrentUser.GamesPlayed</p>
                <span id="kpiGamesSub" class="stat-sub">Tổng ván đã tham gia</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: #f59e0b; background: rgba(245,158,11,0.1);"><i class="fa-solid fa-puzzle-piece"></i></div>
            <div class="stat-info">
                <h3 id="kpiPuzzlesTitle">CỜ THẾ ĐÃ GIẢI</h3>
                <p class="stat-value" id="kpiPuzzlesValue">@Model.PuzzlesSolved</p>
                <span id="kpiPuzzlesSub" class="stat-sub">Bài thế giải thành công</span>
            </div>
        </div>
    </div>

    <!-- BẢNG THỐNG KÊ THEO CHẾ ĐỘ CHƠI (HIỆN ĐẠI & CHUYÊN NGHIỆP) -->
    <div class="panel-box" style="margin-bottom: 24px; padding: 22px 24px; background: var(--bg-navy-panel); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 14px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(217, 119, 6, 0.12); color: var(--accent-gold); display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fa-solid fa-list-check"></i>
                </div>
                <div>
                    <h2 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-main);">Thống kê ván đấu theo chế độ</h2>
                    <span style="font-size: 12.5px; color: var(--text-muted);">Chi tiết số lượng ván đấu, kết quả và tỉ lệ thắng theo từng hình thức thi đấu</span>
                </div>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <a id="btnExportExcel" href="/Dashboard/ExportExcel" style="padding: 9px 18px; background: linear-gradient(135deg, #10b981, #059669); color: #ffffff; border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 3px 10px rgba(16, 185, 129, 0.25); transition: all 0.2s;" title="Tải file bảng tính Excel .xlsx định dạng chuẩn đẹp">
                    <i class="fa-solid fa-file-excel" style="font-size: 15px;"></i> Tải báo cáo Excel
                </a>
                <a id="btnExportCsv" href="/Dashboard/Export" style="padding: 9px 14px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.25); color: #3b82f6; border-radius: 8px; font-size: 12px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;" title="Tải file dữ liệu CSV">
                    <i class="fa-solid fa-file-csv" style="font-size: 14px;"></i> CSV
                </a>
            </div>
        </div>

        <div style="overflow-x: auto; border: 1px solid var(--border-color); border-radius: 10px; background: var(--bg-navy-dark);">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                <thead>
                    <tr style="background: var(--bg-navy-panel); border-bottom: 2px solid var(--border-color); color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                        <th style="padding: 12px 18px; font-weight: 700;">Chế độ thi đấu</th>
                        <th style="padding: 12px 14px; text-align: center;">Đã tạo</th>
                        <th style="padding: 12px 14px; text-align: center;">Đang chơi</th>
                        <th style="padding: 12px 14px; text-align: center;">Chờ đấu</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-main);">Kết thúc</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: #10b981;">Thắng</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: #ef4444;">Thua</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: #f59e0b;">Hòa</th>
                        <th style="padding: 12px 18px; text-align: right; font-weight: 800; color: var(--accent-gold);">Tỉ lệ thắng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ModeStats != null && Model.ModeStats.Any())
                    {
                        int pSumCreated = 0, pSumInProgress = 0, pSumWaiting = 0, pSumFinished = 0;
                        int pSumWins = 0, pSumLosses = 0, pSumDraws = 0;
                        foreach (var r in Model.ModeStats)
                        {
                            pSumCreated += r.Created;
                            pSumInProgress += r.InProgress;
                            pSumWaiting += r.Waiting;
                            pSumFinished += r.Finished;
                            if (r.Mode == "Online" || r.Mode == "PvE")
                            {
                                pSumWins += r.Wins;
                                pSumLosses += r.Losses;
                            }
                            pSumDraws += r.Draws;
                            <tr id="mode-row-@r.Mode" style="border-bottom: 1px solid var(--border-color); transition: background 0.15s ease;" onmouseover="this.style.background='var(--bg-navy-light)'" onmouseout="this.style.background='transparent'">
                                <td style="padding: 12px 18px; font-weight: 700; color: var(--text-main);">
                                    @if (r.Mode == "Online") { <i class="fa-solid fa-earth-americas" style="color: #3b82f6; margin-right: 8px;" title="Online"></i> }
                                    else if (r.Mode == "PvE") { <i class="fa-solid fa-robot" style="color: #10b981; margin-right: 8px;" title="Chơi với máy"></i> }
                                    else if (r.Mode == "PvP" || r.Mode == "Local") { <i class="fa-solid fa-user-group" style="color: #8b5cf6; margin-right: 8px;" title="Hai người cùng máy"></i> }
                                    else if (r.Mode == "AiVsAi") { <i class="fa-solid fa-microchip" style="color: #ec4899; margin-right: 8px;" title="Máy với máy"></i> }
                                    else { <i class="fa-solid fa-chess" style="color: var(--accent-gold); margin-right: 8px;"></i> }
                                    @r.Label
                                </td>
                                <td class="col-created" style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.Created</td>
                                <td class="col-inprogress" style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.InProgress</td>
                                <td class="col-waiting" style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.Waiting</td>
                                <td class="col-finished" style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-main);">@r.Finished</td>
                                <td class="col-wins" style="padding: 12px 14px; text-align: center; font-weight: 700; color: #10b981;">@((r.Mode == "Online" || r.Mode == "PvE") ? r.Wins.ToString() : "—")</td>
                                <td class="col-losses" style="padding: 12px 14px; text-align: center; font-weight: 700; color: #ef4444;">@((r.Mode == "Online" || r.Mode == "PvE") ? r.Losses.ToString() : "—")</td>
                                <td class="col-draws" style="padding: 12px 14px; text-align: center; font-weight: 600; color: #f59e0b;">@r.Draws</td>
                                <td class="col-winrate" style="padding: 12px 18px; text-align: right; font-weight: 800; color: var(--accent-gold);">
                                    @((r.Mode == "Online" || r.Mode == "PvE") ? r.WinRate.ToString("0.0") + "%" : "—")
                                </td>
                            </tr>
                        }
                        int pFinishedRanked = Model.ModeStats.Where(m => m.Mode == "Online" || m.Mode == "PvE").Sum(m => m.Finished);
                        double pAvgWinRate = pFinishedRanked > 0 ? Math.Round((double)pSumWins * 100.0 / pFinishedRanked, 1) : 0;
                        <tr id="mode-row-total" style="background: rgba(217, 119, 6, 0.08); font-weight: 700; border-top: 2px solid var(--border-color);">
                            <td style="padding: 14px 18px; color: var(--text-main);">
                                <i class="fa-solid fa-calculator" style="color: var(--accent-gold); margin-right: 8px;"></i> TỔNG CỘNG THÀNH TÍCH
                            </td>
                            <td id="tot-created" style="padding: 14px 14px; text-align: center; color: var(--text-main);">@pSumCreated</td>
                            <td id="tot-inprogress" style="padding: 14px 14px; text-align: center; color: var(--text-main);">@pSumInProgress</td>
                            <td id="tot-waiting" style="padding: 14px 14px; text-align: center; color: var(--text-main);">@pSumWaiting</td>
                            <td id="tot-finished" style="padding: 14px 14px; text-align: center; color: var(--text-main); font-weight: 800;">@pSumFinished</td>
                            <td id="tot-wins" style="padding: 14px 14px; text-align: center; color: #10b981; font-weight: 800;">@pSumWins</td>
                            <td id="tot-losses" style="padding: 14px 14px; text-align: center; color: #ef4444; font-weight: 800;">@pSumLosses</td>
                            <td id="tot-draws" style="padding: 14px 14px; text-align: center; color: #f59e0b; font-weight: 800;">@pSumDraws</td>
                            <td id="tot-winrate" style="padding: 14px 18px; text-align: right; color: var(--accent-gold-dark, #b45309); font-weight: 900; font-size: 14px;">
                                @pAvgWinRate.ToString("0.0")%
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="font-size: 12px; color: var(--text-muted); line-height: 1.6; margin-top: 12px;">
            <i class="fa-solid fa-circle-info" style="color: var(--accent-gold); margin-right: 4px;"></i>
            <em>Tỉ lệ thắng = Số ván thắng / Số ván đã hoàn thành. Điểm Elo xếp hạng chỉ được áp dụng trong chế độ PvP Online.</em>
        </div>

        <!-- THỐNG KÊ TIẾN ĐỘ HỌC TẬP & CỜ THẾ -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-top: 18px; padding-top: 16px; border-top: 1px dashed var(--border-color);">
            <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px 18px; display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(16, 185, 129, 0.12); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <div style="font-size: 11.5px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Tiến độ Khóa học</div>
                    <div id="learningCompletedLessons" style="font-size: 15px; font-weight: 800; color: var(--text-main); margin-top: 2px;">
                        @Model.Learning.CompletedLessonRecords / @Model.Learning.TotalLessons bài hoàn thành
                    </div>
                    <div id="learningQuizDetails" style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
                        @Model.Learning.QuizAttempts lượt làm Quiz · Điểm trung bình: <strong style="color: #10b981;">@Model.Learning.AverageBestQuizScore%</strong>
                    </div>
                </div>
            </div>

            <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px 18px; display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(245, 158, 11, 0.12); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="fa-solid fa-puzzle-piece"></i>
