@model ChessCore.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Thống kê";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 data-i18n="menu_stats"><i class="fa-solid fa-chart-pie"></i> Bảng điều khiển</h1>
        <div style="background: rgba(212,175,55,0.1); color: var(--accent-gold); padding: 8px 15px; border-radius: 8px; font-weight: bold; border: 1px solid rgba(212,175,55,0.3);">
            <i class="fa-solid fa-trophy"></i> Hạng: @Model.RankIndex
        </div>
    </div>

    <!-- STATS GRID -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="fa-solid fa-star"></i></div>
            <div class="stat-info">
                <h3>ĐIỂM ELO</h3>
                <p class="stat-value">@Model.CurrentUser.Elo</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: #10b981; background: rgba(16,185,129,0.1);"><i class="fa-solid fa-medal"></i></div>
            <div class="stat-info">
                <h3>TỈ LỆ THẮNG</h3>
                <p class="stat-value">@Model.WinRate%</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: #3b82f6; background: rgba(59,130,246,0.1);"><i class="fa-solid fa-chess"></i></div>
            <div class="stat-info">
                <h3>TỔNG SỐ TRẬN</h3>
                <p class="stat-value">@Model.CurrentUser.GamesPlayed</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: #f59e0b; background: rgba(245,158,11,0.1);"><i class="fa-solid fa-puzzle-piece"></i></div>
            <div class="stat-info">
                <h3>CỜ THẾ ĐÃ GIẢI</h3>
                <p class="stat-value">@Model.PuzzlesSolved</p>
            </div>
        </div>
    </div>

    <!-- BẢNG THỐNG KÊ THEO CHẾ ĐỘ CHƠI (HIỆN ĐẠI & CHUYÊN NGHIỆP) -->
    <div class="panel-box" style="margin-bottom: 24px; padding: 22px 24px; background: var(--bg-navy-panel); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 14px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(217, 119, 6, 0.12); color: var(--accent-gold); display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fa-solid fa-list-check"></i>
                </div>
                <div>
                    <h2 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text-main);">Thống kê ván đấu theo chế độ</h2>
                    <span style="font-size: 12.5px; color: var(--text-muted);">Chi tiết số lượng ván đấu, kết quả và tỉ lệ thắng theo từng hình thức thi đấu</span>
                </div>
            </div>
            <a href="/Dashboard/Export" style="padding: 9px 18px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); color: #3b82f6; border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s;">
                <i class="fa-solid fa-file-arrow-down"></i> Tải báo cáo CSV
            </a>
        </div>

        <div style="overflow-x: auto; border: 1px solid var(--border-color); border-radius: 10px; background: var(--bg-navy-dark);">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                <thead>
                    <tr style="background: var(--bg-navy-panel); border-bottom: 2px solid var(--border-color); color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                        <th style="padding: 12px 18px; font-weight: 700;">Chế độ thi đấu</th>
                        <th style="padding: 12px 14px; text-align: center;">Đã tạo</th>
                        <th style="padding: 12px 14px; text-align: center;">Đang chơi</th>
                        <th style="padding: 12px 14px; text-align: center;">Chờ đấu</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-main);">Kết thúc</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: #10b981;">Thắng</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: #ef4444;">Thua</th>
                        <th style="padding: 12px 14px; text-align: center; font-weight: 700; color: #f59e0b;">Hòa</th>
                        <th style="padding: 12px 18px; text-align: right; font-weight: 800; color: var(--accent-gold);">Tỉ lệ thắng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ModeStats != null && Model.ModeStats.Any())
                    {
                        foreach (var r in Model.ModeStats)
                        {
                            <tr style="border-bottom: 1px solid var(--border-color);">
                                <td style="padding: 12px 18px; font-weight: 700; color: var(--text-main);">
                                    @if (r.Mode == "Online") { <i class="fa-solid fa-earth-americas" style="color: #3b82f6; margin-right: 8px;" title="Online"></i> }
                                    else if (r.Mode == "PvE") { <i class="fa-solid fa-robot" style="color: #10b981; margin-right: 8px;" title="Chơi với máy"></i> }
                                    else if (r.Mode == "PvP" || r.Mode == "Local") { <i class="fa-solid fa-user-group" style="color: #8b5cf6; margin-right: 8px;" title="Hai người cùng máy"></i> }
                                    else if (r.Mode == "AiVsAi") { <i class="fa-solid fa-microchip" style="color: #ec4899; margin-right: 8px;" title="Máy với máy"></i> }
                                    else { <i class="fa-solid fa-box-archive" style="color: #f59e0b; margin-right: 8px;" title="Dữ liệu cũ / chưa xác định"></i> }
                                    @r.Label
                                </td>
                                <td style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.Created</td>
                                <td style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.InProgress</td>
                                <td style="padding: 12px 14px; text-align: center; color: var(--text-muted);">@r.Waiting</td>
                                <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-main);">@r.Finished</td>
                                <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: #10b981;">@((r.Mode == "Online" || r.Mode == "PvE") ? r.Wins.ToString() : "—")</td>
                                <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: #ef4444;">@((r.Mode == "Online" || r.Mode == "PvE") ? r.Losses.ToString() : "—")</td>
                                <td style="padding: 12px 14px; text-align: center; font-weight: 600; color: #f59e0b;">@r.Draws</td>
                                <td style="padding: 12px 18px; text-align: right; font-weight: 800; color: var(--accent-gold);">
                                    @((r.Mode == "Online" || r.Mode == "PvE") ? r.WinRate.ToString("0.0") + "%" : "—")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div style="font-size: 12px; color: var(--text-muted); line-height: 1.6; margin-top: 12px;">
            <i class="fa-solid fa-circle-info" style="color: var(--accent-gold); margin-right: 4px;"></i>
            <em>Tỉ lệ thắng = Số ván thắng / Số ván đã hoàn thành. Điểm Elo xếp hạng chỉ được áp dụng trong chế độ PvP Online.</em>
        </div>

        <!-- THỐNG KÊ TIẾN ĐỘ HỌC TẬP & CỜ THẾ -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-top: 18px; padding-top: 16px; border-top: 1px dashed var(--border-color);">
            <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px 18px; display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(16, 185, 129, 0.12); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <div style="font-size: 11.5px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Tiến độ Khóa học</div>
                    <div style="font-size: 15px; font-weight: 800; color: var(--text-main); margin-top: 2px;">
                        @Model.Learning.CompletedLessonRecords / @Model.Learning.TotalLessons bài hoàn thành
                    </div>
                    <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
                        @Model.Learning.QuizAttempts lượt làm Quiz · Điểm trung bình: <strong style="color: #10b981;">@Model.Learning.AverageBestQuizScore%</strong>
                    </div>
                </div>
            </div>

            <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px 18px; display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(245, 158, 11, 0.12); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="fa-solid fa-puzzle-piece"></i>
                </div>
                <div>
                    <div style="font-size: 11.5px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Tiến độ Cờ Thế</div>
                    <div style="font-size: 15px; font-weight: 800; color: var(--text-main); margin-top: 2px;">
                        @Model.Learning.PuzzlesSolved bài giải thành công
                    </div>
                    <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
                        Tổng @Model.Learning.PuzzleAttempts lượt gửi lời giải · Điểm phiên rèn luyện
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CỤM BIỂU ĐỒ TRỰC QUAN HÓA (CHART.JS) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px; margin-bottom: 24px;">
        <!-- BIỂU ĐỒ 1: TỈ LỆ THẮNG - THUA - HÒA (DOUGHNUT CHART VỚI BADGE TRUNG TÂM) -->
        <div class="panel-box" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
                <h2 class="panel-title" style="margin: 0; font-size: 16px;">
                    <i class="fa-solid fa-chart-pie" style="color: #10b981;"></i> Phân bố kết quả trận đấu
                </h2>
                <!-- SELECT LỌC THEO CHẾ ĐỘ CHƠI CHO BIỂU ĐỒ TRÒN -->
                <select id="donutModeFilter" onchange="onDonutFilterChange()" style="background: var(--bg-navy-dark); color: #1e293b; border: 1px solid var(--border-color); border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 700; cursor: pointer; outline: none;">
                    <option value="ALL">Tất cả chế độ</option>
                    @if (Model.ModeStats != null)
                    {
                        foreach (var m in Model.ModeStats)
                        {
                            <option value="@m.Mode">@m.Label</option>
                        }
                    }
                </select>
            </div>
            
            <div style="position: relative; width: 100%; height: 210px; display: flex; align-items: center; justify-content: center;">
                <canvas id="outcomeDonutChart"></canvas>
                <!-- Badge hiển thị số liệu nổi bật ngay chính giữa vòng tròn -->
                <div style="position: absolute; text-align: center; pointer-events: none; transform: translateY(-14px);">
                    <div id="donutWinRateValue" style="font-size: 26px; font-weight: 900; color: #b45309; line-height: 1.1;">
                        @Model.WinRate%
                    </div>
                    <div style="font-size: 11px; font-weight: 800; color: #334155; text-transform: uppercase; letter-spacing: 0.5px;">
                        Tỉ lệ thắng
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-color);">
                <div style="text-align: center; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="color: #334155; font-size: 11px; display: block; font-weight: 800;">THẮNG</span>
                    <strong id="donutWinsCount" style="color: #10b981; font-size: 18px; font-weight: 800;">@Model.CurrentUser.Wins</strong>
                </div>
                <div style="text-align: center; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="color: #334155; font-size: 11px; display: block; font-weight: 800;">HÒA</span>
                    <strong id="donutDrawsCount" style="color: #d97706; font-size: 18px; font-weight: 800;">@Model.CurrentUser.Draws</strong>
                </div>
                <div style="text-align: center; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="color: #334155; font-size: 11px; display: block; font-weight: 800;">THUA</span>
                    <strong id="donutLossesCount" style="color: #ef4444; font-size: 18px; font-weight: 800;">@Model.CurrentUser.Losses</strong>
                </div>
            </div>
        </div>

        <!-- BIỂU ĐỒ 2: SO SÁNH CÁC CHẾ ĐỘ CHƠI (HORIZONTAL BAR CHART GỌN GÀNG) -->
        <div class="panel-box" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h2 class="panel-title" style="margin: 0; font-size: 16px;">
                    <i class="fa-solid fa-chart-column" style="color: #3b82f6;"></i> Ván đấu theo chế độ
                </h2>
                <span style="font-size: 12px; font-weight: 700; color: #1e293b; background: rgba(0, 0, 0, 0.05); padding: 4px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                    Toàn bộ 5 chế độ thi đấu
                </span>
            </div>
            <div style="position: relative; width: 100%; height: 260px;">
                <canvas id="modeCompareChart"></canvas>
            </div>
        </div>
    </div>

    <!-- ELO RATING GRAPH PANEL -->
    <div class="panel-box" style="margin-bottom: 24px; padding: 20px 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
            <h2 class="panel-title" style="margin: 0;">
                <i class="fa-solid fa-chart-line" style="color: var(--accent-gold);"></i> Biểu đồ phong độ Elo
            </h2>
            <div style="font-size: 13px; color: var(--text-muted); display: flex; align-items: center; gap: 12px;">
                <span><i class="fa-solid fa-circle" style="color: #3b82f6; font-size: 8px;"></i> Elo ván đấu</span>
                <span style="font-weight: 600; color: #10b981;">Hiện tại: @Model.CurrentUser.Elo</span>
            </div>
        </div>
        <div style="position: relative; width: 100%; height: 220px;">
            <canvas id="eloRatingChart"></canvas>
        </div>
        @if (Model.EloHistory.Count <= 1)
        {
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 10px; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-circle-info" style="color: #3b82f6;"></i>
                <span>Đang hiển thị mốc Elo khởi đầu. Tham gia thêm các ván đấu <strong>PvP Online</strong> để theo dõi biến động phong độ chi tiết.</span>
            </div>
        }
    </div>

    <div class="dashboard-content">
        <!-- MATCH HISTORY -->
        <div class="panel-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                <h2 class="panel-title" style="margin: 0;"><i class="fa-solid fa-clock-rotate-left"></i> Lịch sử đấu gần đây</h2>
                <!-- SELECT LỌC THEO CHẾ ĐỘ CHƠI CHO LỊCH SỬ ĐẤU -->
                <div style="display: flex; align-items: center; gap: 8px;">
                    <label for="historyModeFilter" style="font-size: 12.5px; font-weight: 700; color: #334155;">Chế độ:</label>
                    <select id="historyModeFilter" onchange="filterHistoryByMode()" style="background: var(--bg-navy-dark); color: #1e293b; border: 1px solid var(--border-color); border-radius: 6px; padding: 5px 12px; font-size: 12.5px; font-weight: 700; cursor: pointer; outline: none;">
                        <option value="ALL">Tất cả chế độ</option>
                        @if (Model.ModeStats != null)
                        {
                            foreach (var m in Model.ModeStats)
                            {
                                <option value="@m.Label">@m.Label</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="history-list" id="history-list-container">
                @if (Model.RecentGames.Any())
                {
                    var index = 0;
                    foreach (var game in Model.RecentGames)
                    {
                        <a href="/Game/Review/@game.GameId" class="history-item @game.Result match-row" data-index="@index" data-mode="@game.GameMode" style="text-decoration: none; cursor: pointer; display: none;" title="Nhấn để xem chi tiết phân tích ván đấu">
                            <div class="history-main">
                                <div class="history-opp">
                                    vs. @game.OpponentName 
                                    @if (game.OpponentElo.HasValue)
                                    {
                                        <span class="history-elo-badge" title="Elo thực tế của đối thủ">(Elo: @game.OpponentElo.Value)</span>
                                    }
                                    <span class="history-mode-tag">@game.GameMode</span>
                                </div>
                                <div class="history-meta">
                                    <span><i class="fa-regular fa-calendar"></i> @game.PlayedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    <span><i class="fa-solid fa-chess-board"></i> @game.TotalMoves nước</span>
                                    <span style="color: var(--text-muted);"><i class="fa-solid fa-star" style="color: var(--accent-gold); font-size: 11px;"></i> Elo của bạn: <strong style="color: var(--accent-gold);">@game.PlayerElo</strong></span>
                                    <span class="history-review-hint"><i class="fa-solid fa-magnifying-glass-chart"></i> Phân tích ván đấu</span>
                                </div>
                            </div>
                            <div class="history-result @game.Result">@game.ResultText</div>
                        </a>
                        index++;
                    }

                    <!-- PHÂN TRANG CHUYÊN NGHIỆP -->
                    <div class="pagination-wrapper" id="history-pagination">
                        <div class="pagination-info" id="pagination-info">
                            Đang hiển thị 1 - 5 / tổng số @Model.RecentGames.Count ván
                        </div>
                        <div class="pagination-controls" id="pagination-controls">
                            <!-- Nút phân trang render bằng JS -->
                        </div>
                    </div>
                }
                else
                {
                    <p style="color: var(--text-muted); text-align: center; padding: 20px;">Bạn chưa chơi trận nào.</p>
                }
            </div>
        </div>

        <!-- LEADERBOARD WITH TABS -->
        <div class="panel-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h2 class="panel-title" style="margin: 0;"><i class="fa-solid fa-ranking-star"></i> Bảng xếp hạng</h2>
                <div style="display: flex; gap: 6px; background: var(--bg-navy-dark); padding: 3px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <button type="button" id="tab-btn-elo" class="lb-tab-btn active" onclick="switchLbTab('elo')">
                        <i class="fa-solid fa-star"></i> Điểm Elo
                    </button>
                    <button type="button" id="tab-btn-puzzle" class="lb-tab-btn" onclick="switchLbTab('puzzle')">
                        <i class="fa-solid fa-puzzle-piece"></i> Cờ thế
                    </button>
                </div>
            </div>

            <!-- TAB 1: ELO CHƠI CỜ -->
            <div id="lb-tab-elo" class="leaderboard-list">
                @{
                    int lbEloIdx = 0;
                }
                @foreach (var user in Model.Leaderboard)
                {
                    var extraStyle = user.IsCurrentUser ? "border: 1px solid var(--accent-gold); background: rgba(212,175,55,0.05);" : "";
                    var rankBadgeStyle = user.IsCurrentUser && user.Rank > 3 ? "background: var(--accent-gold); color: white;" : "";
                    var lbPlayerStyle = user.IsCurrentUser ? "color: var(--accent-gold);" : "";

                    <div class="leaderboard-item lb-elo-row rank-@(user.Rank <= 3 ? user.Rank : 0)" data-index="@lbEloIdx" style="@extraStyle">
                        <div class="rank-badge" style="@rankBadgeStyle">@user.Rank</div>
                        <div class="lb-player" style="@lbPlayerStyle">@user.Username</div>
                        <div class="lb-elo"><i class="fa-solid fa-star" style="font-size: 11px; color: var(--accent-gold);"></i> @user.Elo</div>
                    </div>
                    lbEloIdx++;
                }

                @if (Model.Leaderboard.Any())
                {
                    <div class="pagination-wrapper" id="lb-elo-pagination" style="margin-top: 10px; padding-top: 8px;">
                        <div class="pagination-info" id="lb-elo-pagination-info" style="font-size: 11.5px;"></div>
                        <div class="pagination-controls" id="lb-elo-pagination-controls"></div>
                    </div>
                }
            </div>

            <!-- TAB 2: CAO THỦ CỜ THẾ -->
            <div id="lb-tab-puzzle" class="leaderboard-list" style="display: none;">
                @if (Model.PuzzleLeaderboard.Any())
                {
                    int lbPzIdx = 0;
                    foreach (var user in Model.PuzzleLeaderboard)
                    {
                        var extraStyle = user.IsCurrentUser ? "border: 1px solid var(--accent-gold); background: rgba(212,175,55,0.05);" : "";
                        var rankBadgeStyle = user.IsCurrentUser && user.Rank > 3 ? "background: var(--accent-gold); color: white;" : "";
                        var lbPlayerStyle = user.IsCurrentUser ? "color: var(--accent-gold);" : "";

                        <div class="leaderboard-item lb-pz-row rank-@(user.Rank <= 3 ? user.Rank : 0)" data-index="@lbPzIdx" style="@extraStyle">
                            <div class="rank-badge" style="@rankBadgeStyle">@user.Rank</div>
                            <div class="lb-player" style="@lbPlayerStyle">@user.Username</div>
                            <div class="lb-elo" style="color: #10b981;"><i class="fa-solid fa-check" style="font-size: 11px;"></i> @user.SolvedCount bài</div>
                        </div>
                        lbPzIdx++;
                    }

                    <div class="pagination-wrapper" id="lb-pz-pagination" style="margin-top: 10px; padding-top: 8px;">
                        <div class="pagination-info" id="lb-pz-pagination-info" style="font-size: 11.5px;"></div>
                        <div class="pagination-controls" id="lb-pz-pagination-controls"></div>
                    </div>
                }
                else
                {
                    <p style="color: var(--text-muted); text-align: center; padding: 20px;">Chưa có dữ liệu bảng xếp hạng cờ thế.</p>
                }
            </div>
        </div>

        <script>
            function switchLbTab(type) {
                var eloTab = document.getElementById('lb-tab-elo');
                var pzTab = document.getElementById('lb-tab-puzzle');
                var eloBtn = document.getElementById('tab-btn-elo');
                var pzBtn = document.getElementById('tab-btn-puzzle');

                if (type === 'elo') {
                    eloTab.style.display = 'flex';
                    pzTab.style.display = 'none';
                    eloBtn.classList.add('active');
                    pzBtn.classList.remove('active');
                } else {
                    eloTab.style.display = 'none';
                    pzTab.style.display = 'flex';
                    pzBtn.classList.add('active');
                    eloBtn.classList.remove('active');
                }
            }

            // ==========================================
            // HỆ THỐNG PHÂN TRANG & LỌC LỊCH SỬ ĐẤU
            // ==========================================
            (function() {
                const pageSize = 5; // Số ván đấu trên mỗi trang
                let currentPage = 1;
                let activeFilteredRows = [];
                const allRows = Array.from(document.querySelectorAll('.match-row'));
                const infoEl = document.getElementById('pagination-info');
                const controlsEl = document.getElementById('pagination-controls');
                const paginationWrapper = document.getElementById('history-pagination');

                function applyFilter(selectedMode) {
                    if (selectedMode === 'ALL') {
                        activeFilteredRows = allRows.slice();
                    } else {
                        activeFilteredRows = allRows.filter(r => (r.getAttribute('data-mode') || '').trim() === selectedMode.trim());
                    }

                    // Ẩn tất cả trước
                    allRows.forEach(r => r.style.display = 'none');

                    if (activeFilteredRows.length === 0) {
                        if (paginationWrapper) paginationWrapper.style.display = 'none';
                        if (infoEl) infoEl.textContent = 'Không có ván đấu nào ở chế độ này.';
                        if (controlsEl) controlsEl.innerHTML = '';
                        return;
                    }

                    if (paginationWrapper) paginationWrapper.style.display = 'flex';
                    renderPage(1);
                }

                function renderPage(page) {
                    currentPage = page;
                    const totalItems = activeFilteredRows.length;
                    const totalPages = Math.ceil(totalItems / pageSize) || 1;
                    const start = (page - 1) * pageSize;
                    const end = Math.min(start + pageSize, totalItems);

                    // Ẩn toàn bộ rồi hiện các dòng thuộc trang hiện tại
                    allRows.forEach(r => r.style.display = 'none');
                    activeFilteredRows.forEach((row, i) => {
                        if (i >= start && i < end) {
                            row.style.display = 'flex';
                        }
                    });

                    // Cập nhật thông tin dòng hiển thị
                    if (infoEl) {
                        infoEl.textContent = `Đang hiển thị ${start + 1} - ${end} / tổng số ${totalItems} ván`;
                    }

                    // Render các nút bấm phân trang
                    renderControls(totalPages);
                }

                function renderControls(totalPages) {
                    if (!controlsEl) return;
                    controlsEl.innerHTML = '';
                    if (totalPages <= 1) return;

                    // Nút Về trang trước
                    const prevBtn = document.createElement('button');
                    prevBtn.type = 'button';
                    prevBtn.className = 'page-btn';
                    prevBtn.title = 'Trang trước';
                    prevBtn.innerHTML = '<i class="fa-solid fa-angle-left"></i>';
                    prevBtn.disabled = currentPage === 1;
                    prevBtn.onclick = () => renderPage(currentPage - 1);
                    controlsEl.appendChild(prevBtn);

                    // Danh sách số trang (thông minh với dấu ...)
                    let pages = [];
                    if (totalPages <= 5) {
                        for (let p = 1; p <= totalPages; p++) pages.push(p);
                    } else {
                        if (currentPage <= 3) {
                            pages = [1, 2, 3, 4, '...', totalPages];
                        } else if (currentPage >= totalPages - 2) {
                            pages = [1, '...', totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
                        } else {
                            pages = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
                        }
                    }

                    pages.forEach(p => {
                        if (p === '...') {
                            const ellipsis = document.createElement('span');
                            ellipsis.className = 'page-ellipsis';
                            ellipsis.textContent = '...';
                            controlsEl.appendChild(ellipsis);
                        } else {
                            const pageBtn = document.createElement('button');
                            pageBtn.type = 'button';
                            pageBtn.className = 'page-btn' + (p === currentPage ? ' active' : '');
                            pageBtn.textContent = p;
                            pageBtn.onclick = () => renderPage(p);
                            controlsEl.appendChild(pageBtn);
                        }
                    });

                    // Nút Tới trang sau
                    const nextBtn = document.createElement('button');
                    nextBtn.type = 'button';
                    nextBtn.className = 'page-btn';
                    nextBtn.title = 'Trang sau';
                    nextBtn.innerHTML = '<i class="fa-solid fa-angle-right"></i>';
                    nextBtn.disabled = currentPage === totalPages;
                    nextBtn.onclick = () => renderPage(currentPage + 1);
                    controlsEl.appendChild(nextBtn);
                }

                window.filterHistoryByMode = function() {
                    const select = document.getElementById('historyModeFilter');
                    applyFilter(select ? select.value : 'ALL');
                };

                applyFilter('ALL');
            })();

            // ==========================================
            // HỆ THỐNG PHÂN TRANG BẢNG XẾP HẠNG (LEADERBOARD)
            // ==========================================
            function setupSimplePagination(rowSelector, infoId, controlsId, wrapperId, pageSize) {
                const rows = document.querySelectorAll(rowSelector);
                const totalItems = rows.length;
                const totalPages = Math.ceil(totalItems / pageSize);
                const infoEl = document.getElementById(infoId);
                const controlsEl = document.getElementById(controlsId);
                const wrapperEl = document.getElementById(wrapperId);

                if (totalItems <= pageSize) {
                    if (wrapperEl) wrapperEl.style.display = 'none';
                    rows.forEach(r => r.style.display = 'flex');
                    return;
                }

                function renderLbPage(page) {
                    const start = (page - 1) * pageSize;
                    const end = Math.min(start + pageSize, totalItems);

                    rows.forEach((r, i) => {
                        r.style.display = (i >= start && i < end) ? 'flex' : 'none';
                    });

                    if (infoEl) {
                        infoEl.textContent = `Hiển thị ${start + 1} - ${end} / ${totalItems}`;
                    }

                    if (controlsEl) {
                        controlsEl.innerHTML = '';
                        const prevBtn = document.createElement('button');
                        prevBtn.type = 'button';
                        prevBtn.className = 'page-btn';
                        prevBtn.innerHTML = '<i class="fa-solid fa-angle-left"></i>';
                        prevBtn.disabled = page === 1;
                        prevBtn.onclick = () => renderLbPage(page - 1);
                        controlsEl.appendChild(prevBtn);

                        for (let p = 1; p <= totalPages; p++) {
                            const pBtn = document.createElement('button');
                            pBtn.type = 'button';
                            pBtn.className = 'page-btn' + (p === page ? ' active' : '');
                            pBtn.textContent = p;
                            pBtn.onclick = () => renderLbPage(p);
                            controlsEl.appendChild(pBtn);
                        }

                        const nextBtn = document.createElement('button');
                        nextBtn.type = 'button';
                        nextBtn.className = 'page-btn';
                        nextBtn.innerHTML = '<i class="fa-solid fa-angle-right"></i>';
                        nextBtn.disabled = page === totalPages;
                        nextBtn.onclick = () => renderLbPage(page + 1);
                        controlsEl.appendChild(nextBtn);
                    }
                }

                renderLbPage(1);
            }

            setupSimplePagination('.lb-elo-row', 'lb-elo-pagination-info', 'lb-elo-pagination-controls', 'lb-elo-pagination', 8);
            setupSimplePagination('.lb-pz-row', 'lb-pz-pagination-info', 'lb-pz-pagination-controls', 'lb-pz-pagination', 8);

            // ==========================================
            // VẼ BIỂU ĐỒ BIẾN ĐỘNG ELO (CHART.JS)
            // ==========================================
            (function() {
                var eloDataRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EloHistory));
                if (!eloDataRaw || eloDataRaw.length === 0) return;

                var labels = eloDataRaw.map(function(item) { return item.DateLabel; });
                var eloValues = eloDataRaw.map(function(item) { return item.Elo; });

                function initChart() {
                    var ctx = document.getElementById('eloRatingChart');
                    if (!ctx || !window.Chart) return;

                    var displayLabels = labels.slice();
                    var displayValues = eloValues.slice();
                    var isSinglePoint = displayValues.length <= 1;

                    // Nếu chỉ có 1 điểm duy nhất (người chơi mới), tạo thêm mốc tham chiếu kéo dài để thành đường biểu đồ
                    if (isSinglePoint) {
                        displayLabels = ['Khởi đầu', 'Hiện tại'];
                        displayValues = [displayValues[0] || @Model.CurrentUser.Elo, displayValues[0] || @Model.CurrentUser.Elo];
                    }

                    var gradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 220);
                    gradient.addColorStop(0, 'rgba(59, 130, 246, 0.35)');
                    gradient.addColorStop(1, 'rgba(59, 130, 246, 0.0)');

                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: displayLabels,
                            datasets: [{
                                label: 'Điểm Elo',
                                data: displayValues,
                                borderColor: '#3b82f6',
                                backgroundColor: gradient,
                                borderWidth: 2.5,
                                fill: true,
                                tension: 0.35,
                                borderDash: isSinglePoint ? [6, 6] : [], // Nét đứt thể hiện mức tham chiếu nếu chưa có trận
                                pointBackgroundColor: '#3b82f6',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointRadius: isSinglePoint ? 5 : 4,
                                pointHoverRadius: 7
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: 'rgba(15, 23, 42, 0.95)',
                                    titleColor: '#f8fafc',
                                    bodyColor: '#cbd5e1',
                                    borderColor: 'rgba(255, 255, 255, 0.1)',
                                    borderWidth: 1,
                                    padding: 10,
                                    displayColors: false,
                                    callbacks: {
                                        label: function(context) {
                                            if (isSinglePoint) {
                                                return 'Elo hiện tại: ' + context.raw + ' (Mốc ban đầu)';
                                            }
                                            var idx = context.dataIndex;
                                            var item = eloDataRaw[idx];
                                            var changeText = item.Change > 0 ? ('+' + item.Change) : (item.Change < 0 ? item.Change : '0');
                                            return 'Elo: ' + item.Elo + ' (' + changeText + ') - ' + item.Reason;
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { color: 'rgba(0, 0, 0, 0.06)' },
                                    ticks: { color: '#334155', font: { size: 12, weight: '700' } }
                                },
                                y: {
                                    grid: { color: 'rgba(0, 0, 0, 0.06)' },
                                    ticks: { color: '#334155', font: { size: 12, weight: '700' }, precision: 0 },
                                    suggestedMin: (displayValues[0] || 1200) - 50,
                                    suggestedMax: (displayValues[0] || 1200) + 50
                                }
                            }
                        }
                    });
                }

                function initAllCharts() {
                    initChart();
                    initOutcomeChart();
                    initModeCompareChart();
                }

                var outcomeChartInstance = null;
                var modeStatsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ModeStats ?? new List<ChessCore.Services.ModeStatistics>()));

                window.onDonutFilterChange = function() {
                    var select = document.getElementById('donutModeFilter');
                    var modeKey = select ? select.value : 'ALL';

                    var wins = 0, draws = 0, losses = 0, winRate = 0;

                    if (modeKey === 'ALL') {
                        wins = @Model.CurrentUser.Wins;
                        draws = @Model.CurrentUser.Draws;
                        losses = @Model.CurrentUser.Losses;
                        var total = wins + draws + losses;
                        winRate = total > 0 ? ((wins / total) * 100).toFixed(1) : 0;
                    } else {
                        var found = modeStatsList.find(function(m) { return m.Mode === modeKey; });
                        if (found) {
                            wins = found.Wins || 0;
                            draws = found.Draws || 0;
                            losses = found.Losses || 0;
                            winRate = found.WinRate || 0;
                        }
                    }

                    // Cập nhật DOM số liệu bên ngoài
                    var elWinRate = document.getElementById('donutWinRateValue');
                    var elWins = document.getElementById('donutWinsCount');
                    var elDraws = document.getElementById('donutDrawsCount');
                    var elLosses = document.getElementById('donutLossesCount');

                    if (elWinRate) elWinRate.textContent = winRate + '%';
                    if (elWins) elWins.textContent = wins;
                    if (elDraws) elDraws.textContent = draws;
                    if (elLosses) elLosses.textContent = losses;

                    // Cập nhật dữ liệu biểu đồ tròn
                    if (outcomeChartInstance) {
                        var totalMatches = wins + draws + losses;
                        outcomeChartInstance.data.datasets[0].data = totalMatches === 0 ? [1, 0, 0] : [wins, draws, losses];
                        outcomeChartInstance.data.datasets[0].backgroundColor = totalMatches === 0 ? ['#94a3b8', '#94a3b8', '#94a3b8'] : ['#10b981', '#f59e0b', '#ef4444'];
                        outcomeChartInstance.update();
                    }
                };

                function initOutcomeChart() {
                    var ctx = document.getElementById('outcomeDonutChart');
                    if (!ctx || !window.Chart) return;

                    var wins = @Model.CurrentUser.Wins;
                    var draws = @Model.CurrentUser.Draws;
                    var losses = @Model.CurrentUser.Losses;
                    var total = wins + draws + losses;

                    outcomeChartInstance = new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: ['Thắng', 'Hòa', 'Thua'],
                            datasets: [{
                                data: total === 0 ? [1, 0, 0] : [wins, draws, losses],
                                backgroundColor: total === 0 ? ['#94a3b8', '#94a3b8', '#94a3b8'] : ['#10b981', '#f59e0b', '#ef4444'],
                                hoverBackgroundColor: ['#059669', '#d97706', '#dc2626'],
                                borderWidth: 0,
                                borderRadius: 6,
                                spacing: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '76%',
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        color: '#1e293b',
                                        padding: 14,
                                        font: { size: 12, weight: '700' },
                                        usePointStyle: true,
                                        pointStyle: 'circle'
                                    }
                                },
                                tooltip: {
                                    backgroundColor: 'rgba(15, 23, 42, 0.95)',
                                    titleColor: '#f8fafc',
                                    bodyColor: '#cbd5e1',
                                    padding: 10,
                                    borderColor: 'rgba(255, 255, 255, 0.1)',
                                    borderWidth: 1,
                                    displayColors: true,
                                    callbacks: {
                                        label: function(c) {
                                            var d = c.dataset.data;
                                            var sum = d.reduce(function(a, b) { return a + b; }, 0);
                                            if (sum === 1 && d[0] === 1 && d[1] === 0 && d[2] === 0) return ' Chưa có trận đấu';
                                            var val = c.raw;
                                            var pct = sum > 0 ? ((val / sum) * 100).toFixed(1) : 0;
                                            return ' ' + c.label + ': ' + val + ' ván (' + pct + '%)';
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                function initModeCompareChart() {
                    var ctx = document.getElementById('modeCompareChart');
                    if (!ctx || !window.Chart) return;

                    var modeStatsRaw = modeStatsList;
                    if (!modeStatsRaw || modeStatsRaw.length === 0) return;

                    // Hiển thị đầy đủ cả 5 chế độ khớp 100% với bảng thống kê bên trên
                    var labels = modeStatsRaw.map(function(m) { return m.Label || m.Mode; });
                    var finishedData = modeStatsRaw.map(function(m) { return m.Finished; });
                    var winsData = modeStatsRaw.map(function(m) { return m.Wins; });

                    new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [
                                {
                                    label: 'Hoàn tất',
                                    data: finishedData,
                                    backgroundColor: '#3b82f6',
                                    hoverBackgroundColor: '#2563eb',
                                    borderRadius: 6,
                                    barPercentage: 0.65,
                                    categoryPercentage: 0.6
                                },
                                {
                                    label: 'Thắng',
                                    data: winsData,
                                    backgroundColor: '#10b981',
                                    hoverBackgroundColor: '#059669',
                                    borderRadius: 6,
                                    barPercentage: 0.65,
                                    categoryPercentage: 0.6
                                }
                            ]
                        },
                        options: {
                            indexAxis: 'y', // Chuyển thành thanh ngang (Horizontal bar)
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'top',
                                    align: 'end',
                                    labels: {
                                        color: '#1e293b',
                                        font: { size: 12, weight: '700' },
                                        usePointStyle: true,
                                        pointStyle: 'circle',
                                        padding: 12
                                    }
                                },
                                tooltip: {
                                    backgroundColor: 'rgba(15, 23, 42, 0.95)',
                                    titleColor: '#f8fafc',
                                    bodyColor: '#cbd5e1',
                                    borderColor: 'rgba(255, 255, 255, 0.1)',
                                    borderWidth: 1,
                                    padding: 10
                                }
                            },
                            scales: {
                                x: {
                                    grid: { color: 'rgba(0, 0, 0, 0.06)' },
                                    ticks: { color: '#334155', font: { size: 12, weight: '700' }, precision: 0 },
                                    beginAtZero: true
                                },
                                y: {
                                    grid: { display: false },
                                    ticks: { 
                                        color: '#0f172a', 
                                        font: { size: 12, weight: '800' }
                                    }
                                }
                            }
                        }
                    });
                }

                if (window.Chart) {
                    initAllCharts();
                } else {
                    var script = document.createElement('script');
                    script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
                    script.onload = initAllCharts;
                    document.head.appendChild(script);
                }
            })();
        </script>
    </div>
</div>
