        @if (Model.EloHistory.Count <= 1)
        {
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 10px; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-circle-info" style="color: #3b82f6;"></i>
                <span>Đang hiển thị mốc Elo khởi đầu. Tham gia thêm các ván đấu <strong>PvP Online</strong> để theo dõi biến động phong độ chi tiết.</span>
            </div>
        }
    </div>

    <div class="dashboard-content">
        <!-- MATCH HISTORY -->
        <div class="panel-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                <h2 class="panel-title" style="margin: 0;"><i class="fa-solid fa-clock-rotate-left"></i> Lịch sử đấu gần đây</h2>
                <!-- SELECT LỌC THEO CHẾ ĐỘ CHƠI CHO LỊCH SỬ ĐẤU -->
                <div style="display: flex; align-items: center; gap: 8px;">
                    <label for="historyModeFilter" style="font-size: 12.5px; font-weight: 700; color: #334155;">Chế độ:</label>
                    <select id="historyModeFilter" onchange="filterHistoryByMode()" style="background: var(--bg-navy-dark); color: #1e293b; border: 1px solid var(--border-color); border-radius: 6px; padding: 5px 12px; font-size: 12.5px; font-weight: 700; cursor: pointer; outline: none;">
                        <option value="ALL">Tất cả chế độ</option>
                        @if (Model.ModeStats != null)
                        {
                            foreach (var m in Model.ModeStats)
                            {
                                <option value="@m.Label">@m.Label</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="history-list" id="history-list-container">
                @if (Model.RecentGames.Any())
                {
                    var index = 0;
                    foreach (var game in Model.RecentGames)
                    {
                        <a href="/Game/Review/@game.GameId" id="game-row-@game.GameId" data-game-id="@game.GameId" class="history-item @game.Result match-row" data-index="@index" data-mode="@game.GameMode" style="text-decoration: none; cursor: pointer; display: none;" title="Nhấn để xem chi tiết phân tích ván đấu">
                            <div class="history-main">
                                <div class="history-opp">
                                    vs. @game.OpponentName 
                                    @if (game.OpponentElo.HasValue)
                                    {
                                        <span class="history-elo-badge" title="Elo thực tế của đối thủ">(Elo: @game.OpponentElo.Value)</span>
                                    }
                                    <span class="history-mode-tag">@game.GameMode</span>
                                </div>
                                <div class="history-meta">
                                    <span><i class="fa-regular fa-calendar"></i> @game.PlayedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    <span><i class="fa-solid fa-chess-board"></i> @game.TotalMoves nước</span>
                                    @if (game.IsRated && game.OldElo.HasValue && game.NewElo.HasValue)
                                    {
                                        <span style="color: var(--text-muted); display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fa-solid fa-star" style="color: var(--accent-gold); font-size: 11px;"></i> Elo: 
                                            <strong style="color: var(--accent-gold);">@game.OldElo.Value &rarr; @game.NewElo.Value</strong>
                                            @if (game.EloChange.HasValue && game.EloChange.Value > 0)
                                            {
                                                <span style="color: #10b981; font-weight: 800; font-size: 12px;">(+@game.EloChange.Value)</span>
                                            }
                                            else if (game.EloChange.HasValue && game.EloChange.Value < 0)
                                            {
                                                <span style="color: #ef4444; font-weight: 800; font-size: 12px;">(@game.EloChange.Value)</span>
                                            }
                                            else
                                            {
                                                <span style="color: #64748b; font-weight: 700; font-size: 12px;">(±0)</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: #64748b; display: inline-flex; align-items: center; gap: 4px; font-size: 12px;">
                                            <i class="fa-solid fa-shield-halved" style="color: #94a3b8; font-size: 11px;"></i> 
                                            <span>@(string.IsNullOrEmpty(game.SubModeBadge) ? "Không tính Elo" : game.SubModeBadge)</span>
                                        </span>
                                    }
                                    <span class="history-review-hint"><i class="fa-solid fa-magnifying-glass-chart"></i> Phân tích ván đấu</span>
                                </div>
                            </div>
                            <div class="history-status-group">
                                <div class="history-result @game.Result">@game.ResultText</div>
                                @if (game.IsRated && game.EloChange.HasValue)
                                {
                                    if (game.EloChange.Value > 0)
                                    {
                                        <div class="history-elo-delta positive" title="Được cộng @game.EloChange.Value điểm Elo">
                                            <i class="fa-solid fa-arrow-trend-up"></i> +@game.EloChange.Value Elo
                                        </div>
                                    }
                                    else if (game.EloChange.Value < 0)
                                    {
                                        <div class="history-elo-delta negative" title="Bị trừ @(Math.Abs(game.EloChange.Value)) điểm Elo">
                                            <i class="fa-solid fa-arrow-trend-down"></i> @game.EloChange.Value Elo
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="history-elo-delta neutral" title="Không thay đổi điểm Elo">
                                            <i class="fa-solid fa-minus"></i> 0 Elo
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="history-elo-delta unrated" title="@game.SubModeBadge">
                                        <i class="fa-solid fa-shield-halved"></i> @(string.IsNullOrEmpty(game.SubModeBadge) ? "Không xếp hạng" : game.SubModeBadge)
                                    </div>
                                }
                            </div>
                        </a>
                        index++;
                    }

                    <!-- PHÂN TRANG CHUYÊN NGHIỆP -->
                    <div class="pagination-wrapper" id="history-pagination">
                        <div class="pagination-info" id="pagination-info">
                            Đang hiển thị 1 - 5 / tổng số @Model.RecentGames.Count ván
                        </div>
                        <div class="pagination-controls" id="pagination-controls">
                            <!-- Nút phân trang render bằng JS -->
                        </div>
                    </div>
                }
                else
                {
                    <p style="color: var(--text-muted); text-align: center; padding: 20px;">Bạn chưa chơi trận nào.</p>
                }
            </div>
        </div>

        <!-- LEADERBOARD WITH TABS -->
        <div class="panel-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h2 class="panel-title" style="margin: 0;"><i class="fa-solid fa-ranking-star"></i> Bảng xếp hạng</h2>
                <div style="display: flex; gap: 6px; background: var(--bg-navy-dark); padding: 3px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <button type="button" id="tab-btn-elo" class="lb-tab-btn active" onclick="switchLbTab('elo')">
                        <i class="fa-solid fa-star"></i> Điểm Elo
                    </button>
                    <button type="button" id="tab-btn-puzzle" class="lb-tab-btn" onclick="switchLbTab('puzzle')">
                        <i class="fa-solid fa-puzzle-piece"></i> Cờ thế
                    </button>
                </div>
            </div>

            <!-- TAB 1: ELO CHƠI CỜ -->
            <div id="lb-tab-elo" class="leaderboard-list">
                @{
                    int lbEloIdx = 0;
                }
                @foreach (var user in Model.Leaderboard)
                {
                    var extraStyle = user.IsCurrentUser ? "border: 1px solid var(--accent-gold); background: rgba(212,175,55,0.05);" : "";
                    var rankBadgeStyle = user.IsCurrentUser && user.Rank > 3 ? "background: var(--accent-gold); color: white;" : "";
                    var lbPlayerStyle = user.IsCurrentUser ? "color: var(--accent-gold);" : "";

                    <div class="leaderboard-item lb-elo-row rank-@(user.Rank <= 3 ? user.Rank : 0)" data-index="@lbEloIdx" style="@extraStyle">
                        <div class="rank-badge" style="@rankBadgeStyle">@user.Rank</div>
                        <div class="lb-player" style="@lbPlayerStyle">@user.Username</div>
                        <div class="lb-elo"><i class="fa-solid fa-star" style="font-size: 11px; color: var(--accent-gold);"></i> @user.Elo</div>
                    </div>
                    lbEloIdx++;
                }

                @if (Model.Leaderboard.Any())
                {
                    <div class="pagination-wrapper" id="lb-elo-pagination" style="margin-top: 10px; padding-top: 8px;">
                        <div class="pagination-info" id="lb-elo-pagination-info" style="font-size: 11.5px;"></div>
                        <div class="pagination-controls" id="lb-elo-pagination-controls"></div>
                    </div>
                }
            </div>

            <!-- TAB 2: CAO THỦ CỜ THẾ -->
            <div id="lb-tab-puzzle" class="leaderboard-list" style="display: none;">
                @if (Model.PuzzleLeaderboard.Any())
                {
                    int lbPzIdx = 0;
                    foreach (var user in Model.PuzzleLeaderboard)
                    {
                        var extraStyle = user.IsCurrentUser ? "border: 1px solid var(--accent-gold); background: rgba(212,175,55,0.05);" : "";
                        var rankBadgeStyle = user.IsCurrentUser && user.Rank > 3 ? "background: var(--accent-gold); color: white;" : "";
                        var lbPlayerStyle = user.IsCurrentUser ? "color: var(--accent-gold);" : "";

                        <div class="leaderboard-item lb-pz-row rank-@(user.Rank <= 3 ? user.Rank : 0)" data-index="@lbPzIdx" style="@extraStyle">
                            <div class="rank-badge" style="@rankBadgeStyle">@user.Rank</div>
                            <div class="lb-player" style="@lbPlayerStyle">@user.Username</div>
                            <div class="lb-elo" style="color: #10b981;"><i class="fa-solid fa-check" style="font-size: 11px;"></i> @user.SolvedCount bài</div>
                        </div>
                        lbPzIdx++;
                    }

                    <div class="pagination-wrapper" id="lb-pz-pagination" style="margin-top: 10px; padding-top: 8px;">
                        <div class="pagination-info" id="lb-pz-pagination-info" style="font-size: 11.5px;"></div>
                        <div class="pagination-controls" id="lb-pz-pagination-controls"></div>
                    </div>
                }
                else
                {
                    <p style="color: var(--text-muted); text-align: center; padding: 20px;">Chưa có dữ liệu bảng xếp hạng cờ thế.</p>
                }
            </div>
        </div>

        <script>
            function switchLbTab(type) {
                var eloTab = document.getElementById('lb-tab-elo');
                var pzTab = document.getElementById('lb-tab-puzzle');
                var eloBtn = document.getElementById('tab-btn-elo');
                var pzBtn = document.getElementById('tab-btn-puzzle');

                if (type === 'elo') {
                    eloTab.style.display = 'flex';
                    pzTab.style.display = 'none';
                    eloBtn.classList.add('active');
                    pzBtn.classList.remove('active');
                } else {
                    eloTab.style.display = 'none';
                    pzTab.style.display = 'flex';
                    pzBtn.classList.add('active');
                    eloBtn.classList.remove('active');
                }
            }

            // ==========================================
            // HỆ THỐNG PHÂN TRANG & LỌC LỊCH SỬ ĐẤU
            // ==========================================
            (function() {
                const pageSize = 5; // Số ván đấu trên mỗi trang
                let currentPage = 1;
                let activeFilteredRows = [];
                const allRows = Array.from(document.querySelectorAll('.match-row'));
                const infoEl = document.getElementById('pagination-info');
                const controlsEl = document.getElementById('pagination-controls');
                const paginationWrapper = document.getElementById('history-pagination');

                function applyFilter(selectedMode) {
                    if (selectedMode === 'ALL') {
                        activeFilteredRows = allRows.slice();
                    } else {
                        activeFilteredRows = allRows.filter(r => (r.getAttribute('data-mode') || '').trim() === selectedMode.trim());
                    }

                    // Ẩn tất cả trước
                    allRows.forEach(r => r.style.display = 'none');

                    if (activeFilteredRows.length === 0) {
                        if (paginationWrapper) paginationWrapper.style.display = 'none';
                        if (infoEl) infoEl.textContent = 'Không có ván đấu nào ở chế độ này.';
                        if (controlsEl) controlsEl.innerHTML = '';
                        return;
                    }

                    if (paginationWrapper) paginationWrapper.style.display = 'flex';
                    renderPage(1);
                }

                window.goToHistoryPage = function(page) {
                    renderPage(page);
                };

                function renderPage(page) {
                    currentPage = page;
                    const totalItems = activeFilteredRows.length;
                    const totalPages = Math.ceil(totalItems / pageSize) || 1;
                    const start = (page - 1) * pageSize;
                    const end = Math.min(start + pageSize, totalItems);

                    // Ẩn toàn bộ rồi hiện các dòng thuộc trang hiện tại
                    allRows.forEach(r => r.style.display = 'none');
                    activeFilteredRows.forEach((row, i) => {
                        if (i >= start && i < end) {
                            row.style.display = 'flex';
                        }
                    });

                    // Cập nhật thông tin dòng hiển thị
                    if (infoEl) {
                        infoEl.textContent = `Đang hiển thị ${start + 1} - ${end} / tổng số ${totalItems} ván`;
                    }

                    // Render các nút bấm phân trang
                    renderControls(totalPages);
                }

                function renderControls(totalPages) {
                    if (!controlsEl) return;
                    controlsEl.innerHTML = '';
                    if (totalPages <= 1) return;

                    // Nút Về trang trước
                    const prevBtn = document.createElement('button');
                    prevBtn.type = 'button';
                    prevBtn.className = 'page-btn';
                    prevBtn.title = 'Trang trước';
                    prevBtn.innerHTML = '<i class="fa-solid fa-angle-left"></i>';
                    prevBtn.disabled = currentPage === 1;
                    prevBtn.onclick = () => renderPage(currentPage - 1);
                    controlsEl.appendChild(prevBtn);

                    // Danh sách số trang (thông minh với dấu ...)
                    let pages = [];
                    if (totalPages <= 5) {
                        for (let p = 1; p <= totalPages; p++) pages.push(p);
                    } else {
                        if (currentPage <= 3) {
                            pages = [1, 2, 3, 4, '...', totalPages];
                        } else if (currentPage >= totalPages - 2) {
                            pages = [1, '...', totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
                        } else {
                            pages = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
                        }
                    }

                    pages.forEach(p => {
                        if (p === '...') {
                            const ellipsis = document.createElement('span');
                            ellipsis.className = 'page-ellipsis';
                            ellipsis.textContent = '...';
                            controlsEl.appendChild(ellipsis);
                        } else {
                            const pageBtn = document.createElement('button');
                            pageBtn.type = 'button';
                            pageBtn.className = 'page-btn' + (p === currentPage ? ' active' : '');
                            pageBtn.textContent = p;
                            pageBtn.onclick = () => renderPage(p);
                            controlsEl.appendChild(pageBtn);
                        }
                    });

                    // Nút Tới trang sau
                    const nextBtn = document.createElement('button');
                    nextBtn.type = 'button';
                    nextBtn.className = 'page-btn';
                    nextBtn.title = 'Trang sau';
                    nextBtn.innerHTML = '<i class="fa-solid fa-angle-right"></i>';
                    nextBtn.disabled = currentPage === totalPages;
                    nextBtn.onclick = () => renderPage(currentPage + 1);
                    controlsEl.appendChild(nextBtn);
                }

                window.filterHistoryByMode = function(forcedMode) {
                    const select = document.getElementById('historyModeFilter');
                    const mode = forcedMode !== undefined ? forcedMode : (select ? select.value : 'ALL');
                    if (select && forcedMode !== undefined) {
                        select.value = forcedMode;
                    }
                    applyFilter(mode);
                };

                const filterSelect = document.getElementById('historyModeFilter');
                if (filterSelect) {
                    filterSelect.addEventListener('change', function() {
                        window.filterHistoryByMode(this.value);
                    });
                    // Đồng bộ bộ lọc với giá trị của dropdown khi tải trang
                    applyFilter(filterSelect.value || 'ALL');
                } else {
                    applyFilter('ALL');
                }
            })();

            // ==========================================
            // HỆ THỐNG PHÂN TRANG BẢNG XẾP HẠNG (LEADERBOARD)
            // ==========================================
            function setupSimplePagination(rowSelector, infoId, controlsId, wrapperId, pageSize) {
                const rows = document.querySelectorAll(rowSelector);
                const totalItems = rows.length;
                const totalPages = Math.ceil(totalItems / pageSize);
                const infoEl = document.getElementById(infoId);
                const controlsEl = document.getElementById(controlsId);
                const wrapperEl = document.getElementById(wrapperId);

                if (totalItems <= pageSize) {
                    if (wrapperEl) wrapperEl.style.display = 'none';
                    rows.forEach(r => r.style.display = 'flex');
                    return;
                }

                function renderLbPage(page) {
                    const start = (page - 1) * pageSize;
                    const end = Math.min(start + pageSize, totalItems);

                    rows.forEach((r, i) => {
                        r.style.display = (i >= start && i < end) ? 'flex' : 'none';
                    });

                    if (infoEl) {
                        infoEl.textContent = `Hiển thị ${start + 1} - ${end} / ${totalItems}`;
                    }

                    if (controlsEl) {
                        controlsEl.innerHTML = '';
                        const prevBtn = document.createElement('button');
                        prevBtn.type = 'button';
                        prevBtn.className = 'page-btn';
                        prevBtn.innerHTML = '<i class="fa-solid fa-angle-left"></i>';
                        prevBtn.disabled = page === 1;
                        prevBtn.onclick = () => renderLbPage(page - 1);
                        controlsEl.appendChild(prevBtn);

                        for (let p = 1; p <= totalPages; p++) {
                            const pBtn = document.createElement('button');
                            pBtn.type = 'button';
                            pBtn.className = 'page-btn' + (p === page ? ' active' : '');
                            pBtn.textContent = p;
                            pBtn.onclick = () => renderLbPage(p);
                            controlsEl.appendChild(pBtn);
                        }

                        const nextBtn = document.createElement('button');
                        nextBtn.type = 'button';
                        nextBtn.className = 'page-btn';
                        nextBtn.innerHTML = '<i class="fa-solid fa-angle-right"></i>';
                        nextBtn.disabled = page === totalPages;
                        nextBtn.onclick = () => renderLbPage(page + 1);
                        controlsEl.appendChild(nextBtn);
                    }
                }

                renderLbPage(1);
            }

            setupSimplePagination('.lb-elo-row', 'lb-elo-pagination-info', 'lb-elo-pagination-controls', 'lb-elo-pagination', 8);
            setupSimplePagination('.lb-pz-row', 'lb-pz-pagination-info', 'lb-pz-pagination-controls', 'lb-pz-pagination', 8);

            // ==========================================
