                // =========================================================================
                // THỐNG KÊ NÂNG CAO THEO NHÓM TÀI KHOẢN (ADVANCED MULTI-ACCOUNT STATS)
                // =========================================================================
                var advDebounceTimer = null;

                window.toggleAccountList = function() {
                    var container = document.getElementById('accountListContainer');
                    var icon = document.getElementById('toggleAccountListIcon');
                    var text = document.getElementById('toggleAccountListText');
                    if (!container) return;
                    if (container.style.display === 'none') {
                        container.style.display = 'block';
                        if (icon) icon.className = 'fa-solid fa-chevron-up';
                        if (text) text.textContent = 'Thu gọn';
                    } else {
                        container.style.display = 'none';
                        if (icon) icon.className = 'fa-solid fa-chevron-down';
                        if (text) text.textContent = 'Chọn tài khoản';
                    }
                };

                window.filterAccountsList = function() {
                    var q = (document.getElementById('accountSearchInput')?.value || '').toLowerCase().trim();
                    var cards = document.querySelectorAll('.account-check-card');
                    var visibleCount = 0;
                    cards.forEach(function(card) {
                        var text = card.textContent.toLowerCase();
                        var match = !q || text.includes(q);
                        card.style.display = match ? 'flex' : 'none';
                        if (match) visibleCount++;
                    });
                    var emptyEl = document.getElementById('advSearchEmpty');
                    if (emptyEl) emptyEl.style.display = (visibleCount === 0) ? 'block' : 'none';
                };

                window.selectOnlyMe = function() {
                    var checkboxes = document.querySelectorAll('.acc-checkbox');
                    checkboxes.forEach(function(cb) {
                        cb.checked = (Number(cb.value) === myUserId);
                        updateCardHighlight(cb);
                    });
                    onAccountCheckChange();
                };

                window.selectAllAccounts = function() {
                    var checkboxes = document.querySelectorAll('.acc-checkbox');
                    checkboxes.forEach(function(cb) {
                        cb.checked = true;
                        updateCardHighlight(cb);
                    });
                    onAccountCheckChange();
                };

                window.clearAllAccounts = function() {
                    var checkboxes = document.querySelectorAll('.acc-checkbox');
                    checkboxes.forEach(function(cb) {
                        cb.checked = false;
                        updateCardHighlight(cb);
                    });
                    onAccountCheckChange();
                };

                window.selectTopAccounts = function(count) {
                    var checkboxes = Array.from(document.querySelectorAll('.acc-checkbox'));
                    checkboxes.forEach(function(cb, idx) {
                        cb.checked = (idx < count);
                        updateCardHighlight(cb);
                    });
                    onAccountCheckChange();
                };

                function updateCardHighlight(cb) {
                    var card = cb.closest('.account-check-card');
                    if (card) {
                        card.classList.toggle('checked-card', cb.checked);
                    }
                }

                window.onAccountCheckChange = function() {
                    var checkboxes = Array.from(document.querySelectorAll('.acc-checkbox'));
                    checkboxes.forEach(updateCardHighlight);

                    var checkedBoxes = checkboxes.filter(function(cb) { return cb.checked; });
                    var selectedIds = checkedBoxes.map(function(cb) { return Number(cb.value); });

                    // Cập nhật nhãn badge
                    var badgeText = document.getElementById('advBadgeText');
                    if (badgeText) {
                        if (selectedIds.length === 0) {
                            badgeText.textContent = 'Chưa chọn tài khoản nào';
                        } else if (selectedIds.length === 1) {
                            var uName = checkedBoxes[0].dataset.username || 'Kỳ thủ';
                            badgeText.textContent = (selectedIds[0] === myUserId) ? 'Cá nhân (Bạn)' : uName;
                        } else if (selectedIds.length === checkboxes.length) {
                            badgeText.textContent = 'Toàn bộ hệ thống (' + selectedIds.length + ' tài khoản)';
                        } else {
                            var names = checkedBoxes.slice(0, 3).map(function(cb) { return cb.dataset.username; }).join(', ');
                            if (checkedBoxes.length > 3) names += ' +' + (checkedBoxes.length - 3);
                            badgeText.textContent = selectedIds.length + ' tài khoản (' + names + ')';
                        }
                    }

                    // Cập nhật link xuất file
                    var qIds = selectedIds.join(',');
                    var btnExcel = document.getElementById('btnExportExcel');
                    var btnCsv = document.getElementById('btnExportCsv');
                    if (btnExcel) btnExcel.href = '/Dashboard/ExportExcel' + (qIds ? '?userIds=' + qIds : '');
                    if (btnCsv) btnCsv.href = '/Dashboard/Export' + (qIds ? '?userIds=' + qIds : '');

                    // Debounce gọi API cập nhật số liệu
                    clearTimeout(advDebounceTimer);
                    advDebounceTimer = setTimeout(function() {
                        fetchAdvancedStats(selectedIds);
                    }, 250);
                };

                function fetchAdvancedStats(ids) {
                    if (ids.length === 0) {
                        // Bỏ chọn toàn bộ: reset về 0
                        renderEmptyStats();
                        return;
                    }

                    var url = '/Dashboard/AdvancedStats?userIds=' + ids.join(',');
                    fetch(url)
                        .then(function(res) { return res.json(); })
                        .then(function(data) {
                            applyAdvancedStatsData(data);
                        })
                        .catch(function(err) {
                            console.error('Lỗi nạp thống kê nâng cao:', err);
                        });
                }

                function applyAdvancedStatsData(data) {
                    if (!data) return;

                    // 1. Cập nhật 4 thẻ KPI
                    var kpi = data.kpis || data.Kpis || {};
                    var elElo = document.getElementById('kpiEloValue');
                    var elEloSub = document.getElementById('kpiEloSub');
                    var elEloTitle = document.getElementById('kpiEloTitle');
                    var kpiAvgElo = kpi.avgElo !== undefined ? kpi.avgElo : (kpi.AvgElo || 0);
                    var kpiMaxElo = kpi.maxElo !== undefined ? kpi.maxElo : (kpi.MaxElo || 0);
                    var kpiMinElo = kpi.minElo !== undefined ? kpi.minElo : (kpi.MinElo || 0);
                    var kpiSelectedCount = kpi.selectedCount !== undefined ? kpi.selectedCount : (kpi.SelectedCount || 0);
                    var userList = data.users || data.Users || [];

                    if (elElo) {
                        elElo.textContent = Math.round(kpiAvgElo);
                        if (elEloTitle) {
                            elEloTitle.textContent = kpiSelectedCount > 1 ? 'ELO TRUNG BÌNH' : 'ĐIỂM ELO';
                        }
                        if (elEloSub) {
                            if (kpiSelectedCount > 1) {
                                var subHtml = 'Cao nhất: <b style="color: var(--accent-gold);">' + kpiMaxElo + '</b>';
                                if (kpiMinElo && kpiMinElo !== kpiMaxElo) {
                                    subHtml += ' · Thấp nhất: <b>' + kpiMinElo + '</b>';
                                }
                                elEloSub.innerHTML = subHtml;
                            } else if (kpiSelectedCount === 1 && userList.length > 0) {
                                var singleUser = userList[0];
                                var rankVal = singleUser.rank || singleUser.Rank;
                                elEloSub.textContent = (rankVal ? ('Hạng #' + rankVal + ' · ') : '') + (singleUser.username || singleUser.Username || 'Kỳ thủ');
                            } else {
                                elEloSub.textContent = 'Điểm Elo xếp hạng';
                            }
                        }
                    }

                    var elWinRate = document.getElementById('kpiWinRateValue');
                    var elWinRateSub = document.getElementById('kpiWinRateSub');
                    var elWinRateTitle = document.getElementById('kpiWinRateTitle');
                    var kpiWinRate = Number(kpi.winRate !== undefined ? kpi.winRate : (kpi.WinRate || 0));
                    if (elWinRate) {
                        elWinRate.textContent = kpiWinRate.toFixed(1) + '%';
                        if (elWinRateTitle) elWinRateTitle.textContent = 'TỈ LỆ THẮNG';
                        if (elWinRateSub) {
                            elWinRateSub.textContent = kpiSelectedCount > 1 ? ('Tính trên ' + kpiSelectedCount + ' tài khoản') : 'Ván hoàn tất';
                        }
                    }

                    var elGames = document.getElementById('kpiGamesValue');
                    var elGamesSub = document.getElementById('kpiGamesSub');
                    var elGamesTitle = document.getElementById('kpiGamesTitle');
                    var kpiGames = kpi.totalGames !== undefined ? kpi.totalGames : (kpi.TotalGames || 0);
                    if (elGames) {
                        elGames.textContent = kpiGames;
                        if (elGamesTitle) elGamesTitle.textContent = 'TỔNG SỐ TRẬN';
                        if (elGamesSub) {
                            elGamesSub.textContent = kpiSelectedCount > 1 ? ('Của ' + kpiSelectedCount + ' tài khoản') : 'Tổng ván đã tham gia';
                        }
                    }

                    var elPuzzles = document.getElementById('kpiPuzzlesValue');
                    var elPuzzlesSub = document.getElementById('kpiPuzzlesSub');
                    var elPuzzlesTitle = document.getElementById('kpiPuzzlesTitle');
                    var kpiPuzzles = kpi.puzzlesSolved !== undefined ? kpi.puzzlesSolved : (kpi.PuzzlesSolved || 0);
                    if (elPuzzles) {
                        elPuzzles.textContent = kpiPuzzles;
                        if (elPuzzlesTitle) elPuzzlesTitle.textContent = 'CỜ THẾ ĐÃ GIẢI';
                        if (elPuzzlesSub) {
                            elPuzzlesSub.textContent = kpiSelectedCount > 1 ? ('Của ' + kpiSelectedCount + ' tài khoản') : 'Bài thế giải thành công';
                        }
                    }

                    // 2. Cập nhật bảng Mode Stats
                    var mList = data.modeStats || data.ModeStats;
                    if (mList && mList.length > 0) {
                        modeStatsList = mList;
                        var sCreated = 0, sInProgress = 0, sWaiting = 0, sFinished = 0, sWins = 0, sLosses = 0, sDraws = 0;
                        mList.forEach(function(m) {
                            var mode = m.mode || m.Mode || '';
                            var mCreated = m.created !== undefined ? m.created : (m.Created || 0);
                            var mInProgress = m.inProgress !== undefined ? m.inProgress : (m.InProgress || 0);
                            var mWaiting = m.waiting !== undefined ? m.waiting : (m.Waiting || 0);
                            var mFinished = m.finished !== undefined ? m.finished : (m.Finished || 0);
                            var mWins = m.wins !== undefined ? m.wins : (m.Wins || 0);
                            var mLosses = m.losses !== undefined ? m.losses : (m.Losses || 0);
                            var mDraws = m.draws !== undefined ? m.draws : (m.Draws || 0);
                            var mWinRate = Number(m.winRate !== undefined ? m.winRate : (m.WinRate || 0));

                            sCreated += mCreated;
                            sInProgress += mInProgress;
                            sWaiting += mWaiting;
                            sFinished += mFinished;
                            if (mode === 'Online' || mode === 'PvE') {
                                sWins += mWins;
                                sLosses += mLosses;
                            }
                            sDraws += mDraws;

                            var row = document.getElementById('mode-row-' + mode);
                            if (row) {
                                var cCreated = row.querySelector('.col-created');
                                var cInProgress = row.querySelector('.col-inprogress');
                                var cWaiting = row.querySelector('.col-waiting');
                                var cFinished = row.querySelector('.col-finished');
                                var cWins = row.querySelector('.col-wins');
                                var cLosses = row.querySelector('.col-losses');
                                var cDraws = row.querySelector('.col-draws');
                                var cWinRate = row.querySelector('.col-winrate');

                                if (cCreated) cCreated.textContent = mCreated;
                                if (cInProgress) cInProgress.textContent = mInProgress;
                                if (cWaiting) cWaiting.textContent = mWaiting;
                                if (cFinished) cFinished.textContent = mFinished;
                                if (cWins) cWins.textContent = (mode === 'Online' || mode === 'PvE') ? mWins : '—';
                                if (cLosses) cLosses.textContent = (mode === 'Online' || mode === 'PvE') ? mLosses : '—';
                                if (cDraws) cDraws.textContent = mDraws;
                                if (cWinRate) cWinRate.textContent = (mode === 'Online' || mode === 'PvE') ? (mWinRate.toFixed(1) + '%') : '—';
                            }
                        });

                        // Cập nhật dòng tổng cộng
                        var tCreated = document.getElementById('tot-created');
                        var tInProgress = document.getElementById('tot-inprogress');
                        var tWaiting = document.getElementById('tot-waiting');
                        var tFinished = document.getElementById('tot-finished');
                        var tWins = document.getElementById('tot-wins');
                        var tLosses = document.getElementById('tot-losses');
                        var tDraws = document.getElementById('tot-draws');
                        var tWinRate = document.getElementById('tot-winrate');

                        if (tCreated) tCreated.textContent = sCreated;
                        if (tInProgress) tInProgress.textContent = sInProgress;
                        if (tWaiting) tWaiting.textContent = sWaiting;
                        if (tFinished) tFinished.textContent = sFinished;
                        if (tWins) tWins.textContent = sWins;
                        if (tLosses) tLosses.textContent = sLosses;
                        if (tDraws) tDraws.textContent = sDraws;

                        var rankedFinished = mList.filter(function(m) { 
                            var mode = m.mode || m.Mode; 
                            return mode === 'Online' || mode === 'PvE'; 
                        }).reduce(function(a, b) { 
                            var f = b.finished !== undefined ? b.finished : (b.Finished || 0);
                            return a + f; 
                        }, 0);
                        var avgWr = rankedFinished > 0 ? (sWins * 100.0 / rankedFinished).toFixed(1) + '%' : '0.0%';
                        if (tWinRate) tWinRate.textContent = avgWr;
                    }

                    // 3. Cập nhật thẻ Học tập & Cờ thế
                    var learning = data.learning || data.Learning;
                    if (learning) {
                        var lLessons = document.getElementById('learningCompletedLessons');
                        var lQuiz = document.getElementById('learningQuizDetails');
                        var lPuzzles = document.getElementById('learningPuzzlesSolved');
                        var lAttempts = document.getElementById('learningPuzzleAttempts');

                        var lCompleted = learning.completedLessonRecords !== undefined ? learning.completedLessonRecords : (learning.CompletedLessonRecords || 0);
                        var lTotal = learning.totalLessons !== undefined ? learning.totalLessons : (learning.TotalLessons || 0);
                        var lQuizCount = learning.quizAttempts !== undefined ? learning.quizAttempts : (learning.QuizAttempts || 0);
                        var lAvgQuiz = Number(learning.averageBestQuizScore !== undefined ? learning.averageBestQuizScore : (learning.AverageBestQuizScore || 0));
                        var lPuzSolved = learning.puzzlesSolved !== undefined ? learning.puzzlesSolved : (learning.PuzzlesSolved || 0);
                        var lPuzAttempts = learning.puzzleAttempts !== undefined ? learning.puzzleAttempts : (learning.PuzzleAttempts || 0);

                        if (lLessons) lLessons.textContent = lCompleted + ' / ' + lTotal + ' bài hoàn thành';
                        if (lQuiz) lQuiz.innerHTML = lQuizCount + ' lượt làm Quiz · Điểm trung bình: <strong style="color: #10b981;">' + lAvgQuiz.toFixed(1) + '%</strong>';
                        if (lPuzzles) lPuzzles.textContent = lPuzSolved + ' bài giải thành công';
                        if (lAttempts) lAttempts.textContent = 'Tổng ' + lPuzAttempts + ' lượt gửi lời giải · Điểm phiên rèn luyện';
                    }

                    // 4. Cập nhật Biểu đồ Doughnut & Bar Chart
                    var donut = data.donut || data.Donut;
                    if (donut) {
                        var wins = donut.wins !== undefined ? donut.wins : (donut.Wins || 0);
                        var draws = donut.draws !== undefined ? donut.draws : (donut.Draws || 0);
                        var losses = donut.losses !== undefined ? donut.losses : (donut.Losses || 0);
                        var donutWr = Number(donut.winRate !== undefined ? donut.winRate : (donut.WinRate || 0));
                        var total = wins + draws + losses;

                        var dWinRateVal = document.getElementById('donutWinRateValue');
                        var dWins = document.getElementById('donutWinsCount');
                        var dDraws = document.getElementById('donutDrawsCount');
                        var dLosses = document.getElementById('donutLossesCount');

                        if (dWinRateVal) dWinRateVal.textContent = donutWr.toFixed(1) + '%';
                        if (dWins) dWins.textContent = wins;
                        if (dDraws) dDraws.textContent = draws;
                        if (dLosses) dLosses.textContent = losses;

                        if (outcomeChartInstance) {
                            outcomeChartInstance.data.datasets[0].data = total === 0 ? [1, 0, 0] : [wins, draws, losses];
                            outcomeChartInstance.data.datasets[0].backgroundColor = total === 0 ? ['#94a3b8', '#94a3b8', '#94a3b8'] : ['#10b981', '#f59e0b', '#ef4444'];
                            outcomeChartInstance.update();
                        }
                    }

                    if (modeCompareChartInstance && mList) {
                        var finishedData = mList.map(function(m) { return m.finished !== undefined ? m.finished : (m.Finished || 0); });
                        var winsData = mList.map(function(m) { return m.wins !== undefined ? m.wins : (m.Wins || 0); });
                        modeCompareChartInstance.data.datasets[0].data = finishedData;
                        modeCompareChartInstance.data.datasets[1].data = winsData;
                        modeCompareChartInstance.update();
                    }

                    // 5. Cập nhật Bảng so sánh chi tiết kỳ thủ đã chọn
                    renderComparisonTable(data.users || data.Users || []);
                }

                function renderComparisonTable(users) {
                    var panel = document.getElementById('selectedUsersComparisonPanel');
                    var tbody = document.getElementById('selectedUsersTableBody');
                    var sub = document.getElementById('comparisonTableSub');
                    if (!panel || !tbody) return;

                    if (!users || users.length <= 1) {
                        panel.style.display = 'none';
                        tbody.innerHTML = '';
                        return;
                    }

                    panel.style.display = 'block';
                    if (sub) sub.textContent = 'Bảng đối chiếu thành tích trực tiếp giữa ' + users.length + ' tài khoản được chọn';

                    var html = '';
                    users.forEach(function(u, idx) {
                        var uRank = u.rank !== undefined ? u.rank : (u.Rank !== undefined ? u.Rank : (idx + 1));
                        var medal = uRank === 1 ? '🥇' : (uRank === 2 ? '🥈' : (uRank === 3 ? '🥉' : '#' + uRank));
                        var uId = u.id !== undefined ? u.id : (u.Id !== undefined ? u.Id : 0);
                        var isCurrent = (uId === myUserId) || Boolean(u.isCurrentUser !== undefined ? u.isCurrentUser : u.IsCurrentUser);
                        var uName = u.username || u.Username || 'Kỳ thủ';
                        var uPlayerId = u.playerId || u.PlayerId || ('CT-' + uId);
                        var uElo = u.elo !== undefined ? u.elo : (u.Elo !== undefined ? u.Elo : 0);
                        var uTitle = u.title || u.Title || 'Kỳ thủ';
                        var uGames = u.gamesPlayed !== undefined ? u.gamesPlayed : (u.GamesPlayed || 0);
                        var uWins = u.wins !== undefined ? u.wins : (u.Wins || 0);
                        var uDraws = u.draws !== undefined ? u.draws : (u.Draws || 0);
                        var uLosses = u.losses !== undefined ? u.losses : (u.Losses || 0);
                        var uWinRate = Number(u.winRate !== undefined ? u.winRate : (u.WinRate !== undefined ? u.WinRate : 0));
                        var uPuzzles = u.puzzlesSolved !== undefined ? u.puzzlesSolved : (u.PuzzlesSolved || 0);
                        var uLessons = u.lessonsCompleted !== undefined ? u.lessonsCompleted : (u.LessonsCompleted || 0);

                        var tierClass = uElo >= 1500 ? '#ec4899' : (uElo >= 1400 ? '#8b5cf6' : (uElo >= 1250 ? '#3b82f6' : (uElo >= 1150 ? '#10b981' : '#f59e0b')));
                        var bgRow = isCurrent ? 'background: rgba(217, 119, 6, 0.08); border-left: 4px solid var(--accent-gold);' : '';

                        html += '<tr style="border-bottom: 1px solid var(--border-color); ' + bgRow + '">';
                        html += '<td style="padding: 12px 14px; text-align: center; font-weight: 800; font-size: 14px;">' + medal + '</td>';
                        html += '<td style="padding: 12px 18px;">';
                        html += '  <div style="font-weight: 700; color: var(--text-main); font-size: 13.5px;">' + uName + (isCurrent ? ' <span style="color: var(--accent-gold); font-size: 12px; font-weight: 800;">(Bạn)</span>' : '') + '</div>';
                        html += '  <div style="font-size: 11px; color: var(--text-muted);">Mã: ' + uPlayerId + '</div>';
                        html += '</td>';
                        html += '<td style="padding: 12px 14px; text-align: center;">';
                        html += '  <div style="font-weight: 800; color: var(--accent-gold); font-size: 13.5px;"><i class="fa-solid fa-star" style="font-size: 10px;"></i> ' + uElo + '</div>';
                        html += '  <div style="font-size: 11px; font-weight: 600; color: ' + tierClass + ';">' + uTitle + '</div>';
                        html += '</td>';
                        html += '<td style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-main);">' + uGames + '</td>';
                        html += '<td style="padding: 12px 14px; text-align: center;">';
                        html += '  <span class="stat-wdl-pill">';
                        html += '    <span class="wdl-w" style="color: #10b981; font-weight: 700;"><i class="fa-solid fa-check"></i> ' + uWins + '</span> - ';
                        html += '    <span class="wdl-d" style="color: #f59e0b; font-weight: 700;">' + uDraws + '</span> - ';
                        html += '    <span class="wdl-l" style="color: #ef4444; font-weight: 700;"><i class="fa-solid fa-xmark"></i> ' + uLosses + '</span>';
                        html += '  </span>';
                        html += '</td>';
                        html += '<td style="padding: 12px 14px; text-align: center; font-weight: 800; color: ' + (uWinRate >= 50 ? '#10b981' : '#f59e0b') + ';">' + uWinRate.toFixed(1) + '%</td>';
                        html += '<td style="padding: 12px 14px; text-align: center; font-weight: 700; color: #f59e0b;"><i class="fa-solid fa-puzzle-piece"></i> ' + uPuzzles + '</td>';
                        html += '<td style="padding: 12px 14px; text-align: center; font-weight: 700; color: #10b981;"><i class="fa-solid fa-graduation-cap"></i> ' + uLessons + '</td>';
                        html += '</tr>';
                    });
                    tbody.innerHTML = html;
                }

                function renderEmptyStats() {
                    var elElo = document.getElementById('kpiEloValue');
                    var elEloTitle = document.getElementById('kpiEloTitle');
                    var elEloSub = document.getElementById('kpiEloSub');
                    var elWinRate = document.getElementById('kpiWinRateValue');
                    var elWinRateSub = document.getElementById('kpiWinRateSub');
                    var elGames = document.getElementById('kpiGamesValue');
                    var elGamesSub = document.getElementById('kpiGamesSub');
                    var elPuzzles = document.getElementById('kpiPuzzlesValue');
                    var elPuzzlesSub = document.getElementById('kpiPuzzlesSub');

                    if (elElo) elElo.textContent = '0';
                    if (elEloTitle) elEloTitle.textContent = 'ĐIỂM ELO';
                    if (elEloSub) elEloSub.textContent = 'Chưa chọn tài khoản';

                    if (elWinRate) elWinRate.textContent = '0.0%';
                    if (elWinRateSub) elWinRateSub.textContent = 'Chưa chọn tài khoản';

                    if (elGames) elGames.textContent = '0';
                    if (elGamesSub) elGamesSub.textContent = 'Chưa chọn tài khoản';

                    if (elPuzzles) elPuzzles.textContent = '0';
                    if (elPuzzlesSub) elPuzzlesSub.textContent = 'Chưa chọn tài khoản';

                    var panel = document.getElementById('selectedUsersComparisonPanel');
                    if (panel) panel.style.display = 'none';
                }

                // Xử lý nạp ban đầu nếu có URL query string ?userIds=... hoặc có sẵn nhiều checkbox
                (function initSelectedState() {
                    try {
                        var urlParams = new URLSearchParams(window.location.search);
                        var qUserIds = urlParams.get('userIds');
                        if (qUserIds) {
                            var targetIds = qUserIds.split(',').map(function(s) { return Number(s.trim()); });
                            var checkboxes = document.querySelectorAll('.acc-checkbox');
                            checkboxes.forEach(function(cb) {
                                cb.checked = targetIds.includes(Number(cb.value));
                                updateCardHighlight(cb);
                            });
                            onAccountCheckChange();
                        } else {
                            var checkedBoxes = Array.from(document.querySelectorAll('.acc-checkbox:checked'));
                            if (checkedBoxes.length > 1) {
                                onAccountCheckChange();
                            }
                        }
                    } catch (e) {
                        console.error('Lỗi khởi tạo trạng thái lọc:', e);
                    }
                })();

                if (window.Chart) {
                    initAllCharts();
                } else {
                    var script = document.createElement('script');
                    script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
                    script.onload = initAllCharts;
                    document.head.appendChild(script);
                }
            })();
        </script>
    </div>
</div>
