                                    borderColor: 'rgba(255, 255, 255, 0.1)',
                                    borderWidth: 1,
                                    padding: 10,
                                    displayColors: false,
                                    callbacks: {
                                        label: function(context) {
                                            if (isSinglePoint) {
                                                return 'Elo hiện tại: ' + context.raw + ' (Mốc ban đầu)';
