@model ChessCore.ViewModels.AccountProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ Tài khoản";
    var initial = !string.IsNullOrEmpty(Model.Username) ? Model.Username.Substring(0, 1).ToUpper() : "U";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="account-container">
    <div class="account-header">
        <h1><i class="fa-solid fa-circle-user"></i> Quản lý Tài khoản</h1>
        <div style="font-size: 13px; color: var(--text-muted);">
            <i class="fa-solid fa-calendar-days"></i> Thành viên từ: <strong>@Model.CreatedAt.ToString("dd/MM/yyyy")</strong>
        </div>
    </div>

    @if (TempData["AccountSuccess"] != null)
    {
        <div class="alert-acc alert-acc-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["AccountSuccess"]</span>
        </div>
    }

    @if (TempData["AccountError"] != null)
    {
        <div class="alert-acc alert-acc-danger">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@TempData["AccountError"]</span>
        </div>
    }

    <!-- HERO CARD -->
    <div class="account-hero-card">
        <div class="hero-user-info">
            <div class="hero-avatar">@initial</div>
            <div class="hero-meta">
                <h2>
                    <span>@Model.Username</span>
                    <span class="role-badge @(string.Equals(Model.Role, "Admin", StringComparison.OrdinalIgnoreCase) ? "admin" : "")">
                        <i class="fa-solid fa-shield-halved"></i> @Model.Role
                    </span>
                </h2>
                <div class="hero-id-tag">
                    <span>Mã người chơi: <strong>@Model.PlayerId</strong></span>
                    <span>•</span>
                    <span>Email: <strong>@Model.Email</strong></span>
                </div>
            </div>
        </div>

        <div class="hero-elo-pill">
            <div class="hero-elo-label">Hệ số Elo</div>
            <div class="hero-elo-value">
                <i class="fa-solid fa-star"></i>
                <span>@Model.Elo</span>
            </div>
        </div>
    </div>

    <!-- STATS ROW -->
    <div class="account-stats-grid">
        <div class="acc-stat-card">
            <div class="acc-stat-icon games"><i class="fa-solid fa-chess-board"></i></div>
            <div class="acc-stat-info">
                <h4>Tổng số ván đấu</h4>
                <p>@Model.GamesPlayed</p>
            </div>
        </div>
        <div class="acc-stat-card">
            <div class="acc-stat-icon wins"><i class="fa-solid fa-trophy"></i></div>
            <div class="acc-stat-info">
                <h4>Thắng / Tỉ lệ</h4>
                <p>@Model.Wins <span style="font-size: 14px; font-weight: 500; color: #10b981;">(@Model.WinRate%)</span></p>
            </div>
        </div>
        <div class="acc-stat-card">
            <div class="acc-stat-icon puzzles"><i class="fa-solid fa-puzzle-piece"></i></div>
            <div class="acc-stat-info">
                <h4>Cờ thế đã giải</h4>
                <p>@Model.PuzzlesSolved</p>
            </div>
        </div>
        <div class="acc-stat-card">
            <div class="acc-stat-icon courses"><i class="fa-solid fa-graduation-cap"></i></div>
            <div class="acc-stat-info">
                <h4>Module hoàn thành</h4>
                <p>@Model.CompletedCourses / 4</p>
            </div>
        </div>
    </div>

    <!-- DANH HIỆU & HUY HIỆU THÀNH TỰU (ACHIEVEMENTS & BADGES) -->
    <div class="account-badges-section" style="margin-bottom: 28px;">
        <div class="badges-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
            <h3 style="margin: 0; font-size: 18px; color: var(--text-main); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-medal text-gold"></i>
                <span>Danh hiệu & Huy hiệu Thành tựu</span>
            </h3>
            <span style="font-size: 13px; color: var(--text-muted); background: var(--bg-navy-dark); border: 1px solid var(--border-color); padding: 4px 12px; border-radius: 20px;">
                Đã mở khóa: <strong style="color: var(--accent-gold);">@(Model.Badges.Count(b => b.IsUnlocked))/8</strong> huy hiệu
            </span>
        </div>

        <div class="badges-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px;">
            @foreach (var badge in Model.Badges)
            {
                <div class="badge-item-card @(badge.IsUnlocked ? "unlocked" : "locked")" 
                     style="background: var(--bg-navy-panel); border: 1px solid @(badge.IsUnlocked ? "rgba(212, 175, 55, 0.35)" : "var(--border-color)"); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: flex-start; transition: transform 0.2s, box-shadow 0.2s; position: relative; opacity: @(badge.IsUnlocked ? "1" : "0.65");">
                    
                    <div class="badge-icon-wrap" style="width: 44px; height: 44px; min-width: 44px; border-radius: 10px; background: @(badge.IsUnlocked ? badge.Color : "#334155"); display: flex; align-items: center; justify-content: center; color: white; font-size: 20px; box-shadow: @(badge.IsUnlocked ? $"0 4px 12px {badge.Color}44" : "none");">
                        <i class="fa-solid @badge.Icon"></i>
                    </div>

                    <div class="badge-details" style="flex: 1; min-width: 0;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; gap: 6px;">
                            <strong style="font-size: 14px; color: @(badge.IsUnlocked ? "var(--text-main)" : "var(--text-muted)"); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @badge.Title
                            </strong>
                            @if (badge.IsUnlocked)
                            {
                                <span style="font-size: 10px; font-weight: 700; color: #10b981; background: rgba(16, 185, 129, 0.12); padding: 2px 6px; border-radius: 4px; border: 1px solid rgba(16, 185, 129, 0.3);"><i class="fa-solid fa-check"></i> Đạt</span>
                            }
                            else
                            {
                                <span style="font-size: 10px; font-weight: 600; color: var(--text-muted); background: var(--bg-navy-dark); padding: 2px 6px; border-radius: 4px;"><i class="fa-solid fa-lock"></i> Khóa</span>
                            }
                        </div>
                        <p style="margin: 0 0 6px 0; font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                            @badge.Description
                        </p>
                        <div style="font-size: 11px; font-weight: 600; color: @(badge.IsUnlocked ? "var(--accent-gold)" : "var(--text-muted)");">
                            Tiến độ: @badge.ProgressText
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- FORMS ROW -->
    <div class="account-forms-grid">
        <!-- ĐỔI TÊN HIỂN THỊ -->
        <div class="account-form-card">
            <div class="card-title-row">
                <i class="fa-solid fa-id-card"></i>
                <h3>Đổi Tên Hiển Thị</h3>
            </div>
            <form asp-controller="Account" asp-action="UpdateUsername" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group-acc">
                    <label>Mã ID Định Danh (Không đổi)</label>
                    <input type="text" class="form-control-acc" value="@Model.PlayerId" disabled />
                </div>
                <div class="form-group-acc">
                    <label>Email Đăng Ký</label>
                    <input type="text" class="form-control-acc" value="@Model.Email" disabled />
                </div>
                <div class="form-group-acc">
                    <label>Tên hiển thị hiện tại</label>
                    <input type="text" name="Username" class="form-control-acc" value="@Model.Username" required minlength="3" maxlength="30" />
                    <small style="color: var(--text-muted); font-size: 12px; margin-top: 4px; display: block;">Tên hiển thị sẽ xuất hiện trên bàn cờ, bảng xếp hạng và chứng chỉ khóa học.</small>
                </div>
                <button type="submit" class="btn-acc-primary">
                    <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi
                </button>
            </form>
        </div>

        <!-- ĐỔI MẬT KHẨU -->
        <div class="account-form-card">
            <div class="card-title-row">
                <i class="fa-solid fa-lock"></i>
                <h3>Đổi Mật Khẩu</h3>
            </div>
            <form asp-controller="Account" asp-action="ChangePassword" method="post" id="form-change-password">
                @Html.AntiForgeryToken()
                <div class="form-group-acc">
                    <label for="current-pwd">Mật khẩu hiện tại</label>
                    <div class="acc-input-icon-wrap">
                        <i class="fa-solid fa-lock acc-input-icon"></i>
                        <input type="password" id="current-pwd" name="CurrentPassword" class="form-control-acc" placeholder="Nhập mật khẩu hiện tại" required autocomplete="current-password" />
                        <i class="fa-solid fa-eye toggle-pwd-btn" onclick="toggleAccPassword('current-pwd', this)" title="Ẩn/Hiện mật khẩu"></i>
                    </div>
                </div>

                <div class="form-group-acc">
                    <label for="acc-new-pwd">Mật khẩu mới</label>
                    <div class="acc-input-icon-wrap">
                        <i class="fa-solid fa-key acc-input-icon"></i>
                        <input type="password" id="acc-new-pwd" name="NewPassword" class="form-control-acc" placeholder="Tối thiểu 6 ký tự" required minlength="6" autocomplete="new-password" />
                        <i class="fa-solid fa-eye toggle-pwd-btn" onclick="toggleAccPassword('acc-new-pwd', this)" title="Ẩn/Hiện mật khẩu"></i>
                    </div>
                </div>

                <!-- CARD KIỂM TRA ĐỘ MẠNH & TIÊU CHÍ MẬT KHẨU CHUYÊN NGHIỆP -->
                <div class="pwd-validation-card" id="pwd-validation-box">
                    <div class="pwd-strength-header">
                        <span class="pwd-strength-title"><i class="fa-solid fa-shield-halved"></i> Độ an toàn mật khẩu:</span>
                        <span class="pwd-strength-badge" id="pwd-strength-text">Chưa nhập</span>
                    </div>
                    <div class="pwd-strength-meter">
                        <div class="strength-segment" id="seg-1"></div>
                        <div class="strength-segment" id="seg-2"></div>
                        <div class="strength-segment" id="seg-3"></div>
                        <div class="strength-segment" id="seg-4"></div>
                    </div>

                    <div class="pwd-criteria-grid" id="pwd-reqs">
                        <div class="pwd-criterion" id="req-len">
                            <span class="crit-icon"><i class="fa-solid fa-circle-xmark"></i></span>
                            <span class="crit-label">Ít nhất 6 ký tự</span>
                        </div>
                        <div class="pwd-criterion" id="req-case">
                            <span class="crit-icon"><i class="fa-solid fa-circle-xmark"></i></span>
                            <span class="crit-label">Chữ hoa và chữ thường</span>
                        </div>
                        <div class="pwd-criterion" id="req-num">
                            <span class="crit-icon"><i class="fa-solid fa-circle-xmark"></i></span>
                            <span class="crit-label">Bao gồm chữ số</span>
                        </div>
                        <div class="pwd-criterion" id="req-spec">
                            <span class="crit-icon"><i class="fa-solid fa-circle-xmark"></i></span>
                            <span class="crit-label">Ký tự đặc biệt (!@@#$...)</span>
                        </div>
                    </div>
                </div>

                <div class="form-group-acc">
                    <label for="acc-confirm-pwd">Xác nhận mật khẩu mới</label>
                    <div class="acc-input-icon-wrap">
                        <i class="fa-solid fa-shield-halved acc-input-icon"></i>
                        <input type="password" id="acc-confirm-pwd" name="ConfirmNewPassword" class="form-control-acc" placeholder="Nhập lại mật khẩu mới" required minlength="6" autocomplete="new-password" />
                        <i class="fa-solid fa-eye toggle-pwd-btn" onclick="toggleAccPassword('acc-confirm-pwd', this)" title="Ẩn/Hiện mật khẩu"></i>
                    </div>
                    <div id="pwd-match-hint" class="pwd-match-hint"></div>
                </div>

                <button type="submit" id="btn-submit-pwd" class="btn-acc-primary">
                    <i class="fa-solid fa-key"></i> Đổi mật khẩu
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAccPassword(inputId, iconElement) {
            const input = document.getElementById(inputId);
            if (!input) return;
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.remove("fa-eye");
                iconElement.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                iconElement.classList.remove("fa-eye-slash");
                iconElement.classList.add("fa-eye");
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const pwdInput = document.getElementById('acc-new-pwd');
            const confirmPwdInput = document.getElementById('acc-confirm-pwd');
            const strengthBadge = document.getElementById('pwd-strength-text');
            const matchHint = document.getElementById('pwd-match-hint');
            const segments = [
                document.getElementById('seg-1'),
                document.getElementById('seg-2'),
                document.getElementById('seg-3'),
                document.getElementById('seg-4')
            ];

            function setReqState(id, isValid) {
                const req = document.getElementById(id);
                if (!req) return;
                const icon = req.querySelector('.crit-icon i') || req.querySelector('i');
                if (isValid) {
                    req.classList.add('valid');
                    if (icon) icon.className = 'fa-solid fa-circle-check';
                } else {
                    req.classList.remove('valid');
                    if (icon) icon.className = 'fa-solid fa-circle-xmark';
                }
            }

            function updateStrength(val) {
                if (!val || val.length === 0) {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Chưa nhập';
                        strengthBadge.className = 'pwd-strength-badge';
                    }
                    segments.forEach(seg => {
                        if (seg) seg.className = 'strength-segment';
                    });
                    setReqState('req-len', false);
                    setReqState('req-case', false);
                    setReqState('req-num', false);
                    setReqState('req-spec', false);
                    return 0;
                }

                const hasLen = val.length >= 6;
                const hasCase = /[a-z]/.test(val) && /[A-Z]/.test(val);
                const hasNum = /\d/.test(val);
                const hasSpec = /[^a-zA-Z0-9]/.test(val);

                setReqState('req-len', hasLen);
                setReqState('req-case', hasCase);
                setReqState('req-num', hasNum);
                setReqState('req-spec', hasSpec);

                let score = 0;
                if (hasLen) score++;
                if (hasCase) score++;
                if (hasNum) score++;
                if (hasSpec) score++;

                segments.forEach(seg => {
                    if (seg) seg.className = 'strength-segment';
                });

                if (score <= 1) {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Yếu';
                        strengthBadge.className = 'pwd-strength-badge weak';
                    }
                    if (segments[0]) segments[0].classList.add('active-weak');
                } else if (score === 2) {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Trung bình';
                        strengthBadge.className = 'pwd-strength-badge medium';
                    }
                    if (segments[0]) segments[0].classList.add('active-medium');
                    if (segments[1]) segments[1].classList.add('active-medium');
                } else if (score === 3) {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Khá an toàn';
                        strengthBadge.className = 'pwd-strength-badge good';
                    }
                    if (segments[0]) segments[0].classList.add('active-good');
                    if (segments[1]) segments[1].classList.add('active-good');
                    if (segments[2]) segments[2].classList.add('active-good');
                } else {
                    if (strengthBadge) {
                        strengthBadge.textContent = 'Rất an toàn';
                        strengthBadge.className = 'pwd-strength-badge strong';
                    }
                    segments.forEach(seg => {
                        if (seg) seg.classList.add('active-strong');
                    });
                }

                return score;
            }

            function checkMatch() {
                if (!pwdInput || !confirmPwdInput) return;
                const val1 = pwdInput.value;
                const val2 = confirmPwdInput.value;
                const wrapper = confirmPwdInput.closest('.acc-input-icon-wrap');
                const icon = wrapper ? wrapper.querySelector('.acc-input-icon') : null;
                
                if (val2.length > 0 && val1 === val2) {
                    if (wrapper) {
                        wrapper.style.borderColor = '#10b981';
                        wrapper.style.boxShadow = '0 0 0 3px rgba(16, 185, 129, 0.15)';
                    }
                    if (icon) icon.style.color = '#10b981';
                    if (matchHint) {
                        matchHint.innerHTML = '<i class="fa-solid fa-circle-check"></i> Mật khẩu xác nhận trùng khớp hoàn toàn';
                        matchHint.className = 'pwd-match-hint show-success';
                    }
                } else if (val2.length > 0) {
                    if (wrapper) {
                        wrapper.style.borderColor = '#ef4444';
                        wrapper.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.15)';
                    }
                    if (icon) icon.style.color = '#ef4444';
                    if (matchHint) {
                        matchHint.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> Mật khẩu xác nhận chưa trùng khớp';
                        matchHint.className = 'pwd-match-hint show-error';
                    }
                } else {
                    if (wrapper) {
                        wrapper.style.borderColor = '';
                        wrapper.style.boxShadow = '';
                    }
                    if (icon) icon.style.color = '';
                    if (matchHint) {
                        matchHint.innerHTML = '';
                        matchHint.className = 'pwd-match-hint';
                    }
                }
            }

            if (pwdInput) {
                pwdInput.addEventListener('input', function() {
                    updateStrength(this.value);
                    if (confirmPwdInput && confirmPwdInput.value.length > 0) {
                        checkMatch();
                    }
                });
            }

            if (confirmPwdInput) {
                confirmPwdInput.addEventListener('input', checkMatch);
            }

            const changePwdForm = document.getElementById('form-change-password');
            if (changePwdForm) {
                changePwdForm.addEventListener('submit', function(e) {
                    const val1 = pwdInput ? pwdInput.value : '';
                    const val2 = confirmPwdInput ? confirmPwdInput.value : '';
                    if (val1 !== val2) {
                        e.preventDefault();
                        if (window.AppDialog) {
                            AppDialog.alert('Mật khẩu xác nhận không khớp. Vui lòng kiểm tra lại!', 'Lỗi xác nhận', 'warning');
                        } else {
                            alert('Mật khẩu xác nhận không khớp. Vui lòng kiểm tra lại!');
                        }
                    }
                });
            }
        });
    </script>
}
