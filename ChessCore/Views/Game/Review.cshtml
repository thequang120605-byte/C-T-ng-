@model ChessCore.Controllers.GameReviewViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Phân tích ván đấu: " + Model.MatchTitle;
}

@section Styles {
    <link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />
    <style>
        .review-container {
            max-width: 1440px;
            width: 100%;
            height: calc(100vh - var(--navbar-height));
            max-height: calc(100vh - var(--navbar-height));
            margin: 0 auto;
            padding: 10px 20px;
            display: grid;
            grid-template-columns: minmax(460px, 1fr) clamp(380px, 32vw, 460px);
            gap: 16px;
            box-sizing: border-box;
            overflow: hidden;
            align-items: stretch;
        }

        .review-board-card {
            background: var(--bg-navy-panel);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 12px 18px 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            height: 100%;
            max-height: 100%;
            min-height: 0;
            box-sizing: border-box;
            overflow: hidden;
        }

        .review-match-header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border-color);
            flex-wrap: wrap;
            gap: 8px;
            flex-shrink: 0;
        }

        .review-match-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .review-match-title {
            font-size: 16px;
            font-weight: 800;
            color: var(--text-main);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .review-match-sub {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 1px;
        }

        .review-match-badge {
            background: rgba(212, 175, 55, 0.12);
            border: 1px solid rgba(212, 175, 55, 0.28);
            color: var(--accent-gold);
            font-size: 11px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 4px;
        }

        .review-board-wrapper {
            flex: 1 1 0;
            min-height: 0;
            max-height: 100%;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .review-board-inner {
            height: 100%;
            max-height: 100%;
            max-width: 100%;
            aspect-ratio: 9 / 10;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .review-analysis-card {
            background: var(--bg-navy-panel);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            height: 100%;
            max-height: 100%;
            min-height: 0;
            box-sizing: border-box;
            overflow-y: auto;
            overflow-x: hidden;
            gap: 8px;
        }

        .review-analysis-card::-webkit-scrollbar {
            width: 5px;
        }

        .review-analysis-card::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        .accuracy-box {
            display: flex;
            justify-content: space-around;
            background: var(--bg-navy-light);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 10px 12px;
            margin-bottom: 0;
            flex-shrink: 0;
        }

        .accuracy-item {
            text-align: center;
        }

        .accuracy-score {
            font-size: 22px;
            font-weight: 800;
            line-height: 1.1;
        }

        /* Eval Bar */
        .eval-bar-wrapper {
            width: 100%;
            height: 8px;
            background: #1e293b;
            border-radius: 4px;
            overflow: hidden;
            margin: 4px 0 6px;
            display: flex;
            flex-shrink: 0;
        }

        .eval-bar-red {
            background: linear-gradient(90deg, #ef4444, #f97316);
            height: 100%;
            transition: width 0.3s ease;
        }

        .eval-bar-black {
            background: #334155;
            height: 100%;
            flex: 1;
        }

        .move-history-scroll {
            flex: 1 1 0;
            min-height: 110px;
            max-height: 220px;
            overflow-y: auto;
            margin-bottom: 0;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: var(--bg-navy-dark);
        }

        .review-move-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 6px 12px;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: background 0.2s;
            font-size: 13px;
        }

        .review-move-item:hover, .review-move-item.active {
            background: var(--bg-navy-light);
        }

        .badge-judgment {
            font-size: 10.5px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 12px;
            text-transform: uppercase;
        }
        .badge-Brilliant { background: rgba(168, 85, 247, 0.2); color: #9333ea; }
        .badge-Best { background: rgba(16, 185, 129, 0.2); color: #059669; }
        .badge-Good { background: rgba(59, 130, 246, 0.2); color: #2563eb; }
        .badge-Inaccuracy { background: rgba(234, 179, 8, 0.2); color: #d97706; }
        .badge-Blunder { background: rgba(239, 68, 68, 0.2); color: #dc2626; }

        .review-controls {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 8px;
            flex-shrink: 0;
        }

        .btn-replay {
            padding: 6px 14px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--bg-navy-panel);
            color: var(--text-main);
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-replay:hover {
            background: var(--bg-navy-light);
            border-color: var(--accent-gold);
        }

        .btn-action-gold {
            background: linear-gradient(135deg, #f59e0b, #b45309) !important;
            color: #ffffff !important;
            padding: 7px 12px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(180, 83, 9, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.2);
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-action-gold:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(180, 83, 9, 0.4);
            color: #ffffff !important;
        }

        .btn-action-secondary {
            background: var(--bg-navy-light, #ffffff) !important;
            color: var(--text-main, #334155) !important;
            padding: 7px 12px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            border: 1px solid var(--border-color, #cbd5e1);
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-action-secondary:hover {
            transform: translateY(-1px);
            border-color: #b45309;
            color: #b45309 !important;
        }

        @@media (max-width: 900px) {
            .review-container {
                grid-template-columns: 1fr;
                height: auto;
                max-height: none;
                overflow-y: auto;
            }
            .review-board-card, .review-analysis-card {
                height: auto;
                max-height: none;
                overflow: visible;
            }
        }

        /* Quân cờ chuẩn */
        .chess-piece {
            cursor: pointer;
            transition: transform 0.2s ease, filter 0.2s ease;
        }
        .piece-circle {
            fill: #E2C28E !important;
            stroke: #4a3022 !important;
            stroke-width: 2 !important;
            filter: drop-shadow(1px 2px 4px rgba(0,0,0,0.4));
        }
        .piece-inner-circle {
            fill: none !important;
            stroke: #F5DEB3 !important;
            stroke-width: 3 !important;
            pointer-events: none;
        }
        .piece-text {
            font-size: 52px !important;
            font-weight: 900 !important;
            font-family: "SimSun", "STSong", "Songti SC", serif !important;
            pointer-events: none;
            user-select: none;
        }
        .chess-piece.black .piece-text {
            fill: #111111 !important;
        }
        .chess-piece.red .piece-text {
            fill: #c00000 !important;
        }
        .board-outer-bg { fill: #3e2723; }
        .board-background { fill: #e2c28e; }
        .board-lines line, .palace-lines line { stroke: #4a3022; stroke-width: 4; }
        .river-text text { fill: #78350f; font-size: 52px; font-weight: bold; font-family: "KaiTi", "STKaiti", serif; letter-spacing: 8px; text-anchor: middle; }
    </style>
}

<div class="review-container">
    <!-- CỘT TRÁI: BÀN CỜ REPLAY -->
    <div class="review-board-card">
        <div class="review-match-header">
            <div class="review-match-info">
                <h2 class="review-match-title">
                    <i class="fa-solid fa-chess-board" style="color: var(--accent-gold);"></i> @Model.MatchTitle
                </h2>
                <div class="review-match-sub">
                    <span class="review-match-badge"><i class="fa-solid fa-shield-halved"></i> @Model.GameMode</span>
                    <span><i class="fa-regular fa-calendar-days"></i> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    <span><i class="fa-solid fa-hashtag"></i> Mã trận: <strong>@Model.GameId</strong></span>
                </div>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <a href="/Dashboard" class="btn-action-secondary" style="padding: 7px 14px; text-decoration: none; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; border-radius: 8px;">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại Thống kê
                </a>
                <a href="/Game" class="btn-action-gold" style="padding: 7px 14px; text-decoration: none; font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; border-radius: 8px;">
                    <i class="fa-solid fa-chess-board"></i> Chơi ván mới
                </a>
            </div>
        </div>

        <!-- Eval Bar -->
        <div style="width: 100%; display: flex; justify-content: space-between; font-size: 12px; font-weight: bold;">
            <span style="color: #ef4444;"><i class="fa-solid fa-circle"></i> @Model.RedPlayerName (Đỏ)</span>
            <span id="eval-score-text" style="color: var(--text-main);">Cân bằng (+0.0)</span>
            <span style="color: #64748b;"><i class="fa-solid fa-circle"></i> @Model.BlackPlayerName (Đen)</span>
        </div>
        <div class="eval-bar-wrapper">
            <div id="eval-bar-red" class="eval-bar-red" style="width: 50%;"></div>
            <div class="eval-bar-black"></div>
        </div>

        <!-- Bàn cờ SVG -->
        <div class="review-board-wrapper">
            <div class="review-board-inner">
                <svg id="replay-board-svg" class="board-svg" viewBox="0 0 900 1000" preserveAspectRatio="xMidYMid meet" style="width: 100%; height: 100%; display: block;">
                    <rect x="0" y="0" width="900" height="1000" class="board-outer-bg" />
                    <rect x="15" y="15" width="870" height="970" class="board-background" />
                    <image id="board-image-texture" x="15" y="15" width="870" height="970" preserveAspectRatio="none" style="display: none; opacity: 0.95;" />
                    <g class="board-lines">
                        @for (var row = 0; row < 10; row++) { <line x1="50" y1="@(50 + row * 100)" x2="850" y2="@(50 + row * 100)" /> }
                        <line x1="50" y1="50" x2="50" y2="950" /><line x1="850" y1="50" x2="850" y2="950" />
                        @for (var col = 1; col < 8; col++) { <line x1="@(50 + col * 100)" y1="50" x2="@(50 + col * 100)" y2="450" /><line x1="@(50 + col * 100)" y1="550" x2="@(50 + col * 100)" y2="950" /> }
                    </g>
                    <g class="palace-lines"><line x1="350" y1="50" x2="550" y2="250" /><line x1="550" y1="50" x2="350" y2="250" /><line x1="350" y1="750" x2="550" y2="950" /><line x1="550" y1="750" x2="350" y2="950" /></g>
                    <g class="river-text"><text x="250" y="520">楚 河</text><text x="650" y="520">漢 界</text></g>
                    <g id="replay-moves-layer"></g><g id="replay-pieces-layer"></g>
                </svg>
            </div>
        </div>

        <!-- Bộ nút điều hướng Replay -->
        <div class="review-controls">
            <button type="button" class="btn-replay" id="btn-first" title="Về đầu"><i class="fa-solid fa-backward-step"></i></button>
            <button type="button" class="btn-replay" id="btn-prev" title="Nước trước"><i class="fa-solid fa-chevron-left"></i></button>
            <button type="button" class="btn-replay" id="btn-play" title="Tự động chạy"><i class="fa-solid fa-play"></i></button>
            <button type="button" class="btn-replay" id="btn-next" title="Nước kế tiếp"><i class="fa-solid fa-chevron-right"></i></button>
            <button type="button" class="btn-replay" id="btn-last" title="Về cuối"><i class="fa-solid fa-forward-step"></i></button>
        </div>
    </div>

    <!-- CỘT PHẢI: BÁO CÁO PHÂN TÍCH AI & DANH SÁCH NƯỚC ĐI -->
    <div class="review-analysis-card">
        <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 2px; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-brain" style="color: var(--accent-gold);"></i> Báo cáo Phân tích từ AI
        </h3>

        <!-- Chỉ số độ chính xác (Accuracy) -->
        <div class="accuracy-box">
            <div class="accuracy-item">
                <div style="font-size: 11px; color: #ef4444; font-weight: bold; margin-bottom: 2px;">ĐỎ (@Model.RedPlayerName)</div>
                <div class="accuracy-score" style="color: #ef4444;">@Model.AccuracyRed%</div>
                <small style="color: var(--text-muted); font-size: 10.5px;">Độ chuẩn xác</small>
            </div>
            <div style="width: 1px; background: var(--border-color);"></div>
            <div class="accuracy-item">
                <div style="font-size: 11px; color: #3b82f6; font-weight: bold; margin-bottom: 2px;">ĐEN (@Model.BlackPlayerName)</div>
                <div class="accuracy-score" style="color: #3b82f6;">@Model.AccuracyBlack%</div>
                <small style="color: var(--text-muted); font-size: 10.5px;">Độ chuẩn xác</small>
            </div>
        </div>

        <!-- BIỂU ĐỒ SÓNG DIỄN BIẾN THẾ TRẬN (EVALUATION GRAPH) -->
        <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 8px; padding: 8px 10px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <span style="font-size: 11.5px; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 6px;">
                    <i class="fa-solid fa-chart-area" style="color: var(--accent-gold);"></i> Biểu đồ diễn biến ưu thế
                </span>
                <span style="font-size: 10.5px; color: var(--text-muted);">Đỏ (+ trên) | Đen (- dưới)</span>
            </div>
            <div style="width: 100%; height: 75px; position: relative;">
                <canvas id="eval-chart-canvas" style="width: 100%; height: 100%; display: block;"></canvas>
            </div>
        </div>

        <!-- Nhận xét nước cờ hiện tại -->
        <div id="move-comment-box" style="background: var(--bg-navy-light); border-left: 3px solid var(--accent-gold); padding: 8px 12px; border-radius: 6px; min-height: 48px;">
            <div id="comment-title" style="font-weight: 700; font-size: 12px; color: var(--text-main); margin-bottom: 2px;">Khởi đầu ván cờ</div>
            <div id="comment-text" style="font-size: 12px; color: var(--text-muted); line-height: 1.35;">Hãy bấm các nút điều hướng hoặc chọn nước đi bên dưới để xem AI nhận xét.</div>
        </div>

        <!-- Danh sách cuộn nước đi -->
        <div class="move-history-scroll" id="moves-list">
            @for (int i = 0; i < Model.AnalyzedMoves.Count; i++)
            {
                var m = Model.AnalyzedMoves[i];
                <div class="review-move-item" data-index="@i" onclick="goToStep(@i);">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 11.5px; font-weight: bold; color: var(--text-muted); width: 26px;">#@m.MoveOrder</span>
                        <strong style="color: @(m.PieceColor == "Red" ? "#ef4444" : "var(--text-main)"); font-size: 12.5px;">@m.Notation</strong>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span class="badge-judgment badge-@m.Judgment">@m.Judgment</span>
                    </div>
                </div>
            }
        </div>

        <!-- Nút xuất biên bản PGN / In PDF -->
        <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center; flex-wrap: wrap; margin-top: 4px;">
            <button type="button" class="btn-action-secondary" onclick="exportNotation();" style="flex: 1; justify-content: center; padding: 6px 10px; font-size: 12px;">
                <i class="fa-solid fa-file-arrow-down"></i> Xuất PGN / Text
            </button>
            <button type="button" class="btn-action-secondary" onclick="window.print();" style="flex: 1; justify-content: center; padding: 6px 10px; font-size: 12px;">
                <i class="fa-solid fa-print"></i> In ván cờ
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const analyzedMoves = @Html.Raw(JsonSerializer.Serialize(Model.AnalyzedMoves));
        let currentStep = -1;
        let isPlaying = false;
        let playInterval = null;

        // Trạng thái ban đầu bàn cờ
        const initialPieces = [
            { row: 0, col: 0, type: 'Rook', text: '車', color: 'Black' },
            { row: 0, col: 1, type: 'Horse', text: '馬', color: 'Black' },
            { row: 0, col: 2, type: 'Elephant', text: '象', color: 'Black' },
            { row: 0, col: 3, type: 'Advisor', text: '士', color: 'Black' },
            { row: 0, col: 4, type: 'King', text: '將', color: 'Black' },
            { row: 0, col: 5, type: 'Advisor', text: '士', color: 'Black' },
            { row: 0, col: 6, type: 'Elephant', text: '象', color: 'Black' },
            { row: 0, col: 7, type: 'Horse', text: '馬', color: 'Black' },
            { row: 0, col: 8, type: 'Rook', text: '車', color: 'Black' },
            { row: 2, col: 1, type: 'Cannon', text: '炮', color: 'Black' },
            { row: 2, col: 7, type: 'Cannon', text: '炮', color: 'Black' },
            { row: 3, col: 0, type: 'Pawn', text: '卒', color: 'Black' },
            { row: 3, col: 2, type: 'Pawn', text: '卒', color: 'Black' },
            { row: 3, col: 4, type: 'Pawn', text: '卒', color: 'Black' },
            { row: 3, col: 6, type: 'Pawn', text: '卒', color: 'Black' },
            { row: 3, col: 8, type: 'Pawn', text: '卒', color: 'Black' },

            { row: 9, col: 0, type: 'Rook', text: '俥', color: 'Red' },
            { row: 9, col: 1, type: 'Horse', text: '傌', color: 'Red' },
            { row: 9, col: 2, type: 'Elephant', text: '相', color: 'Red' },
            { row: 9, col: 3, type: 'Advisor', text: '仕', color: 'Red' },
            { row: 9, col: 4, type: 'King', text: '帥', color: 'Red' },
            { row: 9, col: 5, type: 'Advisor', text: '仕', color: 'Red' },
            { row: 9, col: 6, type: 'Elephant', text: '相', color: 'Red' },
            { row: 9, col: 7, type: 'Horse', text: '傌', color: 'Red' },
            { row: 9, col: 8, type: 'Rook', text: '俥', color: 'Red' },
            { row: 7, col: 1, type: 'Cannon', text: '砲', color: 'Red' },
            { row: 7, col: 7, type: 'Cannon', text: '砲', color: 'Red' },
            { row: 6, col: 0, type: 'Pawn', text: '兵', color: 'Red' },
            { row: 6, col: 2, type: 'Pawn', text: '兵', color: 'Red' },
            { row: 6, col: 4, type: 'Pawn', text: '兵', color: 'Red' },
            { row: 6, col: 6, type: 'Pawn', text: '兵', color: 'Red' },
            { row: 6, col: 8, type: 'Pawn', text: '兵', color: 'Red' }
        ];

        function renderBoardAtStep(step) {
            const pieces = initialPieces.map(p => ({ ...p }));

            for (let i = 0; i <= step; i++) {
                const m = analyzedMoves[i];
                // Xóa quân bị bắt tại đích
                const capIdx = pieces.findIndex(p => p.row === m.ToX && p.col === m.ToY);
                if (capIdx !== -1) pieces.splice(capIdx, 1);

                // Di chuyển quân
                const mover = pieces.find(p => p.row === m.FromX && p.col === m.FromY);
                if (mover) {
                    mover.row = m.ToX;
                    mover.col = m.ToY;
                }
            }

            // Vẽ lên SVG
            const layer = document.getElementById('replay-pieces-layer');
            layer.replaceChildren();

            const skin = localStorage.getItem("chess_piece_skin") || "traditional";
            function getReviewPieceFileName(p, targetSkin) {
                const isRed = (p.color || "").toLowerCase() === "red";
                const cStr = isRed ? "Red" : "Black";
                const actualSkin = targetSkin === "Minimalist" ? "Minimalist White" : targetSkin;
                let pName = "";
                const t = (p.type || "").toLowerCase();
                if (t === "king" || t === "tướng") pName = isRed ? "Shuai" : "Jiang";
                else if (t === "advisor" || t === "sĩ" || t === "si") pName = "Shi";
                else if (t === "elephant" || t === "tượng" || t === "tuong") pName = "Xiang";
                else if (t === "horse" || t === "knight" || t === "mã" || t === "ma") pName = "Ma";
                else if (t === "rook" || t === "chariot" || t === "xe") pName = "Ju";
                else if (t === "cannon" || t === "pháo" || t === "phao") pName = "Pao";
                else pName = isRed ? "Bing" : "Zu";
                return `${actualSkin} ${cStr} ${pName}.png`;
            }

            pieces.forEach(p => {
                const x = 50 + p.col * 100;
                const y = 50 + p.row * 100;
                const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                g.setAttribute('class', `chess-piece ${(p.color || "").toLowerCase()}`);

                if (skin !== "traditional") {
                    const fileName = getReviewPieceFileName(p, skin);
                    const imgPath = `/images/pieces/${fileName}`;
                    g.innerHTML = `
                        <image x="${x - 44}" y="${y - 44}" width="88" height="88" href="${imgPath}" class="piece-image-skin" style="filter: drop-shadow(0 4px 6px rgba(0,0,0,0.35));" onerror="this.remove();" />
                    `;
                } else {
                    g.innerHTML = `
                        <circle cx="${x}" cy="${y}" r="42" class="piece-circle"></circle>
                        <circle cx="${x}" cy="${y}" r="35" class="piece-inner-circle"></circle>
                        <text x="${x}" y="${y + 2}" text-anchor="middle" dominant-baseline="middle" class="piece-text">${p.text}</text>
                    `;
                }
                layer.appendChild(g);
            });

            // Cập nhật Eval bar
            const evalText = document.getElementById('eval-score-text');
            const evalBarRed = document.getElementById('eval-bar-red');
            if (step >= 0 && step < analyzedMoves.length) {
                const moveData = analyzedMoves[step];
                const score = moveData.EvalScore;
                evalText.textContent = `Điểm thế trận: ${(score / 100).toFixed(1)}`;
                
                // Quy đổi sang phần trăm (từ -1000 đến +1000)
                let pct = 50 + (score / 20);
                pct = Math.max(5, Math.min(95, pct));
                evalBarRed.style.width = pct + '%';

                // Cập nhật nhận xét AI
                document.getElementById('comment-title').textContent = `Nước #${moveData.MoveOrder}: ${moveData.Notation} (${moveData.Judgment})`;
                document.getElementById('comment-text').textContent = moveData.Comment;
            } else {
                evalText.textContent = 'Cân bằng (+0.0)';
                evalBarRed.style.width = '50%';
                document.getElementById('comment-title').textContent = 'Khởi đầu ván cờ';
                document.getElementById('comment-text').textContent = 'Hãy bấm các nút điều hướng hoặc chọn nước đi bên dưới để xem AI nhận xét.';
            }

            // Highlight danh sách nước đi
            document.querySelectorAll('.review-move-item').forEach((el, idx) => {
                el.classList.toggle('active', idx === step);
            });

            drawEvalChart(step);
        }

        // Vẽ biểu đồ sóng diễn biến thế trận
        function drawEvalChart(currentStepIdx) {
            const canvas = document.getElementById('eval-chart-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * window.devicePixelRatio || 400;
            canvas.height = rect.height * window.devicePixelRatio || 90;
            const w = canvas.width;
            const h = canvas.height;
            const midY = h / 2;

            ctx.clearRect(0, 0, w, h);

            // Đường trục giữa 0 (cân bằng)
            ctx.strokeStyle = 'rgba(148, 163, 184, 0.4)';
            ctx.lineWidth = 1;
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(0, midY);
            ctx.lineTo(w, midY);
            ctx.stroke();
            ctx.setLineDash([]);

            if (!analyzedMoves || analyzedMoves.length === 0) return;

            const n = analyzedMoves.length;
            const stepX = w / Math.max(1, n - 1);

            // Vẽ dải đường cong ưu thế
            ctx.beginPath();
            ctx.moveTo(0, midY);
            analyzedMoves.forEach((m, idx) => {
                const x = idx * stepX;
                // clamp score between -600 and +600
                const sc = Math.max(-600, Math.min(600, m.EvalScore || 0));
                // scale to Y: dương thì vẽ lên trên (Y < midY), âm vẽ xuống dưới
                const y = midY - (sc / 600) * (midY - 10);
                if (idx === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            });

            ctx.strokeStyle = '#f59e0b';
            ctx.lineWidth = 2.5;
            ctx.lineJoin = 'round';
            ctx.stroke();

            // Vẽ điểm hiện tại đang xem (Con trỏ thời gian)
            if (currentStepIdx >= 0 && currentStepIdx < n) {
                const curX = currentStepIdx * stepX;
                const curSc = Math.max(-600, Math.min(600, analyzedMoves[currentStepIdx].EvalScore || 0));
                const curY = midY - (curSc / 600) * (midY - 10);

                // Đường dóng dọc
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(curX, 0);
                ctx.lineTo(curX, h);
                ctx.stroke();

                // Điểm tròn chấm sáng
                ctx.fillStyle = curSc >= 0 ? '#ef4444' : '#38bdf8';
                ctx.beginPath();
                ctx.arc(curX, curY, 5, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 2;
                ctx.stroke();
            }
        }

        function goToStep(step) {
            currentStep = Math.max(-1, Math.min(analyzedMoves.length - 1, step));
            renderBoardAtStep(currentStep);
        }

        document.getElementById('btn-first').onclick = () => goToStep(-1);
        document.getElementById('btn-prev').onclick = () => goToStep(currentStep - 1);
        document.getElementById('btn-next').onclick = () => goToStep(currentStep + 1);
        document.getElementById('btn-last').onclick = () => goToStep(analyzedMoves.length - 1);

        document.getElementById('btn-play').onclick = function() {
            if (isPlaying) {
                clearInterval(playInterval);
                isPlaying = false;
                this.innerHTML = '<i class="fa-solid fa-play"></i>';
            } else {
                isPlaying = true;
                this.innerHTML = '<i class="fa-solid fa-pause"></i>';
                playInterval = setInterval(() => {
                    if (currentStep < analyzedMoves.length - 1) {
                        goToStep(currentStep + 1);
                    } else {
                        clearInterval(playInterval);
                        isPlaying = false;
                        document.getElementById('btn-play').innerHTML = '<i class="fa-solid fa-play"></i>';
                    }
                }, 1200);
            }
        };

        function exportNotation() {
            let txt = `[Ván cờ Cờ Tướng Pro #${@Model.GameId}]\n[Ngày: ${new Date().toLocaleDateString()}]\n[Đỏ: @Model.RedPlayerName]\n[Đen: @Model.BlackPlayerName]\n\n`;
            analyzedMoves.forEach(m => {
                txt += `${m.MoveOrder}. ${m.Notation} (${m.Judgment})\n`;
            });

            const blob = new Blob([txt], { type: 'text/plain;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `BienBan_VanCo_${@Model.GameId}.txt`;
            a.click();
        }

        // Render trạng thái đầu tiên
        goToStep(analyzedMoves.length > 0 ? 0 : -1);
    </script>
}
