@{
    ViewData["Title"] = "Chơi Cờ Tướng";
}

<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />

<div class="game-page">

    <!-- ===================================================== -->
    <!-- CHỌN CHẾ ĐỘ CHƠI -->
    <!-- ===================================================== -->

    <section id="mode-selection" class="mode-selection">

        <div class="mode-selection-card">

            <h2>CHỌN CHẾ ĐỘ CHƠI</h2>

            <p class="mode-description">
                Hãy chọn cách bạn muốn tham gia ván cờ
            </p>

            <div class="mode-options">

                <!-- NGƯỜI VS NGƯỜI -->

                <button id="player-vs-player-btn" type="button" class="mode-option" aria-pressed="false">

                    <div class="mode-icon">
                        👥
                    </div>

                    <div class="mode-title">
                        NGƯỜI VS NGƯỜI
                    </div>

                    <div class="mode-description-small">
                        Hai người chơi cùng tham gia một ván cờ
                    </div>

                    <div class="mode-arrow">
                        →
                    </div>

                </button>


                <!-- NGƯỜI VS MÁY -->

                <button id="player-vs-computer-btn" type="button" class="mode-option" aria-pressed="false">

                    <div class="mode-icon">
                        🤖
                    </div>

                    <div class="mode-title">
                        NGƯỜI VS MÁY
                    </div>

                    <div class="mode-description-small">
                        Chơi Cờ Tướng với máy tính sử dụng AI
                    </div>

                    <div class="mode-arrow">
                        →
                    </div>

                </button>

            </div>


            <!-- ================================================= -->
            <!-- CHỌN ĐỘ KHÓ -->
            <!-- ================================================= -->

            <div id="difficulty-selection" style="
                    display: none;
                    margin-top: 25px;
                    padding: 20px;
                    border-radius: 12px;
                    background: rgba(255,255,255,0.06);
                ">

                <h3 style="
                        margin-bottom: 8px;
                        text-align: center;
                    ">
                    🤖 CHỌN ĐỘ KHÓ CỦA MÁY
                </h3>

                <p style="
                        text-align: center;
                        margin-bottom: 20px;
                        opacity: 0.8;
                    ">
                    Độ khó càng cao, máy sẽ tính toán nhiều nước đi hơn
                </p>


                <div class="difficulty-options" style="
                        display: grid;
                        grid-template-columns: repeat(4, 1fr);
                        gap: 12px;
                    ">

                    <!-- DỄ -->

                    <button type="button" class="difficulty-option" data-difficulty="1" aria-pressed="false" style="
                            padding: 15px 10px;
                            border-radius: 10px;
                            cursor: pointer;
                        ">

                        <div style="font-size: 26px;">
                            🟢
                        </div>

                        <div style="
                                font-weight: bold;
                                margin-top: 5px;
                            ">
                            DỄ
                        </div>

                        <small>
                            Depth 1
                        </small>

                    </button>


                    <!-- TRUNG BÌNH -->

                    <button type="button" class="difficulty-option" data-difficulty="2" aria-pressed="false" style="
                            padding: 15px 10px;
                            border-radius: 10px;
                            cursor: pointer;
                        ">

                        <div style="font-size: 26px;">
                            🟡
                        </div>

                        <div style="
                                font-weight: bold;
                                margin-top: 5px;
                            ">
                            TRUNG BÌNH
                        </div>

                        <small>
                            Depth 2
                        </small>

                    </button>


                    <!-- KHÓ -->

                    <button type="button" class="difficulty-option" data-difficulty="3" aria-pressed="false" style="
                            padding: 15px 10px;
                            border-radius: 10px;
                            cursor: pointer;
                        ">

                        <div style="font-size: 26px;">
                            🟠
                        </div>

                        <div style="
                                font-weight: bold;
                                margin-top: 5px;
                            ">
                            KHÓ
                        </div>

                        <small>
                            Depth 3
                        </small>

                    </button>


                    <!-- SIÊU KHÓ -->

                    <button type="button" class="difficulty-option" data-difficulty="4" aria-pressed="false" style="
                            padding: 15px 10px;
                            border-radius: 10px;
                            cursor: pointer;
                        ">

                        <div style="font-size: 26px;">
                            🔴
                        </div>

                        <div style="
                                font-weight: bold;
                                margin-top: 5px;
                            ">
                            SIÊU KHÓ
                        </div>

                        <small>
                            Depth 4
                        </small>

                    </button>

                </div>


                <!-- THÔNG TIN ĐỘ KHÓ -->

                <div id="difficulty-description" style="
                        margin-top: 15px;
                        text-align: center;
                        min-height: 24px;
                        font-size: 14px;
                    ">
                    Chưa chọn độ khó
                </div>

            </div>


            <!-- ================================================= -->
            <!-- CHẾ ĐỘ ĐÃ CHỌN -->
            <!-- ================================================= -->

            <div class="selected-mode">

                <span class="selected-mode-label">
                    Chế độ:
                </span>

                <strong id="selected-mode-text">
                    Chưa chọn chế độ chơi
                </strong>

            </div>


            <!-- ================================================= -->
            <!-- ĐỘ KHÓ ĐÃ CHỌN -->
            <!-- ================================================= -->

            <div id="selected-difficulty-container" style="
                    display: none;
                    margin-top: 10px;
                    text-align: center;
                ">

                <span>
                    Độ khó:
                </span>

                <strong id="selected-difficulty-text">
                    Chưa chọn
                </strong>

            </div>


            <!-- ================================================= -->
            <!-- BẮT ĐẦU -->
            <!-- ================================================= -->

            <button id="start-game-btn" type="button" class="start-game-btn" disabled>
                🎮 BẮT ĐẦU VÁN
            </button>

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- GAME CONTENT -->
    <!-- ===================================================== -->

    <section id="game-content" class="game-content hidden">

        <!-- ================================================= -->
        <!-- GAME CONTAINER -->
        <!-- ================================================= -->

        <section class="game-container">


            <!-- ============================================= -->
            <!-- QUÂN ĐỎ -->
            <!-- ============================================= -->

            <aside class="player-panel red-player-panel">

                <div class="player-panel-header">

                    <div class="player-color-dot red-dot"></div>

                    <h2>QUÂN ĐỎ</h2>

                </div>


                <div class="player-info">

                    <div class="avatar red-avatar">
                        👤
                    </div>

                    <div class="player-details">

                        <strong id="red-player-name">
                            Người chơi 1
                        </strong>

                        <p id="red-player-status">
                            ⚪ Đang chờ
                        </p>

                    </div>

                </div>


                <div class="player-piece-preview">
                </div>

            </aside>


            <!-- ============================================= -->
            <!-- BÀN CỜ -->
            <!-- ============================================= -->

            <section class="board-container">

                <div class="xiangqi-board-wrapper">

                    <div id="chess-board" class="xiangqi-board">

                        <svg id="board-svg" viewBox="0 0 900 1000" preserveAspectRatio="xMidYMid meet"
                            xmlns="http://www.w3.org/2000/svg">

                            <!-- NỀN -->

                            <rect x="20" y="20" width="860" height="960" class="board-background" />


                            <!-- ĐƯỜNG NGANG -->

                            <g class="board-lines">

                                <line x1="50" y1="50" x2="850" y2="50" />
                                <line x1="50" y1="150" x2="850" y2="150" />
                                <line x1="50" y1="250" x2="850" y2="250" />
                                <line x1="50" y1="350" x2="850" y2="350" />
                                <line x1="50" y1="450" x2="850" y2="450" />
                                <line x1="50" y1="550" x2="850" y2="550" />
                                <line x1="50" y1="650" x2="850" y2="650" />
                                <line x1="50" y1="750" x2="850" y2="750" />
                                <line x1="50" y1="850" x2="850" y2="850" />
                                <line x1="50" y1="950" x2="850" y2="950" />

                            </g>


                            <!-- BIÊN DỌC -->

                            <g class="board-lines">

                                <line x1="50" y1="50" x2="50" y2="950" />

                                <line x1="850" y1="50" x2="850" y2="950" />

                            </g>


                            <!-- ĐƯỜNG DỌC -->

                            <g class="board-lines">

                                <line x1="150" y1="50" x2="150" y2="450" />
                                <line x1="150" y1="550" x2="150" y2="950" />

                                <line x1="250" y1="50" x2="250" y2="450" />
                                <line x1="250" y1="550" x2="250" y2="950" />

                                <line x1="350" y1="50" x2="350" y2="450" />
                                <line x1="350" y1="550" x2="350" y2="950" />

                                <line x1="450" y1="50" x2="450" y2="450" />
                                <line x1="450" y1="550" x2="450" y2="950" />

                                <line x1="550" y1="50" x2="550" y2="450" />
                                <line x1="550" y1="550" x2="550" y2="950" />

                                <line x1="650" y1="50" x2="650" y2="450" />
                                <line x1="650" y1="550" x2="650" y2="950" />

                                <line x1="750" y1="50" x2="750" y2="450" />
                                <line x1="750" y1="550" x2="750" y2="950" />

                            </g>


                            <!-- SÔNG -->

                            <g class="river-text">

                                <text x="250" y="520" text-anchor="middle">
                                    楚 河
                                </text>

                                <text x="650" y="520" text-anchor="middle">
                                    漢 界
                                </text>

                            </g>


                            <!-- CUNG TƯỚNG TRÊN -->

                            <g class="palace-lines">

                                <line x1="350" y1="50" x2="550" y2="250" />

                                <line x1="550" y1="50" x2="350" y2="250" />

                            </g>


                            <!-- CUNG TƯỚNG DƯỚI -->

                            <g class="palace-lines">

                                <line x1="350" y1="750" x2="550" y2="950" />

                                <line x1="550" y1="750" x2="350" y2="950" />

                            </g>


                            <!-- LAYER -->

                            <g id="moves-layer"></g>

                            <g id="pieces-layer"></g>

                        </svg>


                        <!-- CHIẾU TƯỚNG -->

                        <div id="check-overlay" class="check-overlay">
                            <div class="check-content">
                                <div id="check-overlay-icon" class="check-icon">
                                    ⚠️
                                </div>

                                <h2 id="check-overlay-title">
                                    CHIẾU TƯỚNG!
                                </h2>

                                <p id="check-overlay-message">
                                    Vua đang bị đe dọa.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </section>


            <!-- ============================================= -->
            <!-- QUÂN ĐEN -->
            <!-- ============================================= -->

            <aside class="player-panel black-player-panel">

                <div class="player-panel-header">

                    <div class="player-color-dot black-dot"></div>

                    <h2>QUÂN ĐEN</h2>

                </div>


                <div class="player-info">

                    <div class="avatar black-avatar">
                        👤
                    </div>

                    <div class="player-details">

                        <strong id="black-player-name">
                            Người chơi 2
                        </strong>

                        <p id="black-player-status">
                            ⚪ Đang chờ
                        </p>

                    </div>

                </div>


                <div class="player-piece-preview black-pieces">
                </div>

            </aside>

        </section>


        <!-- ================================================= -->
        <!-- TRẠNG THÁI -->
        <!-- ================================================= -->

        <section class="game-status">

            <div class="turn-status-box">

                <h2 id="turn-status">
                    Lượt của QUÂN ĐỎ
                </h2>

            </div>

        </section>


        <!-- ================================================= -->
        <!-- ACTIONS -->
        <!-- ================================================= -->

        <section class="game-actions">

            <button id="new-game-btn" type="button" class="new-game-button">
                🔄 VÁN MỚI
            </button>

            <button id="change-mode-btn" type="button" class="change-mode-button">
                ⚙️ ĐỔI CHẾ ĐỘ
            </button>

            <button id="resign-btn" type="button" class="resign-button">
                🏳️ ĐẦU HÀNG
            </button>

        </section>

    </section>

</div>


<!-- ========================================================= -->
<!-- POPUP KẾT QUẢ -->
<!-- ========================================================= -->

<div id="game-result-modal" class="game-modal">

    <div class="game-modal-content">

        <div class="result-icon">
            🏆
        </div>

        <h1 id="result-title">
            CHIẾN THẮNG
        </h1>

        <h2 id="winner-name">
            🔴 QUÂN ĐỎ
        </h2>

        <p id="result-message">
            Đã giành chiến thắng!
        </p>

        <div class="modal-actions">

            <button id="result-new-game-btn" type="button">
                🔄 VÁN MỚI
            </button>

            <button id="result-close-btn" type="button" class="secondary-modal-button">
                ĐÓNG
            </button>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- POPUP ĐẦU HÀNG -->
<!-- ========================================================= -->

<div id="resign-modal" class="game-modal">

    <div class="game-modal-content">

        <div class="resign-icon">
            ⚠️
        </div>

        <h1>
            XÁC NHẬN ĐẦU HÀNG
        </h1>

        <p>
            Bạn có chắc chắn muốn đầu hàng không?
        </p>

        <div class="modal-actions">

            <button id="confirm-resign-btn" type="button" class="danger-btn">
                🏳️ ĐẦU HÀNG
            </button>

            <button id="cancel-resign-btn" type="button" class="secondary-modal-button">
                HỦY
            </button>

        </div>

    </div>

</div>


<script src="~/js/game.js" asp-append-version="true">
</script>