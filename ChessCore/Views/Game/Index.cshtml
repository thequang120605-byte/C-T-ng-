@{
    ViewData["Title"] = "Chơi Cờ";
}

<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />

<div class="game-view-container">

    <!-- ===================================================== -->
    <!-- MÀN HÌNH CHỌN CHẾ ĐỘ (MODE SELECTION) -->
    <!-- ===================================================== -->
    <section id="mode-selection" class="mode-overlay">
        <div class="mode-card">
            <!-- HEADER EMBLEM -->
            <div class="mode-header-badge" style="display: inline-flex; align-items: center; gap: 8px;">
                <img src="~/images/logo.svg" alt="Logo" style="width: 26px; height: 26px; border-radius: 50%; vertical-align: middle;" />
                <span>CỜ TƯỚNG VIỆT NAM</span>
            </div>

            <h2 class="mode-card-title">CHỌN CHẾ ĐỘ CHƠI</h2>
            <p class="mode-desc">Hãy chọn cách bạn muốn tham gia ván cờ</p>

            <div class="mode-buttons">
                <!-- NGƯỜI VS NGƯỜI -->
                <button id="player-vs-player-btn" class="mode-btn" type="button">
                    <div class="mode-icon-circle mode-pvp-circle">
                        <i class="fa-solid fa-user-group"></i>
                    </div>
                    <span class="mode-title">Người vs Người</span>
                    <span class="mode-subtitle">Chơi 2 người trên cùng thiết bị</span>
                    <span class="mode-active-indicator"><i class="fa-solid fa-circle-check"></i></span>
                </button>

                <!-- NGƯỜI VS MÁY -->
                <button id="player-vs-computer-btn" class="mode-btn" type="button">
                    <div class="mode-icon-circle mode-ai-circle">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <span class="mode-title">Người vs Máy</span>
                    <span class="mode-subtitle">Thử thách với AI Minimax</span>
                    <span class="mode-active-indicator"><i class="fa-solid fa-circle-check"></i></span>
                </button>

                <!-- CHƠI QUA MẠNG -->
                <button id="player-vs-online-btn" class="mode-btn" type="button">
                    <div class="mode-icon-circle mode-online-circle">
                        <i class="fa-solid fa-globe"></i>
                    </div>
                    <span class="mode-title">Chơi qua mạng</span>
                    <span class="mode-subtitle">Tạo phòng chơi với bạn bè</span>
                    <span class="mode-active-indicator"><i class="fa-solid fa-circle-check"></i></span>
                </button>
            </div>

            <!-- CHỌN ĐỘ KHÓ -->
            <div id="difficulty-selection" class="difficulty-panel hidden">
                <div class="diff-header">
                    <i class="fa-solid fa-brain" style="color: var(--accent-gold);"></i>
                    <h3>Chọn độ khó của máy</h3>
                </div>
                <div class="diff-buttons">
                    <button class="diff-btn" data-difficulty="1" type="button">
                        <i class="fa-solid fa-seedling" style="color: #22c55e;"></i>
                        <span class="diff-name">Dễ</span>
                        <span class="diff-depth">Depth 1</span>
                    </button>
                    <button class="diff-btn" data-difficulty="2" type="button">
                        <i class="fa-solid fa-shield-halved" style="color: #f59e0b;"></i>
                        <span class="diff-name">Trung bình</span>
                        <span class="diff-depth">Depth 2</span>
                    </button>
                    <button class="diff-btn" data-difficulty="3" type="button">
                        <i class="fa-solid fa-fire" style="color: #f97316;"></i>
                        <span class="diff-name">Khó</span>
                        <span class="diff-depth">Depth 3</span>
                    </button>
                    <button class="diff-btn" data-difficulty="4" type="button">
                        <i class="fa-solid fa-skull" style="color: #ef4444;"></i>
                        <span class="diff-name">Siêu khó</span>
                        <span class="diff-depth">Depth 4</span>
                    </button>
                </div>
                <p id="difficulty-description" class="diff-desc-text"></p>
            </div>

            <!-- ONLINE LOBBY -->
            <div id="online-selection" class="difficulty-panel hidden">
                <div class="diff-header">
                    <i class="fa-solid fa-network-wired" style="color: #10b981;"></i>
                    <h3>Sảnh chờ Online</h3>
                </div>
                <div class="lobby-actions">
                    <p class="lobby-hint">Nhập mã bàn đối thủ cung cấp để tham gia, hoặc tạo bàn mới.</p>
                    <div class="lobby-input-group">
                        <input type="text" id="online-room-id" placeholder="Nhập mã bàn 8 ký tự" maxlength="8" autocapitalize="characters" autocomplete="off" />
                        <button id="join-online-btn" class="btn-lobby-action" type="button">
                            <i class="fa-solid fa-right-to-bracket"></i> Vào bàn
                        </button>
                    </div>
                    <button id="create-online-btn" class="btn-lobby-create" type="button">
                        <i class="fa-solid fa-plus"></i> Tạo bàn
                    </button>

                    <!-- DANH SÁCH BÀN ĐANG CHỜ -->
                    <div class="open-rooms-section" style="margin-top: 16px; border-top: 1px dashed var(--border-color); padding-top: 12px; text-align: left;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 13px; font-weight: bold; color: var(--accent-gold);"><i class="fa-solid fa-list"></i> Các phòng đang mở</span>
                            <button id="refresh-rooms-btn" type="button" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 12px;">
                                <i class="fa-solid fa-rotate-right"></i> Làm mới
                            </button>
                        </div>
                        <div id="open-rooms-list" style="display: flex; flex-direction: column; gap: 6px; max-height: 120px; overflow-y: auto;">
                            <div style="color: var(--text-muted); font-size: 12px; text-align: center; padding: 10px;">Đang tải danh sách phòng...</div>
                        </div>
                    </div>

                    <!-- DANH SÁCH TRẬN ĐANG ĐẤU TRỰC TIẾP (DÀNH CHO KHÁN GIẢ) -->
                    <div class="live-matches-section" style="margin-top: 14px; border-top: 1px dashed var(--border-color); padding-top: 12px; text-align: left;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 13px; font-weight: bold; color: #ef4444;"><i class="fa-solid fa-tower-broadcast"></i> Đang diễn ra trực tiếp (Khán giả)</span>
                            <button id="refresh-live-btn" type="button" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 12px;">
                                <i class="fa-solid fa-rotate-right"></i> Làm mới
                            </button>
                        </div>
                        <div id="live-matches-list" style="display: flex; flex-direction: column; gap: 6px; max-height: 120px; overflow-y: auto;">
                            <div style="color: var(--text-muted); font-size: 12px; text-align: center; padding: 10px;">Chưa có trận đấu trực tiếp nào.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- THÔNG TIN ĐÃ CHỌN -->
            <div class="selection-summary">
                <div class="summary-pill">
                    <i class="fa-solid fa-gamepad summary-icon"></i>
                    <span>Chế độ:</span>
                    <strong id="selected-mode-text" class="highlight-text">Chưa chọn chế độ chơi</strong>
                </div>
                <div id="selected-difficulty-container" class="summary-pill hidden">
                    <i class="fa-solid fa-gauge-high summary-icon"></i>
                    <span>Độ khó:</span>
                    <strong id="selected-difficulty-text" class="highlight-text">Chưa chọn</strong>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px;">
                <button id="start-game-btn" class="btn-primary start-btn" disabled type="button" style="width: 100%; justify-content: center; font-size: 16px; padding: 14px 20px;">
                    <i class="fa-solid fa-play"></i> BẮT ĐẦU VÁN CỜ
                </button>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
                    <button id="board-editor-open-btn" class="btn-secondary" type="button" style="width: 100%; border-radius: 12px; font-weight: 700; font-size: 13.5px; padding: 10px 12px; gap: 8px; display: inline-flex; align-items: center; justify-content: center;" title="Tự xếp thế cờ tùy chỉnh để AI phân tích hoặc đấu tiếp">
                        <i class="fa-solid fa-chess-board" style="color: var(--accent-gold);"></i> Xếp thế cờ
                    </button>
                    <button id="opening-explorer-open-btn" class="btn-secondary" type="button" style="width: 100%; border-radius: 12px; font-weight: 700; font-size: 13.5px; padding: 10px 12px; gap: 8px; display: inline-flex; align-items: center; justify-content: center;" title="Tra cứu các thế trận khai cuộc và tỷ lệ thắng">
                        <i class="fa-solid fa-book-bookmark" style="color: var(--accent-gold);"></i> Khai cuộc ECCO
                    </button>
                    <button id="mode-import-fen-btn" class="btn-secondary" type="button" style="width: 100%; border-radius: 12px; font-weight: 700; font-size: 13.5px; padding: 10px 12px; gap: 8px; display: inline-flex; align-items: center; justify-content: center;" title="Nạp thế cờ từ chuỗi FEN để bắt đầu chơi">
                        <i class="fa-solid fa-file-import" style="color: var(--accent-gold);"></i> Nạp FEN
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================================================== -->
    <!-- GIAO DIỆN CHƠI CỜ CHÍNH -->
    <!-- ===================================================== -->
    <section id="game-content" class="game-layout hidden">
        
        <!-- CỘT TRÁI: BÀN CỜ VÀ THÔNG TIN NGƯỜI CHƠI -->
        <div class="board-column">
            
            <!-- THÔNG TIN ĐỐI THỦ (QUÂN ĐEN) -->
            <div class="player-bar player-black">
                <div class="player-info-left">
                    <div class="player-avatar black-bg"><i class="fa-solid fa-user"></i></div>
                    <div class="player-details">
                        <strong id="black-player-name">Quân Đen</strong>
                        <span id="black-player-status" class="status-text">Đang chờ...</span>
                    </div>
                </div>
                <div class="player-captured black-pieces">
                    <!-- Quân bị bắt sẽ hiển thị ở đây -->
                </div>
                <div id="black-player-timer" class="player-timer">03:00</div>
            </div>

            <!-- BÀN CỜ CHÍNH -->
            <div class="board-wrapper">
                <div id="chess-board" class="xiangqi-board">
                    <svg id="board-svg" viewBox="0 0 900 1000" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
                        <!-- NỀN -->
                        <rect x="0" y="0" width="900" height="1000" class="board-outer-bg" fill="#3E2723" />
                        <rect x="15" y="15" width="870" height="970" class="board-background" fill="#E2C28E" />
                        <!-- ẢNH MẶT BÀN CỜ THỰC TẾ (NẾU CÓ CHỌN) -->
                        <image id="board-image-texture" x="15" y="15" width="870" height="970" preserveAspectRatio="none" style="display: none; opacity: 0.95;" />
                        <rect x="45" y="45" width="810" height="910" class="board-inner-border" fill="none" stroke="#5D4037" stroke-width="4" />

                        <!-- LƯỚI BÀN CỜ -->
                        <g class="board-lines">
                            <!-- Ngang -->
                            <line x1="50" y1="50" x2="850" y2="50" />
                            <line x1="50" y1="150" x2="850" y2="150" />
                            <line x1="50" y1="250" x2="850" y2="250" />
                            <line x1="50" y1="350" x2="850" y2="350" />
                            <line x1="50" y1="450" x2="850" y2="450" />
                            <line x1="50" y1="550" x2="850" y2="550" />
                            <line x1="50" y1="650" x2="850" y2="650" />
                            <line x1="50" y1="750" x2="850" y2="750" />
                            <line x1="50" y1="850" x2="850" y2="850" />
                            <line x1="50" y1="950" x2="850" y2="950" />
                            
                            <!-- Dọc Biên -->
                            <line x1="50" y1="50" x2="50" y2="950" />
                            <line x1="850" y1="50" x2="850" y2="950" />
                            
                            <!-- Dọc Trong -->
                            <line x1="150" y1="50" x2="150" y2="450" /><line x1="150" y1="550" x2="150" y2="950" />
                            <line x1="250" y1="50" x2="250" y2="450" /><line x1="250" y1="550" x2="250" y2="950" />
                            <line x1="350" y1="50" x2="350" y2="450" /><line x1="350" y1="550" x2="350" y2="950" />
                            <line x1="450" y1="50" x2="450" y2="450" /><line x1="450" y1="550" x2="450" y2="950" />
                            <line x1="550" y1="50" x2="550" y2="450" /><line x1="550" y1="550" x2="550" y2="950" />
                            <line x1="650" y1="50" x2="650" y2="450" /><line x1="650" y1="550" x2="650" y2="950" />
                            <line x1="750" y1="50" x2="750" y2="450" /><line x1="750" y1="550" x2="750" y2="950" />
                        <path class="star-marks" d="M 55 330 L 55 345 L 70 345 M 55 370 L 55 355 L 70 355 M 245 330 L 245 345 L 230 345 M 255 330 L 255 345 L 270 345 M 245 370 L 245 355 L 230 355 M 255 370 L 255 355 L 270 355 M 445 330 L 445 345 L 430 345 M 455 330 L 455 345 L 470 345 M 445 370 L 445 355 L 430 355 M 455 370 L 455 355 L 470 355 M 645 330 L 645 345 L 630 345 M 655 330 L 655 345 L 670 345 M 645 370 L 645 355 L 630 355 M 655 370 L 655 355 L 670 355 M 845 330 L 845 345 L 830 345 M 845 370 L 845 355 L 830 355 M 55 630 L 55 645 L 70 645 M 55 670 L 55 655 L 70 655 M 245 630 L 245 645 L 230 645 M 255 630 L 255 645 L 270 645 M 245 670 L 245 655 L 230 655 M 255 670 L 255 655 L 270 655 M 445 630 L 445 645 L 430 645 M 455 630 L 455 645 L 470 645 M 445 670 L 445 655 L 430 655 M 455 670 L 455 655 L 470 655 M 645 630 L 645 645 L 630 645 M 655 630 L 655 645 L 670 645 M 645 670 L 645 655 L 630 655 M 655 670 L 655 655 L 670 655 M 845 630 L 845 645 L 830 645 M 845 670 L 845 655 L 830 655 M 145 230 L 145 245 L 130 245 M 155 230 L 155 245 L 170 245 M 145 270 L 145 255 L 130 255 M 155 270 L 155 255 L 170 255 M 745 230 L 745 245 L 730 245 M 755 230 L 755 245 L 770 245 M 745 270 L 745 255 L 730 255 M 755 270 L 755 255 L 770 255 M 145 730 L 145 745 L 130 745 M 155 730 L 155 745 L 170 745 M 145 770 L 145 755 L 130 755 M 155 770 L 155 755 L 170 755 M 745 730 L 745 745 L 730 745 M 755 730 L 755 745 L 770 745 M 745 770 L 745 755 L 730 755 M 755 770 L 755 755 L 770 755" stroke="#4a3022" stroke-width="2" fill="none" />
                        </g>

                        <!-- SÔNG -->
                        <g class="river-text">
                            <text id="river-text-left" x="250" y="520" text-anchor="middle">楚 河</text>
                            <text id="river-text-right" x="650" y="520" text-anchor="middle">漢 界</text>
                        </g>

                        <!-- CUNG TƯỚNG TRÊN -->
                        <g class="palace-lines">
                            <line x1="350" y1="50" x2="550" y2="250" />
                            <line x1="550" y1="50" x2="350" y2="250" />
                        </g>

                        <!-- CUNG TƯỚNG DƯỚI -->
                        <g class="palace-lines">
                            <line x1="350" y1="750" x2="550" y2="950" />
                            <line x1="550" y1="750" x2="350" y2="950" />
                        </g>

                        <!-- LAYER -->
                        <g id="moves-layer"></g>
                        <g id="pieces-layer"></g>
                        <g id="hint-layer"></g>
                    </svg>

                    <!-- CHIẾU TƯỚNG OVERLAY -->
                    <div id="check-overlay" class="check-overlay hidden">
                        <div class="check-content">
                            <div class="check-icon"><i class="fa-solid fa-bolt"></i></div>
                            <h2 id="check-overlay-title">CHIẾU TƯỚNG!</h2>
                            <p id="check-overlay-message">Vua đang bị đe dọa.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- THÔNG TIN NGƯỜI CHƠI (QUÂN ĐỎ) -->
            <div class="player-bar player-red">
                <div class="player-info-left">
                    <div class="player-avatar red-bg"><i class="fa-solid fa-user"></i></div>
                    <div class="player-details">
                        <strong id="red-player-name">Quân Đỏ</strong>
                        <span id="red-player-status" class="status-text">Đang chờ...</span>
                    </div>
                </div>
                <div class="player-captured red-pieces">
                    <!-- Quân bị bắt sẽ hiển thị ở đây -->
                </div>
                <div id="red-player-timer" class="player-timer">03:00</div>
            </div>
        </div>

        <!-- CỘT PHẢI: ĐIỀU KHIỂN & LỊCH SỬ NƯỚC ĐI -->
        <div class="control-column">
            
            <div class="panel-box game-status-box">
                <div class="status-header">Trạng thái ván đấu</div>

            <div id="room-info-box" class="panel-box room-info-box hidden" style="border: 1px solid var(--accent-gold); background: rgba(212, 175, 55, 0.05);">
                <div class="status-header" style="color: var(--accent-gold);"><i class="fa-solid fa-globe"></i> Phòng Online</div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                    <span style="font-size: 14px; color: var(--text-muted);">Mã phòng:</span>
                    <strong id="display-room-code" style="font-size: 18px; letter-spacing: 2px; color: var(--text-main);">----</strong>
                </div>
                <button id="copy-room-code-btn" class="btn-secondary" style="width: 100%; margin-top: 10px; padding: 6px; font-size: 12px;">
                    <i class="fa-regular fa-copy"></i> Sao chép mã
                </button>
                <div id="opponent-invite-panel" class="opponent-invite-panel hidden">
                    <label for="opponent-player-id">Mời đối thủ bằng ID người chơi</label>
                    <div class="opponent-invite-row">
                        <input type="text" id="opponent-player-id" placeholder="Ví dụ: CT-12345" autocomplete="off" />
                        <button id="invite-player-btn" type="button"><i class="fa-solid fa-user-plus"></i> Mời chơi</button>
                    </div>
                    <p id="invite-player-status" role="status" aria-live="polite"></p>
                </div>
            </div>
                <div class="turn-indicator">
                    <i class="fa-solid fa-chess"></i> 
                    <span id="turn-status">Lượt của QUÂN ĐỎ</span>
                    <button id="quick-sound-btn" class="quick-sound-btn" type="button" title="Bật/Tắt âm thanh" style="margin-left: auto; background: none; border: none; color: var(--accent-gold); cursor: pointer; font-size: 16px;">
                        <i class="fa-solid fa-volume-high"></i>
                    </button>
                </div>
                <!-- NHẬN DIỆN THẾ TRẬN KHAI CUỘC -->
                <div id="opening-recognition-panel" style="margin-top: 10px; padding: 6px 12px; background: rgba(212, 175, 55, 0.08); border: 1px solid rgba(212, 175, 55, 0.25); border-radius: 8px; display: flex; align-items: center; justify-content: space-between; font-size: 12.5px;">
                    <div style="display: flex; align-items: center; gap: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <i class="fa-solid fa-book-open" style="color: var(--accent-gold);"></i>
                        <span style="color: var(--text-muted);">Khai cuộc:</span>
                        <strong id="opening-book-name" style="color: var(--accent-gold);">Chưa định hình</strong>
                    </div>
                    <span id="opening-book-code" style="font-size: 11px; background: rgba(255, 255, 255, 0.08); padding: 2px 6px; border-radius: 4px; color: #94a3b8;">ECCO</span>
                </div>
            </div>

            <!-- CHAT ONLINE CHO PHÒNG ĐẤU -->
            <div id="online-chat-box" class="panel-box online-chat-box hidden">
                <div class="status-header">
                    <i class="fa-solid fa-comments" style="color: #38bdf8;"></i> Trò chuyện trong trận
                </div>
                <div id="chat-messages" class="chat-messages-container" style="height: 120px; overflow-y: auto; background: var(--bg-navy-dark); border-radius: 6px; padding: 8px; font-size: 13px; margin-bottom: 8px; display: flex; flex-direction: column; gap: 6px;">
                    <div style="color: var(--text-muted); font-size: 11px; text-align: center; font-style: italic;">Chào mừng bạn đến phòng đấu online!</div>
                </div>
                <div class="chat-input-row" style="display: flex; gap: 6px;">
                    <input type="text" id="chat-input" placeholder="Nhập tin nhắn..." maxlength="150" autocomplete="off" style="flex: 1; padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-navy-dark); color: var(--text-main); font-size: 12px;" />
                    <button id="send-chat-btn" type="button" class="btn-primary" style="padding: 6px 12px; font-size: 12px;">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
                <div class="quick-emojis" style="display: flex; gap: 6px; margin-top: 6px; justify-content: center;">
                    <button type="button" class="quick-chat-tag" data-msg="Chúc bạn chơi vui vẻ! 👍" style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); color: var(--text-muted); padding: 2px 8px; border-radius: 4px; font-size: 11px; cursor: pointer;">👍 Chúc vui</button>
                    <button type="button" class="quick-chat-tag" data-msg="Nước cờ hay quá! 👏" style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); color: var(--text-muted); padding: 2px 8px; border-radius: 4px; font-size: 11px; cursor: pointer;">👏 Nước hay</button>
                    <button type="button" class="quick-chat-tag" data-msg="Nhanh lên bạn ơi! ⏳" style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); color: var(--text-muted); padding: 2px 8px; border-radius: 4px; font-size: 11px; cursor: pointer;">⏳ Nhanh lên</button>
                </div>
            </div>

            <!-- ĐÁNH GIÁ THẾ TRẬN (HEURISTIC & MẠNG NƠ-RON) -->
            <section class="panel-box evaluation-panel" aria-labelledby="evaluation-title">
                <div class="section-title-row">
                    <h3 id="evaluation-title"><i class="fa-solid fa-chart-simple text-gold"></i> Đánh giá thế trận</h3>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <button id="engine-mode-toggle" class="last-move-toggle" type="button" title="Chuyển đổi giữa Động cơ Heuristic và Mạng Nơ-ron (NNUE)" style="background: rgba(212, 175, 55, 0.15); color: var(--accent-gold-dark); border-color: rgba(212, 175, 55, 0.3);">
                            <i class="fa-solid fa-brain"></i> <span id="engine-mode-name">Heuristic</span>
                        </button>
                        <button id="last-move-toggle" class="last-move-toggle" type="button" aria-controls="last-move-box" aria-expanded="false">Nước vừa đi</button>
                    </div>
                </div>
                <div class="advantage-summary">
                    <span id="advantage-label">Thế trận cân bằng</span>
                    <strong id="advantage-score">0.00</strong>
                </div>
                <div id="advantage-meter" class="advantage-meter" role="meter" aria-label="Ưu thế thế trận về phía Đỏ" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
                    <span id="advantage-red" class="advantage-red" style="width:50%"></span>
                    <span class="meter-center"></span>
                </div>
                <div class="advantage-legend">
                    <span><i class="side-dot red-dot"></i> Đỏ <strong id="red-score">0</strong></span>
                    <span>Đen <strong id="black-score">0</strong> <i class="side-dot black-dot"></i></span>
                </div>
                <div class="heuristic-cards">
                    <div class="heuristic-card">
                        <span class="heuristic-code">H1</span>
                        <span class="heuristic-name">Vật chất</span>
                        <strong id="h1-value">0</strong>
                        <div id="h1-meter" class="heuristic-meter" role="meter" aria-label="Ưu thế H1 về phía Đỏ" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"><span></span></div>
                    </div>
                    <div class="heuristic-card">
                        <span class="heuristic-code">H2</span>
                        <span class="heuristic-name">Vị trí</span>
                        <strong id="h2-value">0</strong>
                        <div id="h2-meter" class="heuristic-meter" role="meter" aria-label="Ưu thế H2 về phía Đỏ" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"><span></span></div>
                    </div>
                    <div class="heuristic-card">
                        <span class="heuristic-code">H3</span>
                        <span class="heuristic-name">Chiến thuật</span>
                        <strong id="h3-value">0</strong>
                        <div id="h3-meter" class="heuristic-meter" role="meter" aria-label="Ưu thế H3 về phía Đỏ" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"><span></span></div>
                    </div>
                </div>
                <details class="evaluation-help">
                    <summary>Cách đọc chỉ số</summary>
                    <p>Thanh đỏ tăng khi Đỏ có ưu thế, phần còn lại thuộc Đen. 100 điểm tương đương giá trị một Tốt trước sông.</p>
                </details>
                <div id="last-move-box" class="last-move-summary" hidden>
                    <span class="last-move-label">NƯỚC VỪA ĐI</span>
                    <p><strong id="lm-piece"></strong><span id="lm-desc"></span></p>
                    <div class="delta-badges">
                        <span>H1 <b id="lm-h1">0</b></span>
                        <span>H2 <b id="lm-h2">0</b></span>
                        <span>H3 <b id="lm-h3">0</b></span>
                        <span class="delta-total">Tổng <b id="lm-total">0</b></span>
                    </div>
                    <span class="delta-caption">Thay đổi ưu thế của bên vừa đi</span>
                </div>
            </section>

            <div class="panel-box move-history-box">
                <div class="status-header">
                    <i class="fa-solid fa-list-ol"></i> Lịch sử nước đi
                </div>
                <div class="move-list" id="move-history-container">
                    <!-- Move list will be appended here -->
                    <div class="empty-history">Chưa có nước đi nào</div>
                </div>
            </div>

            <div class="panel-box action-box">
                <div class="action-grid">
                    <button id="undo-btn" class="action-btn" title="Đi lại">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>Đi lại</span>
                    </button>
                    <div class="hint-menu-container">
                        <button id="hint-btn" class="action-btn" title="Gợi ý từ AI">
                            <i class="fa-solid fa-lightbulb" style="color: var(--accent-gold);"></i>
                            <span>Gợi ý <i class="fa-solid fa-caret-up" style="font-size: 10px;"></i></span>
                        </button>
                        <div id="hint-dropdown" class="hint-dropdown-menu hidden">
                            <button id="hint-piece-btn" type="button" class="hint-dropdown-item" title="Chỉ làm nổi bật quân cờ nên đi">
                                <i class="fa-solid fa-chess-knight" style="color: #38bdf8; font-size: 16px;"></i>
                                <div>
                                    <span>Gợi ý quân cờ</span>
                                    <small>Chỉ highlight quân cờ tối ưu</small>
                                </div>
                            </button>
                            <button id="hint-full-btn" type="button" class="hint-dropdown-item" title="Chỉ thẳng đường đi tới đích">
                                <i class="fa-solid fa-location-arrow" style="color: #f59e0b; font-size: 16px;"></i>
                                <div>
                                    <span>Gợi ý có nước đi</span>
                                    <small>Mũi tên chỉ thẳng nước đi</small>
                                </div>
                            </button>
                        </div>
                    </div>
                    <button id="draw-btn" class="action-btn" title="Xin hòa">
                        <i class="fa-solid fa-handshake"></i>
                        <span>Xin hòa</span>
                    </button>
                    <button id="resign-btn" class="action-btn danger-text" title="Đầu hàng">
                        <i class="fa-solid fa-flag"></i>
                        <span>Đầu hàng</span>
                    </button>
                </div>
                
                <div class="action-footer">
                    <div style="display: flex; gap: 8px; width: 100%; margin-bottom: 8px;">
                        <button id="copy-fen-btn" class="btn-secondary" style="flex: 1; padding: 9px; font-size: 13px;" type="button" title="Sao chép chuỗi FEN thế cờ hiện tại">
                            <i class="fa-regular fa-copy" style="color: var(--accent-gold);"></i> Chép FEN
                        </button>
                        <button id="export-pgn-btn" class="btn-secondary" style="flex: 1; padding: 9px; font-size: 13px;" type="button" title="Tải biên bản các nước đi của ván cờ">
                            <i class="fa-solid fa-download" style="color: var(--accent-gold);"></i> Xuất biên bản
                        </button>
                    </div>
                    <button id="flip-board-btn" class="btn-secondary w-full mb-2" type="button" title="Đảo góc nhìn bàn cờ">
                        <i class="fa-solid fa-arrows-rotate"></i> Xoay bàn cờ
                    </button>
                    <button id="new-game-btn" class="btn-primary w-full mb-2">
                        <i class="fa-solid fa-rotate"></i> Ván mới
                    </button>
                    <button id="change-mode-btn" class="btn-secondary w-full">
                        <i class="fa-solid fa-gear"></i> Đổi chế độ
                    </button>
                </div>
            </div>

        </div>

    </section>
</div>

