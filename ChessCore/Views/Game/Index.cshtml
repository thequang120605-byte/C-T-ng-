@{
    ViewData["Title"] = "Chơi Cờ Tướng";
}

<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />

<div class="game-page">

    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->

    <section class="game-header">

        <h1>CỜ TƯỚNG</h1>

        <p>Chơi Cờ Tướng trực tuyến</p>

    </section>


    <!-- ========================================= -->
    <!-- GAME CONTAINER -->
    <!-- ========================================= -->

    <section class="game-container">


        <!-- ========================================= -->
        <!-- QUÂN ĐỎ -->
        <!-- ========================================= -->

        <aside class="player-panel">

            <h2>🔴 QUÂN ĐỎ</h2>

            <div class="player-info">

                <div class="avatar">
                    👤
                </div>

                <div>
                    <strong>Người chơi 1</strong>
                    <p id="red-player-status">⚪ Đang chờ</p>
                </div>

            </div>

        </aside>


        <!-- ========================================= -->
        <!-- BÀN CỜ -->
        <!-- ========================================= -->

        <section class="board-container">

            <div class="xiangqi-board-wrapper">

                <div id="chess-board" class="xiangqi-board">

                    

                    <svg id="board-svg" viewBox="0 0 900 1000" preserveAspectRatio="xMidYMid meet"
                        xmlns="http://www.w3.org/2000/svg">

                        <!-- ========================================= -->
                        <!-- NỀN BÀN CỜ -->
                        <!-- ========================================= -->

                        <rect x="20" y="20" width="860" height="960" class="board-background" />


                        <!-- ========================================= -->
                        <!-- ĐƯỜNG NGANG -->
                        <!-- ========================================= -->

                        <g class="board-lines">

                            <line x1="50" y1="50" x2="850" y2="50" />

                            <line x1="50" y1="150" x2="850" y2="150" />

                            <line x1="50" y1="250" x2="850" y2="250" />

                            <line x1="50" y1="350" x2="850" y2="350" />

                            <line x1="50" y1="450" x2="850" y2="450" />

                            <line x1="50" y1="550" x2="850" y2="550" />

                            <line x1="50" y1="650" x2="850" y2="650" />

                            <line x1="50" y1="750" x2="850" y2="750" />

                            <line x1="50" y1="850" x2="850" y2="850" />

                            <line x1="50" y1="950" x2="850" y2="950" />

                        </g>


                        <!-- ========================================= -->
                        <!-- BIÊN DỌC -->
                        <!-- ========================================= -->

                        <g class="board-lines">

                            <line x1="50" y1="50" x2="50" y2="950" />

                            <line x1="850" y1="50" x2="850" y2="950" />

                        </g>


                        <!-- ========================================= -->
                        <!-- CÁC ĐƯỜNG DỌC -->
                        <!-- ========================================= -->

                        <g class="board-lines">

                            <line x1="150" y1="50" x2="150" y2="450" />
                            <line x1="150" y1="550" x2="150" y2="950" />

                            <line x1="250" y1="50" x2="250" y2="450" />
                            <line x1="250" y1="550" x2="250" y2="950" />

                            <line x1="350" y1="50" x2="350" y2="450" />
                            <line x1="350" y1="550" x2="350" y2="950" />

                            <line x1="450" y1="50" x2="450" y2="450" />
                            <line x1="450" y1="550" x2="450" y2="950" />

                            <line x1="550" y1="50" x2="550" y2="450" />
                            <line x1="550" y1="550" x2="550" y2="950" />

                            <line x1="650" y1="50" x2="650" y2="450" />
                            <line x1="650" y1="550" x2="650" y2="950" />

                            <line x1="750" y1="50" x2="750" y2="450" />
                            <line x1="750" y1="550" x2="750" y2="950" />

                        </g>


                        <!-- ========================================= -->
                        <!-- SÔNG -->
                        <!-- ========================================= -->

                        <g class="river-text">

                            <text x="250" y="520" text-anchor="middle">
                                楚 河
                            </text>

                            <text x="650" y="520" text-anchor="middle">
                                漢 界
                            </text>

                        </g>


                        <!-- ========================================= -->
                        <!-- CUNG TƯỚNG TRÊN -->
                        <!-- ========================================= -->

                        <g class="palace-lines">

                            <line x1="350" y1="50" x2="550" y2="250" />

                            <line x1="550" y1="50" x2="350" y2="250" />

                        </g>


                        <!-- ========================================= -->
                        <!-- CUNG TƯỚNG DƯỚI -->
                        <!-- ========================================= -->

                        <g class="palace-lines">

                            <line x1="350" y1="750" x2="550" y2="950" />

                            <line x1="550" y1="750" x2="350" y2="950" />

                        </g>


                        <!-- ========================================= -->
                        <!-- LAYER -->
                        <!-- ========================================= -->

                        <g id="moves-layer"></g>

                        <g id="pieces-layer"></g>

                    </svg>

                </div>

            </div>

        </section>


        <!-- ========================================= -->
        <!-- QUÂN ĐEN -->
        <!-- ========================================= -->

        <aside class="player-panel">

            <h2>⚫ QUÂN ĐEN</h2>

            <div class="player-info">

                <div class="avatar">
                    👤
                </div>

                <div>
                    <strong>Người chơi 2</strong>
                    <p id="black-player-status">⚪ Đang chờ</p>
                </div>

            </div>

        </aside>

    </section>


    <!-- ========================================= -->
    <!-- TRẠNG THÁI GAME -->
    <!-- ========================================= -->

    <section class="game-status">

        <h2 id="turn-status">
            🔴 Lượt của QUÂN ĐỎ
        </h2>

    </section>


    <!-- ========================================= -->
    <!-- BUTTON -->
    <!-- ========================================= -->

    <section class="game-actions">

        <button id="new-game-btn" type="button">
            🔄 VÁN MỚI
        </button>

    </section>

</div>


<!-- ========================================= -->
<!-- POPUP KẾT QUẢ -->
<!-- ========================================= -->

<div id="game-result-modal" class="game-modal">

    <div class="game-modal-content">


        <div class="result-icon">
            🏆
        </div>


        <h1 id="result-title">
            CHIẾN THẮNG
        </h1>


        <h2 id="winner-name">
            🔴 QUÂN ĐỎ
        </h2>


        <p id="result-message">
            Đã giành chiến thắng!
        </p>


        <button id="result-new-game-btn" type="button">
            🔄 CHƠI VÁN MỚI
        </button>


        <button id="result-close-btn" type="button">
            ĐÓNG
        </button>


    </div>

</div>


<!-- ========================================= -->
<!-- POPUP XÁC NHẬN ĐẦU HÀNG -->
<!-- ========================================= -->

<div id="resign-modal" class="game-modal">

    <div class="game-modal-content">

        <div class="result-icon">
            ⚠️
        </div>


        <h1>
            XÁC NHẬN ĐẦU HÀNG
        </h1>


        <p>
            Bạn có chắc chắn muốn đầu hàng không?
        </p>


        <div class="modal-actions">

            <button id="confirm-resign-btn" type="button" class="danger-btn">
                🏳️ ĐẦU HÀNG
            </button>


            <button id="cancel-resign-btn" type="button">
                HỦY
            </button>

        </div>

    </div>

</div>


<script src="~/js/game.js"></script>
