<!-- BÀN CỜ TÙY CHỈNH (BOARD EDITOR - XẾP THẾ CỜ) -->
<!-- ========================================================= -->
<div id="board-editor-modal" class="custom-modal hidden">
    <div class="modal-content" style="max-width: 920px; width: 95%; text-align: left; padding: 20px 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="modal-icon text-gold" style="font-size: 24px; margin: 0;"><i class="fa-solid fa-chess-board"></i></div>
                <div>
                    <h2 style="margin: 0; font-size: 18px;">THIẾT LẬP BÀN CỜ TÙY CHỈNH (BOARD EDITOR)</h2>
                    <span style="font-size: 12.5px; color: var(--text-muted);">Kéo thả hoặc click chọn quân cờ bên dưới rồi đặt vào bàn cờ để tạo thế cờ theo ý bạn</span>
                </div>
            </div>
            <button id="editor-close-btn" type="button" style="background: none; border: none; font-size: 20px; color: var(--text-muted); cursor: pointer;"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div style="display: grid; grid-template-columns: minmax(320px, 440px) 1fr; gap: 20px; align-items: start;">
            <!-- BÀN CỜ XẾP MINI -->
            <div style="width: 100%; aspect-ratio: 9/10; position: relative; background: #3e2723; border-radius: 10px; overflow: hidden; border: 2px solid #5d4037;">
                <svg id="editor-board-svg" viewBox="0 0 900 1000" style="width: 100%; height: 100%; display: block; cursor: crosshair;">
                    <rect x="0" y="0" width="900" height="1000" fill="#3E2723" />
                    <rect x="15" y="15" width="870" height="970" fill="#E2C28E" />
                    <g stroke="#4a3022" stroke-width="4">
                        @for (var row = 0; row < 10; row++) { <line x1="50" y1="@(50 + row * 100)" x2="850" y2="@(50 + row * 100)" /> }
                        <line x1="50" y1="50" x2="50" y2="950" /><line x1="850" y1="50" x2="850" y2="950" />
                        @for (var col = 1; col < 8; col++) { <line x1="@(50 + col * 100)" y1="50" x2="@(50 + col * 100)" y2="450" /><line x1="@(50 + col * 100)" y1="550" x2="@(50 + col * 100)" y2="950" /> }
                    </g>
                    <g stroke="#4a3022" stroke-width="3">
                        <line x1="350" y1="50" x2="550" y2="250" /><line x1="550" y1="50" x2="350" y2="250" />
                        <line x1="350" y1="750" x2="550" y2="950" /><line x1="550" y1="750" x2="350" y2="950" />
                    </g>
                    <g fill="#78350f" font-size="48" font-weight="bold" font-family="'KaiTi', serif" text-anchor="middle" letter-spacing="6">
                        <text x="250" y="520">楚 河</text><text x="650" y="520">漢 界</text>
                    </g>
                    <g id="editor-pieces-layer"></g>
                </svg>
            </div>

            <!-- BẢNG ĐIỀU KHIỂN & KHAY QUÂN CỜ -->
            <div style="display: flex; flex-direction: column; gap: 14px;">
                <!-- CHỌN QUÂN ĐỂ ĐẶT -->
                <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 10px; padding: 12px;">
                    <div style="font-size: 12.5px; font-weight: 700; margin-bottom: 8px; color: var(--text-main);">
                        1. Khay quân Đỏ (Bấm để chọn quân đặt):
                    </div>
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;" id="editor-red-tray">
                        <button type="button" class="editor-piece-btn" data-type="King" data-color="Red" data-text="帥" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #c00000; color: #c00000; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">帥</button>
                        <button type="button" class="editor-piece-btn" data-type="Advisor" data-color="Red" data-text="仕" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #c00000; color: #c00000; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">仕</button>
                        <button type="button" class="editor-piece-btn" data-type="Elephant" data-color="Red" data-text="相" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #c00000; color: #c00000; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">相</button>
                        <button type="button" class="editor-piece-btn" data-type="Horse" data-color="Red" data-text="傌" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #c00000; color: #c00000; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">傌</button>
                        <button type="button" class="editor-piece-btn" data-type="Rook" data-color="Red" data-text="俥" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #c00000; color: #c00000; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">俥</button>
                        <button type="button" class="editor-piece-btn" data-type="Cannon" data-color="Red" data-text="炮" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #c00000; color: #c00000; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">炮</button>
                        <button type="button" class="editor-piece-btn" data-type="Pawn" data-color="Red" data-text="兵" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #c00000; color: #c00000; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">兵</button>
                    </div>

                    <div style="font-size: 12.5px; font-weight: 700; margin: 12px 0 8px; color: var(--text-main);">
                        2. Khay quân Đen (Bấm để chọn quân đặt):
                    </div>
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;" id="editor-black-tray">
                        <button type="button" class="editor-piece-btn" data-type="King" data-color="Black" data-text="將" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #111; color: #111; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">將</button>
                        <button type="button" class="editor-piece-btn" data-type="Advisor" data-color="Black" data-text="士" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #111; color: #111; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">士</button>
                        <button type="button" class="editor-piece-btn" data-type="Elephant" data-color="Black" data-text="象" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #111; color: #111; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">象</button>
                        <button type="button" class="editor-piece-btn" data-type="Horse" data-color="Black" data-text="馬" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #111; color: #111; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">馬</button>
                        <button type="button" class="editor-piece-btn" data-type="Rook" data-color="Black" data-text="車" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #111; color: #111; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">車</button>
                        <button type="button" class="editor-piece-btn" data-type="Cannon" data-color="Black" data-text="砲" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #111; color: #111; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">砲</button>
                        <button type="button" class="editor-piece-btn" data-type="Pawn" data-color="Black" data-text="卒" style="width: 38px; height: 38px; border-radius: 50%; background: #E2C28E; border: 2px solid #111; color: #111; font-family: SimSun; font-size: 20px; font-weight: 900; cursor: pointer;">卒</button>
                        <button type="button" id="editor-eraser-btn" class="btn-secondary" style="font-size: 11px; padding: 4px 10px; margin-left: auto;" title="Click ô cờ để xóa quân"><i class="fa-solid fa-eraser"></i> Tẩy ô cờ</button>
                    </div>
                </div>

                <!-- TÙY CHỌN & CHUỖI FEN SINH TỰ ĐỘNG -->
                <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 10px; padding: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <span style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Chuỗi FEN tự động:</span>
                        <div style="display: flex; gap: 8px;">
                            <label style="font-size: 12px; font-weight: 600; cursor: pointer;">
                                <input type="radio" name="editor-turn" value="w" checked /> Đỏ đi trước
                            </label>
                            <label style="font-size: 12px; font-weight: 600; cursor: pointer;">
                                <input type="radio" name="editor-turn" value="b" /> Đen đi trước
                            </label>
                        </div>
                    </div>
                    <input type="text" id="editor-fen-output" readonly style="width: 100%; box-sizing: border-box; background: var(--bg-navy-panel); border: 1px solid var(--border-color); color: var(--text-main); border-radius: 6px; padding: 8px; font-family: monospace; font-size: 11.5px;" />
                </div>

                <!-- THAO TÁC -->
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <button type="button" id="editor-clear-btn" class="btn-secondary" style="flex: 1; padding: 10px; font-size: 13px;"><i class="fa-solid fa-trash-can"></i> Xóa bàn cờ</button>
                    <button type="button" id="editor-standard-btn" class="btn-secondary" style="flex: 1; padding: 10px; font-size: 13px;"><i class="fa-solid fa-rotate-left"></i> Bàn cờ chuẩn</button>
                    <button type="button" id="editor-play-btn" class="btn-primary" style="flex: 2; padding: 10px; font-size: 13px; font-weight: 700;"><i class="fa-solid fa-play"></i> Đấu cờ từ thế này</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- TRA CỨU KHAI CUỘC (OPENING BOOK EXPLORER) -->
<!-- ========================================================= -->
<div id="opening-explorer-modal" class="custom-modal hidden">
    <div class="modal-content" style="max-width: 840px; width: 95%; text-align: left; padding: 20px 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="modal-icon text-gold" style="font-size: 24px; margin: 0;"><i class="fa-solid fa-book-bookmark"></i></div>
                <div>
                    <h2 style="margin: 0; font-size: 18px;">CƠ SỞ DỮ LIỆU KHAI CUỘC (OPENING BOOK)</h2>
                    <span style="font-size: 12.5px; color: var(--text-muted);">Tra cứu thế trận, phương án biến thể và tỷ lệ thắng dựa trên hàng ngàn kỳ phổ chuẩn</span>
                </div>
            </div>
            <button id="opening-explorer-close-btn" type="button" style="background: none; border: none; font-size: 20px; color: var(--text-muted); cursor: pointer;"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div style="display: grid; grid-template-columns: 260px 1fr; gap: 18px;">
            <!-- DANH SÁCH KHAI CUỘC -->
            <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 10px; padding: 10px; max-height: 380px; overflow-y: auto;" id="opening-book-menu">
                <div class="opening-menu-item active" data-id="1" style="padding: 10px 12px; border-radius: 8px; cursor: pointer; margin-bottom: 4px; background: rgba(212, 175, 55, 0.15); border: 1px solid rgba(212, 175, 55, 0.3);">
                    <div style="font-weight: 700; font-size: 13.5px; color: var(--text-main);">Pháo Đầu (Trung Pháo)</div>
                    <div style="font-size: 11px; color: var(--accent-gold); font-weight: 600;">Mã: ECCO-01</div>
                </div>
                <div class="opening-menu-item" data-id="2" style="padding: 10px 12px; border-radius: 8px; cursor: pointer; margin-bottom: 4px;">
                    <div style="font-weight: 700; font-size: 13.5px; color: var(--text-main);">Bình Phong Mã</div>
                    <div style="font-size: 11px; color: var(--text-muted);">Mã: ECCO-02</div>
                </div>
                <div class="opening-menu-item" data-id="3" style="padding: 10px 12px; border-radius: 8px; cursor: pointer; margin-bottom: 4px;">
                    <div style="font-weight: 700; font-size: 13.5px; color: var(--text-main);">Thuận Pháo</div>
                    <div style="font-size: 11px; color: var(--text-muted);">Mã: ECCO-03</div>
                </div>
                <div class="opening-menu-item" data-id="4" style="padding: 10px 12px; border-radius: 8px; cursor: pointer; margin-bottom: 4px;">
                    <div style="font-weight: 700; font-size: 13.5px; color: var(--text-main);">Tiên Nhân Chỉ Lộ</div>
                    <div style="font-size: 11px; color: var(--text-muted);">Mã: ECCO-04</div>
                </div>
                <div class="opening-menu-item" data-id="5" style="padding: 10px 12px; border-radius: 8px; cursor: pointer; margin-bottom: 4px;">
                    <div style="font-weight: 700; font-size: 13.5px; color: var(--text-main);">Khởi Mã Cuộc (Thượng Tiên)</div>
                    <div style="font-size: 11px; color: var(--text-muted);">Mã: ECCO-05</div>
                </div>
            </div>

            <!-- CHI TIẾT THẾ TRẬN & NƯỚC ĐI BIẾN THỂ -->
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px;">
                    <h3 id="opening-detail-title" style="margin: 0 0 6px 0; font-size: 16px; color: var(--text-main);">Pháo Đầu (Trung Pháo)</h3>
                    <p id="opening-detail-desc" style="margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.5;">
                        Thế trận công thủ toàn diện, Pháo vào trung lộ kiểm soát lộ 5, tạo sức ép thẳng vào cung Tướng đối phương.
                    </p>
                </div>

                <div style="background: var(--bg-navy-dark); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px; flex: 1;">
                    <div style="font-size: 13px; font-weight: 700; margin-bottom: 10px; color: var(--text-main); display: flex; justify-content: space-between;">
                        <span>Nước đi biến thể phổ biến:</span>
                        <span style="font-size: 11.5px; color: var(--text-muted);">Tỷ lệ Thắng / Hòa / Thua</span>
                    </div>

                    <div id="opening-moves-table" style="display: flex; flex-direction: column; gap: 8px;">
                        <!-- Động sinh bằng JS -->
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" id="opening-practice-btn" class="btn-primary" style="padding: 9px 18px; font-weight: 700;"><i class="fa-solid fa-play"></i> Thực hành thế trận này</button>
                </div>
            </div>
        </div>
    </div>
</div>

