                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/games/{{game_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "games",
                "{{game_id}}"
              ]
            }
          }
        },
        {
          "name": "GAME-03: Lấy danh sách nước đi hợp lệ của quân Tốt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Trả về danh sách nước đi hợp lệ\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(Array.isArray(data)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/games/{{game_id}}/valid-moves?fromRow=6&fromCol=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "games",
                "{{game_id}}",
                "valid-moves"
              ],
              "query": [
                {
                  "key": "fromRow",
                  "value": "6"
                },
                {
                  "key": "fromCol",
                  "value": "4"
                }
              ]
            }
          }
        },
        {
          "name": "GAME-04: Thực hiện nước đi hợp lệ (Tiến Tốt 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Nước đi được chấp nhận 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromRow\": 6,\n  \"fromCol\": 4,\n  \"toRow\": 5,\n  \"toCol\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/games/{{game_id}}/moves",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "games",
                "{{game_id}}",
                "moves"
              ]
            }
          }
        },
        {
          "name": "GAME-05: Gọi AI phản hồi nước cờ (Computer Move)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"AI phản hồi thành công 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
