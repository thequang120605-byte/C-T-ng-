<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource Paper}" /></Style>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="FontSize" Value="14" /></Style>
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" /><Setter Property="TextColor" Value="#FFF9EF" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="14,8" />
        <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateGroupList></Setter>
    </Style>
    <Style TargetType="Entry"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="PlaceholderColor" Value="{StaticResource Muted}" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="FontSize" Value="15" /></Style>
    <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="{StaticResource Gold}" /></Style>
    <Style x:Key="CardStyle" TargetType="Border"><Setter Property="BackgroundColor" Value="{StaticResource Card}" /><Setter Property="Stroke" Value="{StaticResource Line}" /><Setter Property="StrokeShape" Value="RoundRectangle 18" /><Setter Property="Padding" Value="18" /></Style>
    <Style x:Key="QuietButton" TargetType="Button"><Setter Property="BackgroundColor" Value="#E7DCC8" /><Setter Property="TextColor" Value="{StaticResource Ink}" /></Style>
</ResourceDictionary>
