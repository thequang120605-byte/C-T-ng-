<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Ưu tiên Android cho giai đoạn 1 và 2; cấu trúc đa nền tảng sẵn sàng kích hoạt iOS khi có môi trường Mac/iOS workload -->
		<TargetFrameworks>net9.0-android</TargetFrameworks>
		<!-- <TargetFrameworks Condition="'$(BuildAllPlatforms)' == 'true'">net9.0-android;net9.0-ios</TargetFrameworks> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>ChessCore.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Kỳ Đạo Pixel</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.chesscore.cotuong.pixel</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.2</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
		<!-- Tắt Shared Runtime & Fast Deployment để APK chứa đầy đủ Mono runtime và DLL, chạy độc lập trên máy ảo & máy thật -->
		<AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
		<AndroidEnableFastDeployment>false</AndroidEnableFastDeployment>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(AllowLocalHttp)' != 'true'">
        <AndroidManifest>Platforms\Android\AndroidManifest.Release.xml</AndroidManifest>
    </PropertyGroup>
    <PropertyGroup Condition="'$(AllowLocalHttp)' == 'true'">
        <DefineConstants>$(DefineConstants);LOCAL_HTTP</DefineConstants>
    </PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#282B29" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F3EBDD" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />


		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

    <ItemGroup><Compile Remove="Checks/**/*.cs" /><MauiXaml Remove="Checks/**/*.xaml" /></ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.2" />
		<PackageReference Include="System.Text.Json" Version="9.0.2" />
	</ItemGroup>

</Project>
